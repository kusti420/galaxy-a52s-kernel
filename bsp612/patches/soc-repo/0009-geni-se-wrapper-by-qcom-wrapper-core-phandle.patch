 /**
+ * geni_se_common_wrapper_dev() - the QUP wrapper device of a serial engine
+ * @dev: the serial engine's device
+ *
+ * a52sxq-wrapper-core: Qualcomm's 6.12 device trees put the SE nodes under their wrapper node,
+ * so the wrapper is dev->parent. The 5.4 layout (the Galaxy A52s' sysfs paths, which its ROM's
+ * SELinux genfscon labels are keyed to: /sys/devices/platform/soc/98c000.i2c/...) has the SE
+ * nodes directly under /soc and names the wrapper with a "qcom,wrapper-core" phandle, as the 5.4
+ * drivers did. That phandle wins when present.
+ *
+ * The returned pointer is borrowed: wrapper devices are populated from /soc at boot and never
+ * unregistered. NULL while the wrapper node has no device yet (callers defer).
+ */
+static inline struct device *geni_se_common_wrapper_dev(struct device *dev)
+{
+	struct device_node *np;
+	struct platform_device *wpdev;
+
+	np = of_parse_phandle(dev->of_node, "qcom,wrapper-core", 0);
+	if (!np)
+		return dev->parent;
+	wpdev = of_find_device_by_node(np);
+	of_node_put(np);
+	if (!wpdev)
+		return NULL;
+	put_device(&wpdev->dev);
+	dev_info_once(dev, "a52sxq-wrapper-core: SE wrapper %s\n", dev_name(&wpdev->dev));
+	return &wpdev->dev;
+}
