a52sxq: memlat: bound the idle decay samples

The idle decay of patch 0010 re-arms its timer whenever a sampling vote is above its idle
level. A window whose only CPU cycles are the decay sample's own work still counts as "ran"
and votes table row 0, which is above the idle level, so the timer kept firing every 32-48 ms
through quiet awake periods. Allow at most memlat.idle_decay_samples (default 2, what the
design needs) decay samples after each regular tick-driven sample; a decay sample alone can no
longer keep the timer alive. 0 = unbounded as before. (audit 2026-11-18, low 48)

--- a/drivers/soc/qcom/dcvs/memlat.c
+++ b/drivers/soc/qcom/dcvs/memlat.c
@@ -232,6 +232,8 @@
 	u32				sample_ms;
 	struct hrtimer			timer;
 	struct hrtimer			idle_timer;
+	bool				decay_sample;	/* current sample was started by idle_timer */
+	unsigned int			decay_left;	/* decay samples left before the next regular one */
 	ktime_t				last_update_ts;
 	ktime_t				last_jiffy_ts;
 	struct memlat_group		*groups[MAX_MEMLAT_GRPS];
@@ -266,6 +268,16 @@
 MODULE_PARM_DESC(idle_decay_ms, "re-sample this long after the last sample while a vote is above its idle level (0 = off)");
 
 /*
+ * a52sxq: at most this many decay samples in a row after a regular (tick-driven) sample. A
+ * window whose only CPU cycles are the decay sample's own work still counts as "ran" and votes
+ * table row 0 (above the idle level), which re-armed the timer without bound (32-48 ms
+ * wakeups through quiet awake periods). 0 = unbounded (the first version of the idle decay).
+ */
+static unsigned int idle_decay_samples = 2;
+module_param(idle_decay_samples, uint, 0644);
+MODULE_PARM_DESC(idle_decay_samples, "max consecutive idle-decay samples after a regular sample (0 = unbounded)");
+
+/*
  * a52sxq: a mon whose CPUs ran no cycles in the window votes its min_freq, as the 5.4
  * governor_memlat did (max_freq 0 -> devfreq min), instead of the first table row. Windows
  * with any CPU activity are unchanged. false = Qualcomm behaviour.
@@ -1165,15 +1177,33 @@
 	struct memlat_group *memlat_grp;
 	struct memlat_mon *mon;
 	unsigned int decay_ms = READ_ONCE(idle_decay_ms);
+	unsigned int decay_max = READ_ONCE(idle_decay_samples);
 	bool above = false;
+	bool decay;
 	int i, grp;
 	u64 ns;
 
+	/* only called from the (single) update work, which serialises decay_left */
+	decay = xchg(&memlat_data->decay_sample, false);
+
 	if (!decay_ms) {
 		hrtimer_try_to_cancel(&memlat_data->idle_timer);
 		return;
 	}
 
+	if (decay_max) {
+		if (!decay) {
+			/* regular sample: this arming + (decay_max - 1) more */
+			memlat_data->decay_left = decay_max - 1;
+		} else if (!memlat_data->decay_left) {
+			/* a decay sample alone never keeps the timer alive */
+			hrtimer_try_to_cancel(&memlat_data->idle_timer);
+			return;
+		} else {
+			memlat_data->decay_left--;
+		}
+	}
+
 	for (grp = 0; grp < MAX_MEMLAT_GRPS && !above; grp++) {
 		memlat_grp = memlat_data->groups[grp];
 		if (!memlat_grp || memlat_grp->sampling_path_type == NUM_DCVS_PATHS)
@@ -1280,6 +1310,7 @@
 
 	/* the jiffies callback then keeps its sample_ms spacing from this sample */
 	WRITE_ONCE(memlat_data->last_jiffy_ts, now);
+	WRITE_ONCE(memlat_data->decay_sample, true);
 	hrtimer_start(&memlat_data->timer, 0, HRTIMER_MODE_REL_PINNED);
 
 	return HRTIMER_NORESTART;
