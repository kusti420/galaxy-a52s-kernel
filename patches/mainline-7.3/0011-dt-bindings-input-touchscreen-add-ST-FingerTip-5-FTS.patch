From c72f61698d8d7ebcc5b7e12298dd3b8812f13c62 Mon Sep 17 00:00:00 2001
From: a52sxq-kernel <a52sxq-kernel@example.invalid>
Date: Mon, 16 Nov 2026 18:23:12 +0200
Subject: [PATCH 11/17] dt-bindings: input: touchscreen: add ST FingerTip 5
 (FTS5CU56A)

FingerTip 5 touchscreen controllers use a different command set and
event format from the FingerTip parts described in st,stmfts.yaml, so
they get their own binding. avdd-supply is required; vdd-supply is
optional for boards where the I/O rail is always on.
---
 .../input/touchscreen/st,fts5cu56a.yaml       | 61 +++++++++++++++++++
 1 file changed, 61 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/input/touchscreen/st,fts5cu56a.yaml

diff --git a/Documentation/devicetree/bindings/input/touchscreen/st,fts5cu56a.yaml b/Documentation/devicetree/bindings/input/touchscreen/st,fts5cu56a.yaml
new file mode 100644
index 000000000..b7c6e5ee8
--- /dev/null
+++ b/Documentation/devicetree/bindings/input/touchscreen/st,fts5cu56a.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: GPL-2.0-only OR BSD-2-Clause
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/input/touchscreen/st,fts5cu56a.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: STMicroelectronics FingerTip 5 (FTS5) touchscreen controller
+
+maintainers:
+  - Dmitry Torokhov <dmitry.torokhov@gmail.com>
+
+description:
+  FingerTip 5 generation capacitive touchscreen controllers on I2C. They use a
+  different command set and event format from the older FingerTip parts
+  described in st,stmfts.yaml.
+
+allOf:
+  - $ref: touchscreen.yaml#
+
+properties:
+  compatible:
+    const: st,fts5cu56a
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  avdd-supply:
+    description: Analog power supply
+
+  vdd-supply:
+    description: Digital / I/O power supply (omit when it is always on)
+
+required:
+  - compatible
+  - reg
+  - interrupts
+  - avdd-supply
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/irq.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        touchscreen@49 {
+            compatible = "st,fts5cu56a";
+            reg = <0x49>;
+            interrupt-parent = <&tlmm>;
+            interrupts = <81 IRQ_TYPE_LEVEL_LOW>;
+            avdd-supply = <&vreg_l7c>;
+            touchscreen-size-x = <4096>;
+            touchscreen-size-y = <4096>;
+        };
+    };
