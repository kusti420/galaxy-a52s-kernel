From c1102779e0639b38a4c0e8761f567751f3c71357 Mon Sep 17 00:00:00 2001
From: a52sxq-kernel <a52sxq-kernel@example.invalid>
Date: Sun, 15 Nov 2026 17:39:38 +0200
Subject: [PATCH 1/5] arm64: a52sxq: COMMAND_LINE_SIZE 4096

The Samsung ABL appends about 3 KB of its own arguments to the command
line (5.4 boot cmdline: 3195 bytes); with 2048 everything behind that is
cut off. Same value as the downstream kernel and our ACK 6.18 tree.
---
 arch/arm64/include/uapi/asm/setup.h | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/include/uapi/asm/setup.h b/arch/arm64/include/uapi/asm/setup.h
index 5d703888f..85e34aa78 100644
--- a/arch/arm64/include/uapi/asm/setup.h
+++ b/arch/arm64/include/uapi/asm/setup.h
@@ -22,6 +22,6 @@
 
 #include <linux/types.h>
 
-#define COMMAND_LINE_SIZE	2048
+#define COMMAND_LINE_SIZE	4096
 
 #endif
