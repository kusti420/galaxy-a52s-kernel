From 23652b86ef5c7b9a135e8d9c254809a52e27b9ee Mon Sep 17 00:00:00 2001
From: a52sxq-kernel <a52sxq-kernel@example.invalid>
Date: Sun, 15 Nov 2026 21:05:33 +0200
Subject: [PATCH 09/17] drm/panel: add Samsung S6E3FC3 (AMS646YD01) DSC panel
 driver

Command mode panel of the Samsung Galaxy A52s 5G: 1080x2400, 4 lanes,
VESA DSC 1.1 with two 540x40 slices at 8 bpc / 8 bpp. The on/off
sequences are generated from the vendor device tree command blobs
(qcom,mdss-dsi-on-command / -off-command of the fhd60 timing). Power
order and reset timing follow the vendor supply entries (VDDI before
VCI, 2 ms before VDDI off) and reset sequence (10 ms low, 10 ms high).

Brightness uses the normal (non-HBM) 10-bit WRDISBV range. Only the
60 Hz mode is exposed for now; the vendor 120 Hz timing differs in one
byte of the F2h table and needs a mode-dependent init.

The PPS is packed from the DSC config the DSI host fills in; while this
is being brought up the driver reports any difference from the vendor
PPS bytes in the kernel log.
---
 drivers/gpu/drm/panel/Kconfig                 |  16 +
 drivers/gpu/drm/panel/Makefile                |   1 +
 drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c | 376 ++++++++++++++++++
 3 files changed, 393 insertions(+)
 create mode 100644 drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c

diff --git a/drivers/gpu/drm/panel/Kconfig b/drivers/gpu/drm/panel/Kconfig
index f9c88a9b6..c98f22b1a 100644
--- a/drivers/gpu/drm/panel/Kconfig
+++ b/drivers/gpu/drm/panel/Kconfig
@@ -1017,6 +1017,22 @@ config DRM_PANEL_SAMSUNG_S6E3FC2X01
 
 	    Samsung AMS641RW (found in the OnePlus 6T smartphone)
 
+config DRM_PANEL_SAMSUNG_S6E3FC3
+	tristate "Samsung S6E3FC3 DSI command mode panel controller"
+	depends on GPIOLIB
+	depends on OF
+	depends on DRM_MIPI_DSI
+	depends on BACKLIGHT_CLASS_DEVICE
+	select DRM_DISPLAY_DSC_HELPER
+	select DRM_DISPLAY_HELPER
+	help
+	  Say Y or M here if you want to enable support for the
+	  Samsung S6E3FC3 DDIC and connected MIPI DSI panel with
+	  Display Stream Compression.
+	  Currently supported panels:
+
+	    Samsung AMS646YD01 (found in the Samsung Galaxy A52s 5G)
+
 config DRM_PANEL_SAMSUNG_S6E3HA2
 	tristate "Samsung S6E3HA2 DSI video mode panel"
 	depends on OF
diff --git a/drivers/gpu/drm/panel/Makefile b/drivers/gpu/drm/panel/Makefile
index 9035581ca..c6f4988b7 100644
--- a/drivers/gpu/drm/panel/Makefile
+++ b/drivers/gpu/drm/panel/Makefile
@@ -99,6 +99,7 @@ obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6D27A1) += panel-samsung-s6d27a1.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6D7AA0) += panel-samsung-s6d7aa0.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3FA7) += panel-samsung-s6e3fa7.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3FC2X01) += panel-samsung-s6e3fc2x01.o
