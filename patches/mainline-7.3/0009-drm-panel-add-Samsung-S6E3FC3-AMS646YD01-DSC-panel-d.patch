 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3HA2) += panel-samsung-s6e3ha2.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E3HA8) += panel-samsung-s6e3ha8.o
 obj-$(CONFIG_DRM_PANEL_SAMSUNG_S6E63J0X03) += panel-samsung-s6e63j0x03.o
diff --git a/drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c b/drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c
new file mode 100644
index 000000000..239795808
--- /dev/null
+++ b/drivers/gpu/drm/panel/panel-samsung-s6e3fc3.c
@@ -0,0 +1,376 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Samsung S6E3FC3 DDIC with the AMS646YD01 6.46" 1080x2400 AMOLED panel
+ * (Samsung Galaxy A52s 5G), MIPI DSI command mode, VESA DSC 1.1.
+ *
+ * The command sequences were generated from the vendor device tree
+ * (qcom,mdss-dsi-on-command / -off-command of
+ * ss_dsi_panel_S6E3FC3_AMS646YD01_LO_FHD) with tools/dsi-cmd2c.py.
+ */
+
+#include <linux/backlight.h>
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/regulator/consumer.h>
+
+#include <video/mipi_display.h>
+
+#include <drm/display/drm_dsc.h>
+#include <drm/display/drm_dsc_helper.h>
+#include <drm/drm_mipi_dsi.h>
+#include <drm/drm_modes.h>
+#include <drm/drm_panel.h>
+#include <drm/drm_probe_helper.h>
+
+#define S6E3FC3_MAX_BRIGHTNESS	0x3ff
+
+struct s6e3fc3 {
+	struct drm_panel panel;
+	struct mipi_dsi_device *dsi;
+	struct drm_dsc_config dsc;
+	struct regulator_bulk_data *supplies;
+	struct gpio_desc *reset_gpio;
+};
+
+/* Vendor power-up order: VDDI (1.8 V) before VCI (3.0 V). */
+static const struct regulator_bulk_data s6e3fc3_supplies[] = {
+	{ .supply = "vddi" },
+	{ .supply = "vci" },
+};
+
+/*
+ * PPS bytes 0..87 as the vendor driver sends them (bytes 88..127 are reserved
+ * in DSC 1.1). Used only to report a mismatch with the PPS packed from
+ * ctx->dsc, which the DSI host fills in.
+ */
+static const u8 s6e3fc3_vendor_pps[88] = {
+	0x11, 0x00, 0x00, 0x89, 0x30, 0x80, 0x09, 0x60,
+	0x04, 0x38, 0x00, 0x28, 0x02, 0x1c, 0x02, 0x1c,
+	0x02, 0x00, 0x02, 0x0e, 0x00, 0x20, 0x03, 0xdd,
+	0x00, 0x07, 0x00, 0x0c, 0x02, 0x77, 0x02, 0x8b,
+	0x18, 0x00, 0x10, 0xf0, 0x03, 0x0c, 0x20, 0x00,
+	0x06, 0x0b, 0x0b, 0x33, 0x0e, 0x1c, 0x2a, 0x38,
+	0x46, 0x54, 0x62, 0x69, 0x70, 0x77, 0x79, 0x7b,
+	0x7d, 0x7e, 0x01, 0x02, 0x01, 0x00, 0x09, 0x40,
+	0x09, 0xbe, 0x19, 0xfc, 0x19, 0xfa, 0x19, 0xf8,
+	0x1a, 0x38, 0x1a, 0x78, 0x1a, 0xb6, 0x2a, 0xf6,
+	0x2b, 0x34, 0x2b, 0x74, 0x3b, 0x74, 0x63, 0xf4,
+};
+
+static inline struct s6e3fc3 *to_s6e3fc3(struct drm_panel *panel)
+{
+	return container_of(panel, struct s6e3fc3, panel);
+}
+
+#define s6e3fc3_test_key_on_lvl1(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x9f, 0xa5, 0xa5)
+#define s6e3fc3_test_key_off_lvl1(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0x9f, 0x5a, 0x5a)
+#define s6e3fc3_test_key_on_lvl2(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xf0, 0x5a, 0x5a)
+#define s6e3fc3_test_key_off_lvl2(ctx) \
+	mipi_dsi_dcs_write_seq_multi(ctx, 0xf0, 0xa5, 0xa5)
+
+static void s6e3fc3_reset(struct s6e3fc3 *ctx)
+{
+	/* qcom,mdss-dsi-reset-sequence = <0 10 1 10> */
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	usleep_range(10000, 11000);
+	gpiod_set_value_cansleep(ctx->reset_gpio, 0);
+	usleep_range(10000, 11000);
+}
+
+static void s6e3fc3_check_pps(struct s6e3fc3 *ctx,
+			      const struct drm_dsc_picture_parameter_set *pps)
+{
+	const u8 *p = (const u8 *)pps;
+
+	if (!memcmp(p, s6e3fc3_vendor_pps, sizeof(s6e3fc3_vendor_pps)))
+		return;
+
+	dev_warn(&ctx->dsi->dev, "PPS differs from the vendor PPS\n");
+	print_hex_dump(KERN_WARNING, "pps ours:   ", DUMP_PREFIX_OFFSET, 16, 1,
+		       p, sizeof(s6e3fc3_vendor_pps), false);
+	print_hex_dump(KERN_WARNING, "pps vendor: ", DUMP_PREFIX_OFFSET, 16, 1,
+		       s6e3fc3_vendor_pps, sizeof(s6e3fc3_vendor_pps), false);
+}
+
+static int s6e3fc3_on(struct s6e3fc3 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+	struct drm_dsc_picture_parameter_set pps;
+
+	drm_dsc_pps_payload_pack(&pps, &ctx->dsc);
+	s6e3fc3_check_pps(ctx, &pps);
+
+	/* generated by tools/dsi-cmd2c.py from qcom,mdss-dsi-on-command (fhd60) */
+	mipi_dsi_dcs_exit_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 30);
+	s6e3fc3_test_key_on_lvl2(&dsi_ctx);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2,
+				     0x00, 0x05, 0x0e, 0x58, 0x54, 0x01, 0x0c, 0x00,
+				     0x04, 0x26, 0xe4, 0x2f, 0xb0, 0x0c, 0x09, 0x74,
+				     0x26, 0xe4, 0x0c, 0x00, 0x04, 0x10, 0x00, 0x10,
+				     0x26, 0xa8, 0x10, 0x00, 0x10, 0x10, 0x3c, 0x10,
+				     0x00, 0x40, 0x30, 0xc8, 0x00, 0xc8, 0x00, 0x00,
+				     0xce);
+	mipi_dsi_dcs_set_tear_on_multi(&dsi_ctx, MIPI_DSI_DCS_TEAR_MODE_VBLANK);
+	mipi_dsi_dcs_set_column_address_multi(&dsi_ctx, 0x0000, 0x0437);
+	mipi_dsi_dcs_set_page_address_multi(&dsi_ctx, 0x0000, 0x095f);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xe5, 0x15);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xed, 0x44, 0x4c, 0x20);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x04, 0xf2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x54);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xcc, 0x5c, 0x51);
+	mipi_dsi_compression_mode_multi(&dsi_ctx, true);
+	mipi_dsi_picture_parameter_set_multi(&dsi_ctx, &pps);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x27, 0xf2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x00);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x2e, 0xf2);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf2, 0x55);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xb0, 0x00, 0x92, 0x63);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0x63, 0x08);
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, 0xf7, 0x0f);
+	s6e3fc3_test_key_off_lvl2(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 90);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3fc3_off(struct s6e3fc3 *ctx)
+{
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* generated by tools/dsi-cmd2c.py from qcom,mdss-dsi-off-command (fhd60) */
+	s6e3fc3_test_key_on_lvl1(&dsi_ctx);
+	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 20);
+	mipi_dsi_dcs_enter_sleep_mode_multi(&dsi_ctx);
+	mipi_dsi_msleep(&dsi_ctx, 120);
+	s6e3fc3_test_key_off_lvl1(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3fc3_prepare(struct drm_panel *panel)
+{
+	struct s6e3fc3 *ctx = to_s6e3fc3(panel);
+	struct device *dev = &ctx->dsi->dev;
+	int ret;
+
+	ret = regulator_enable(ctx->supplies[0].consumer);
+	if (ret < 0)
+		return ret;
+	ret = regulator_enable(ctx->supplies[1].consumer);
+	if (ret < 0) {
+		regulator_disable(ctx->supplies[0].consumer);
+		return ret;
+	}
+
+	s6e3fc3_reset(ctx);
+
+	ret = s6e3fc3_on(ctx);
+	if (ret < 0) {
+		dev_err(dev, "Failed to initialize panel: %d\n", ret);
+		gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+		regulator_disable(ctx->supplies[1].consumer);
+		regulator_disable(ctx->supplies[0].consumer);
+		return ret;
+	}
+
+	return 0;
+}
+
+static int s6e3fc3_enable(struct drm_panel *panel)
+{
+	struct s6e3fc3 *ctx = to_s6e3fc3(panel);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = ctx->dsi };
+
+	/* generated by tools/dsi-cmd2c.py from samsung,display_on_tx_cmds_revA */
+	s6e3fc3_test_key_on_lvl1(&dsi_ctx);
+	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	s6e3fc3_test_key_off_lvl1(&dsi_ctx);
+
+	return dsi_ctx.accum_err;
+}
+
+static int s6e3fc3_disable(struct drm_panel *panel)
+{
+	struct s6e3fc3 *ctx = to_s6e3fc3(panel);
+	int ret;
+
+	ret = s6e3fc3_off(ctx);
+	if (ret < 0)
+		dev_err(&ctx->dsi->dev, "Failed to un-initialize panel: %d\n", ret);
+
+	return 0;
+}
+
+static int s6e3fc3_unprepare(struct drm_panel *panel)
+{
+	struct s6e3fc3 *ctx = to_s6e3fc3(panel);
+
+	gpiod_set_value_cansleep(ctx->reset_gpio, 1);
+	regulator_disable(ctx->supplies[1].consumer);
+	/* qcom,supply-pre-off-sleep = <2> on VDDI */
+	usleep_range(2000, 3000);
+	regulator_disable(ctx->supplies[0].consumer);
+
+	return 0;
+}
+
+/* fhd60 timing node; the panel is in command mode, porches size the clock. */
+static const struct drm_display_mode s6e3fc3_ams646yd01_mode = {
+	.clock = (1080 + 80 + 84 + 88) * (2400 + 16 + 2 + 2) * 60 / 1000,
+	.hdisplay = 1080,
+	.hsync_start = 1080 + 80,
+	.hsync_end = 1080 + 80 + 84,
+	.htotal = 1080 + 80 + 84 + 88,
+	.vdisplay = 2400,
+	.vsync_start = 2400 + 16,
+	.vsync_end = 2400 + 16 + 2,
+	.vtotal = 2400 + 16 + 2 + 2,
+	.width_mm = 67,
+	.height_mm = 150,
+	.type = DRM_MODE_TYPE_DRIVER,
+};
+
+static int s6e3fc3_get_modes(struct drm_panel *panel,
+			     struct drm_connector *connector)
+{
+	return drm_connector_helper_get_modes_fixed(connector,
+						    &s6e3fc3_ams646yd01_mode);
+}
+
+static const struct drm_panel_funcs s6e3fc3_panel_funcs = {
+	.prepare = s6e3fc3_prepare,
+	.enable = s6e3fc3_enable,
+	.disable = s6e3fc3_disable,
+	.unprepare = s6e3fc3_unprepare,
+	.get_modes = s6e3fc3_get_modes,
+};
+
+static int s6e3fc3_bl_update_status(struct backlight_device *bl)
+{
+	struct mipi_dsi_device *dsi = bl_get_data(bl);
+	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+	u16 brightness = backlight_get_brightness(bl);
+	/* WRDISBV, 10 bits, big endian (vendor gamma_mode2_normal_tx_cmds) */
+	u8 wrdisbv[] = { MIPI_DCS_SET_DISPLAY_BRIGHTNESS, brightness >> 8, brightness & 0xff };
+
+	/* normal (non-HBM) brightness range: BCTRL on */
+	mipi_dsi_dcs_write_seq_multi(&dsi_ctx, MIPI_DCS_WRITE_CONTROL_DISPLAY, 0x20);
+	mipi_dsi_dcs_write_buffer_multi(&dsi_ctx, wrdisbv, sizeof(wrdisbv));
+
+	return dsi_ctx.accum_err;
+}
+
+static const struct backlight_ops s6e3fc3_bl_ops = {
+	.update_status = s6e3fc3_bl_update_status,
+};
+
+static struct backlight_device *s6e3fc3_create_backlight(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	const struct backlight_properties props = {
+		.type = BACKLIGHT_RAW,
+		.brightness = 512,
+		.max_brightness = S6E3FC3_MAX_BRIGHTNESS,
+	};
+
+	return devm_backlight_device_register(dev, dev_name(dev), dev, dsi,
+					      &s6e3fc3_bl_ops, &props);
+}
+
+static int s6e3fc3_probe(struct mipi_dsi_device *dsi)
+{
+	struct device *dev = &dsi->dev;
+	struct s6e3fc3 *ctx;
+	int ret;
+
+	ctx = devm_drm_panel_alloc(dev, struct s6e3fc3, panel,
+				   &s6e3fc3_panel_funcs, DRM_MODE_CONNECTOR_DSI);
+	if (IS_ERR(ctx))
+		return PTR_ERR(ctx);
+
+	ret = devm_regulator_bulk_get_const(dev, ARRAY_SIZE(s6e3fc3_supplies),
+					    s6e3fc3_supplies, &ctx->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "Failed to get regulators\n");
+
+	/* the bootloader leaves the panel running: do not reset it at probe */
+	ctx->reset_gpio = devm_gpiod_get(dev, "reset", GPIOD_OUT_LOW);
+	if (IS_ERR(ctx->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(ctx->reset_gpio),
+				     "Failed to get reset-gpios\n");
+
+	ctx->dsi = dsi;
+	mipi_dsi_set_drvdata(dsi, ctx);
+
+	dsi->lanes = 4;
+	dsi->format = MIPI_DSI_FMT_RGB888;
+	dsi->mode_flags = MIPI_DSI_CLOCK_NON_CONTINUOUS;
+
+	/* qcom,mdss-dsi-lp11-init: lanes in LP-11 before the reset sequence */
+	ctx->panel.prepare_prev_first = true;
+
+	ctx->panel.backlight = s6e3fc3_create_backlight(dsi);
+	if (IS_ERR(ctx->panel.backlight))
+		return dev_err_probe(dev, PTR_ERR(ctx->panel.backlight),
+				     "Failed to create backlight\n");
+
+	drm_panel_add(&ctx->panel);
+
+	/* DSC 1.1, 2 slices of 540x40, 8 bpc, 8 bpp, block prediction */
+	dsi->dsc = &ctx->dsc;
+	ctx->dsc.dsc_version_major = 1;
+	ctx->dsc.dsc_version_minor = 1;
+	ctx->dsc.slice_height = 40;
+	ctx->dsc.slice_width = 540;
+	ctx->dsc.slice_count = 1080 / ctx->dsc.slice_width;
+	ctx->dsc.bits_per_component = 8;
+	ctx->dsc.bits_per_pixel = 8 << 4;
+	ctx->dsc.block_pred_enable = true;
+
+	ret = mipi_dsi_attach(dsi);
+	if (ret < 0) {
+		dev_err(dev, "Failed to attach to DSI host: %d\n", ret);
+		drm_panel_remove(&ctx->panel);
+		return ret;
+	}
+
+	return 0;
+}
+
+static void s6e3fc3_remove(struct mipi_dsi_device *dsi)
+{
+	struct s6e3fc3 *ctx = mipi_dsi_get_drvdata(dsi);
+	int ret;
+
+	ret = mipi_dsi_detach(dsi);
+	if (ret < 0)
+		dev_err(&dsi->dev, "Failed to detach from DSI host: %d\n", ret);
+
+	drm_panel_remove(&ctx->panel);
+}
+
+static const struct of_device_id s6e3fc3_of_match[] = {
+	{ .compatible = "samsung,s6e3fc3-ams646yd01" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, s6e3fc3_of_match);
+
+static struct mipi_dsi_driver s6e3fc3_driver = {
+	.probe = s6e3fc3_probe,
+	.remove = s6e3fc3_remove,
+	.driver = {
+		.name = "panel-samsung-s6e3fc3",
+		.of_match_table = s6e3fc3_of_match,
+	},
+};
+module_mipi_dsi_driver(s6e3fc3_driver);
+
+MODULE_DESCRIPTION("DRM driver for the Samsung S6E3FC3 AMS646YD01 DSI panel");
+MODULE_LICENSE("GPL");
