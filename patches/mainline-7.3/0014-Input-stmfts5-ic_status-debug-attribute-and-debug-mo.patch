From 3bf555c002dc12d590eb47180ca2cf5c73bc7a0f Mon Sep 17 00:00:00 2001
From: a52sxq-kernel <a52sxq-kernel@example.invalid>
Date: Mon, 16 Nov 2026 19:02:23 +0200
Subject: [PATCH 14/17] Input: stmfts5: ic_status debug attribute and debug
 module parameter

ic_status (root only) reads the IC's state registers with read-only
accesses (firmware version, device id, panel info, touch types, operating
mode, firmware CRC status, gesture library mode) and shows the AVDD state
and the driver's event counters by class. debug=1 logs the same once at
power on. The init sequence is unchanged.
---
 drivers/input/touchscreen/stmfts5.c | 109 +++++++++++++++++++++++++++-
 1 file changed, 108 insertions(+), 1 deletion(-)

diff --git a/drivers/input/touchscreen/stmfts5.c b/drivers/input/touchscreen/stmfts5.c
index 59a31a707..a324a68d7 100644
--- a/drivers/input/touchscreen/stmfts5.c
+++ b/drivers/input/touchscreen/stmfts5.c
@@ -10,6 +10,9 @@
  * Galaxy A52s (drivers/input/sec_input/stm). Only the plain touchscreen function is
  * supported: no firmware update, no calibration data writes to the IC's flash, no
  * low-power gestures. The firmware already in the IC is used as it is.
+ *
+ * Debugging: the ic_status attribute (root only) reads the IC's state registers (read-only
+ * accesses) and shows the event counters; debug=1 logs the same once at power on.
  */
 
 #include <linux/bits.h>
@@ -28,12 +31,15 @@
 #define FTS5_CMD_SENSE_OFF		0x11
 #define FTS5_CMD_FORCE_CALIBRATION	0x13
 #define FTS5_READ_DEVICE_ID		0x22
+#define FTS5_READ_PANEL_INFO		0x23
 #define FTS5_READ_FW_VERSION		0x24
-#define FTS5_CMD_SET_TOUCH_TYPE		0x30
+#define FTS5_CMD_SET_TOUCH_TYPE		0x30	/* write sets, read returns the active types */
+#define FTS5_CMD_OPMODE			0x31	/* read: 0 normal, 1 low power */
 #define FTS5_READ_ONE_EVENT		0x60
 #define FTS5_READ_ALL_EVENT		0x61
 #define FTS5_CMD_CLEAR_ALL_EVENT	0x62
 #define FTS5_CMD_SCAN_MODE		0xa0
+#define FTS5_CMD_SPONGE_RW		0xaa	/* gesture library ("sponge") memory, offset BE16 */
 #define FTS5_CMD_REG			0xfa	/* register write, and read over I2C */
 
 #define FTS5_SCAN_MODE_OFF		0x00
@@ -87,6 +93,11 @@
 #define FTS5_POLL_INTERVAL_MS		20
 #define FTS5_READY_TRIES		150	/* 3 s, as the vendor driver */
 #define FTS5_ECHO_TRIES			50
+#define FTS5_STATUS_BUF			1024
+
+static bool debug;
+module_param(debug, bool, 0444);
+MODULE_PARM_DESC(debug, "log the IC status registers once at power on");
 
 enum fts5_supplies {
 	FTS5_SUPPLY_VDD,
@@ -103,6 +114,11 @@ struct fts5_data {
 	u8 *evbuf;			/* FTS5_FIFO_MAX events, kmalloc'ed: DMA safe */
 	bool running;
 
+	/* event counters for the ic_status attribute */
+	unsigned int irq_count;
+	unsigned int ev_count[4];	/* non-empty events by class */
+	u8 last_event[FTS5_EVENT_SIZE];
+
 	u32 chip_id;
 	u16 fw_ver;
 	u16 config_ver;
@@ -376,7 +392,13 @@ static irqreturn_t fts5_irq(int irq, void *dev_id)
 		}
 	}
 
+	fts->irq_count++;
 	for (i = 0; i <= left; i++, ev += FTS5_EVENT_SIZE) {
+		if (ev[0]) {
+			fts->ev_count[FTS5_EV_CLASS(ev[0])]++;
+			memcpy(fts->last_event, ev, FTS5_EVENT_SIZE);
+		}
+
 		switch (FTS5_EV_CLASS(ev[0])) {
 		case FTS5_EV_COORDINATE:
 			fts5_report_coordinate(fts, ev);
@@ -398,6 +420,75 @@ static irqreturn_t fts5_irq(int irq, void *dev_id)
 	return IRQ_HANDLED;
 }
 
+/* Read-only snapshot of the IC's state registers and of the event counters. Lock held. */
+static int fts5_format_status(struct fts5_data *fts, char *out, size_t size)
+{
+	static const u8 ver_cmd[] = { FTS5_READ_FW_VERSION };
+	static const u8 id_cmd[] = { FTS5_READ_DEVICE_ID };
+	static const u8 panel_cmd[] = { FTS5_READ_PANEL_INFO };
+	static const u8 type_cmd[] = { FTS5_CMD_SET_TOUCH_TYPE };
+	static const u8 opmode_cmd[] = { FTS5_CMD_OPMODE };
+	static const u8 crc_cmd[] = { FTS5_CMD_REG, 0x20, 0x00, 0x00, 0x78 };
+	static const u8 sponge_cmd[] = { FTS5_CMD_SPONGE_RW, 0x00, 0x00 };
+	static const struct {
+		const char *name;
+		const u8 *cmd;
+		u8 clen;
+		u8 len;
+	} regs[] = {
+		{ "fw_version(24)", ver_cmd, sizeof(ver_cmd), FTS5_VERSION_SIZE },
+		{ "device_id(22)", id_cmd, sizeof(id_cmd), FTS5_DEVICE_ID_SIZE },
+		/* x res BE16, y res BE16, ..., [8] force (TX) and [9] sense (RX) channels */
+		{ "panel_info(23)", panel_cmd, sizeof(panel_cmd), 11 },
+		{ "touch_type(30)", type_cmd, sizeof(type_cmd), 2 },
+		{ "opmode(31)", opmode_cmd, sizeof(opmode_cmd), 1 },
+		{ "crc_status(fa200078)", crc_cmd, sizeof(crc_cmd), 1 },
+		{ "sponge_mode(aa0000)", sponge_cmd, sizeof(sponge_cmd), 2 },
+	};
+	struct regulator *avdd = fts->supplies[FTS5_SUPPLY_AVDD].consumer;
+	/* the last FIFO slot of the DMA-safe event buffer; events are only read under the lock */
+	u8 *buf = fts->evbuf + (FTS5_FIFO_MAX - 1) * FTS5_EVENT_SIZE;
+	int i, ret, n = 0;
+
+	for (i = 0; i < ARRAY_SIZE(regs); i++) {
+		memset(buf, 0, regs[i].len);
+		ret = fts5_read(fts, regs[i].cmd, regs[i].clen, buf, regs[i].len);
+		if (ret)
+			n += scnprintf(out + n, size - n, "%s: read error %d\n", regs[i].name, ret);
+		else
+			n += scnprintf(out + n, size - n, "%s: %*ph\n", regs[i].name,
+				       regs[i].len, buf);
+	}
+
+	n += scnprintf(out + n, size - n, "avdd: enabled %d, %d uV, mode %#x\n",
+		       regulator_is_enabled(avdd), regulator_get_voltage(avdd),
+		       regulator_get_mode(avdd));
+	n += scnprintf(out + n, size - n,
+		       "running %d, irq reads %u, events: coord %u status %u gesture %u vendor %u\n",
+		       fts->running, fts->irq_count, fts->ev_count[FTS5_EV_COORDINATE],
+		       fts->ev_count[FTS5_EV_STATUS], fts->ev_count[FTS5_EV_GESTURE],
+		       fts->ev_count[FTS5_EV_VENDOR]);
+	n += scnprintf(out + n, size - n, "last event: %16ph\n", fts->last_event);
+
+	return n;
+}
+
+static void fts5_log_status(struct fts5_data *fts)
+{
+	char *out, *p, *line;
+
+	out = kzalloc(FTS5_STATUS_BUF, GFP_KERNEL);
+	if (!out)
+		return;
+
+	fts5_format_status(fts, out, FTS5_STATUS_BUF);
+	p = out;
+	while ((line = strsep(&p, "\n")) && *line)
+		dev_info(&fts->client->dev, "status: %s\n", line);
+
+	kfree(out);
+}
+
 static int fts5_power_on(struct fts5_data *fts)
 {
 	static const u8 touch_type[] = {
@@ -447,6 +538,8 @@ static int fts5_power_on(struct fts5_data *fts)
 		goto err;
 
 	fts->running = true;
+	if (debug)
+		fts5_log_status(fts);
 	mutex_unlock(&fts->lock);
 
 	enable_irq(fts->client->irq);
@@ -514,11 +607,25 @@ static ssize_t main_version_show(struct device *dev, struct device_attribute *at
 }
 static DEVICE_ATTR_RO(main_version);
 
+static ssize_t ic_status_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct fts5_data *fts = dev_get_drvdata(dev);
+	int n;
+
+	mutex_lock(&fts->lock);
+	n = fts5_format_status(fts, buf, PAGE_SIZE);
+	mutex_unlock(&fts->lock);
+
+	return n;
+}
+static DEVICE_ATTR_ADMIN_RO(ic_status);
+
 static struct attribute *fts5_attrs[] = {
 	&dev_attr_chip_id.attr,
 	&dev_attr_fw_version.attr,
 	&dev_attr_config_version.attr,
 	&dev_attr_main_version.attr,
+	&dev_attr_ic_status.attr,
 	NULL
 };
 ATTRIBUTE_GROUPS(fts5);
