# Samsung Galaxy A52s 5G (a52sxq) on sc7280-mainline 7.3: additions to fp5_defconfig for the
# kexec bring-up (MAINLINE-PLAN.md step 2). Merged by ./build-mainline.sh; every symbol listed
# here as =y/=m is checked after olddefconfig.
CONFIG_LOCALVERSION="-a52sxq"
# CONFIG_LOCALVERSION_AUTO is not set
# no pahole/BTF dependency for a bring-up kernel
# CONFIG_DEBUG_INFO_BTF is not set

# our bring-up ramdisk (ramdisk/init) mounts devtmpfs, configfs, pstore, debugfs itself
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_CONFIGFS_FS=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_UNIX98_PTYS=y
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y

# USB 2.0 gadget: NCM (172.16.<a52.net>.1 telnet) + ACM, built in (nothing is modprobed)
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y

# UFS (read-only use in M1; the ramdisk mounts /cache ro at most)
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y

# ramoops at 0xf0b00000, layout from the dts (= the 6.18 harness: 0xe0000, record 0x20000):
# the harness's crash guard reads this kernel's console from it after a reset
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# arch/arm64/kernel/a52ram.c (earlycon=a52ram,0xf0be0000, read back as /proc/a52ram)
CONFIG_SERIAL_EARLYCON=y
CONFIG_PROC_FS=y

# bootloader framebuffer + fbcon: the ramdisk writes its banner to /dev/tty0
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# self-reboot: /rb download -> reboot-mode 0x15 in the PMK8350 SDAM
CONFIG_REBOOT_MODE=y
CONFIG_NVMEM_REBOOT_MODE=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_MAGIC_SYSRQ=y

# kexec chain (kexec/README.md): this kernel can itself load a next one
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y

# Hypervisor watchdog. The kernel is started by /kexec-run with the VM watchdog ARMED; the
# ramdisk disarms it with modules/hhwdt (built for this kernel). The upstream driver's probe
# stops the watchdog, so it stays a module that is only loaded by hand (ramdisk /extra).
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_GUNYAH_WATCHDOG=m
# CONFIG_QCOM_WDT is not set

# Hang safety: a task stuck in D state for 120 s (an idle deadlock the VM watchdog does not
# count, e.g. a mutex in device_shutdown) and a soft lockup panic, and a panic reboots after
# 10 s into the harness. In 7.x hung_task_panic is no longer a boot parameter (sysctl only, set
# after the initcalls), so it is on by default here.
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=120
CONFIG_BOOTPARAM_HUNG_TASK_PANIC=1
CONFIG_SOFTLOCKUP_DETECTOR=y
CONFIG_BOOTPARAM_SOFTLOCKUP_PANIC=1
CONFIG_PANIC_TIMEOUT=10

# M2: risky drivers are modules, loaded by hand from the ramdisk's /extra (KX_EXTRA), so a crash
# in them lands in the harness instead of killing every boot before the ramdisk.
# remoteprocs (ADSP/CDSP with the phone's own firmware from apnhlos) and FastRPC
CONFIG_QCOM_Q6V5_PAS=m
CONFIG_QCOM_FASTRPC=m
# microSD (sdhc_2): probe only by hand; the card is never mounted rw
CONFIG_MMC_SDHCI_MSM=m
# DC vibrator on TLMM 62
CONFIG_INPUT_FF_MEMLESS=y
CONFIG_INPUT_GPIO_VIBRA=m
