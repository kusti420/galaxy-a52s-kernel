From 7f9a3107e51cec896e0de9bc33ec210762761686 Mon Sep 17 00:00:00 2001
From: a52sxq-kernel <a52sxq-kernel@example.invalid>
Date: Sun, 15 Nov 2026 18:52:44 +0200
Subject: [PATCH 7/7] arm64: dts: qcom: sm7325-samsung-a52sxq: board base
 (regulators, ADC, thermal, hall, vibrator, SD, ADSP/CDSP, L3)

- every downstream VRM rail with an init voltage on the mainline grid, pinned
  min == max to it (22); off-grid, display and PMR735A rails documented
- PMK8350/PM7325 ADC7 channels and ADC_TM thermal zones (xo, quiet, sdm-skin)
- hall sensor (TLMM 101, SW_LID) in gpio-keys, gpio-vibrator on TLMM 62
- sdhc_2: CD TLMM 91, L9C/L6C pinned 2.96 V (no 1.8 V signalling)
- ADSP/CDSP PAS with the phone's own adsp.mdt/cdsp.mdt; fastrpc cb 0x1805 nsessions 5
- epss_l3: the generic L3_VOTE (+0x90) descriptor; the sc7280 PERF_STATE (+0x320)
  vote does not reach the L3 on this firmware (measured)
- QCE crypto disabled: never probes and held every interconnect at INT_MAX
---
 .../boot/dts/qcom/sm7325-samsung-a52sxq.dts   | 429 +++++++++++++++++-
 1 file changed, 428 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/sm7325-samsung-a52sxq.dts b/arch/arm64/boot/dts/qcom/sm7325-samsung-a52sxq.dts
index cae3e9de3..ccd2ddd10 100644
--- a/arch/arm64/boot/dts/qcom/sm7325-samsung-a52sxq.dts
+++ b/arch/arm64/boot/dts/qcom/sm7325-samsung-a52sxq.dts
@@ -19,6 +19,8 @@
 /dts-v1/;
 
 #include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/iio/qcom,spmi-adc7-pm7325.h>
+#include <dt-bindings/iio/qcom,spmi-adc7-pmk8350.h>
 #include <dt-bindings/input/input.h>
 #include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
 #include <dt-bindings/regulator/qcom,rpmh-regulator.h>
@@ -67,9 +69,23 @@ framebuffer: framebuffer@e1000000 {
 	gpio-keys {
 		compatible = "gpio-keys";
 
-		pinctrl-0 = <&kypd_vol_up_n>;
+		pinctrl-0 = <&kypd_vol_up_n>, <&hall_irq_default>;
 		pinctrl-names = "default";
 
+		/*
+		 * downstream hall_ic/hall: TLMM 101, active low (cover closed = low). Samsung reports
+		 * its own switch code 0x15 (beyond SW_MAX); the upstream meaning is SW_LID.
+		 */
+		event-hall-sensor {
+			label = "Hall Effect Sensor";
+			gpios = <&tlmm 101 GPIO_ACTIVE_LOW>;
+			linux,input-type = <EV_SW>;
+			linux,code = <SW_LID>;
+			linux,can-disable;
+			debounce-interval = <15>;
+			wakeup-source;
+		};
+
 		/* downstream gpio_keys/vol_up: pm7325 gpio 6, active low */
 		key-volume-up {
 			label = "Volume Up";
@@ -181,6 +197,59 @@ ramoops@f0b00000 {
 		};
 	};
 
+	/* downstream dc_vibrator: coin DC motor, enable on TLMM 62 (active high), no supply */
+	vibrator {
+		compatible = "gpio-vibrator";
+		enable-gpios = <&tlmm 62 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&vib_en_default>;
+		pinctrl-names = "default";
+	};
+
+	thermal-zones {
+		/*
+		 * The PMK8350 ADC_TM channels of the downstream tree (same channels, same 125 C
+		 * passive trip, no cooling: monitoring only). sdm-skin = the downstream ap_therm.
+		 * Not here: camera (PM7325 AMUX_THM2, reads 4.6 C) and rear-cam (AMUX_THM4, reads
+		 * -41 C = open input) read implausibly on this board (run ml73-c); their ADC
+		 * channels stay for reference.
+		 */
+		xo-thermal {
+			thermal-sensors = <&pmk8350_adc_tm 0>;
+
+			trips {
+				active-config0 {
+					temperature = <125000>;
+					hysteresis = <1000>;
+					type = "passive";
+				};
+			};
+		};
+
+		quiet-thermal {
+			thermal-sensors = <&pmk8350_adc_tm 1>;
+
+			trips {
+				active-config0 {
+					temperature = <125000>;
+					hysteresis = <1000>;
+					type = "passive";
+				};
+			};
+		};
+
+		sdm-skin-thermal {
+			thermal-sensors = <&pmk8350_adc_tm 3>;
+
+			trips {
+				active-config0 {
+					temperature = <125000>;
+					hysteresis = <1000>;
+					type = "passive";
+				};
+			};
+		};
+	};
+
 	vph_pwr: regulator-vph-pwr {
 		compatible = "regulator-fixed";
 
@@ -208,6 +277,19 @@ &reserved_xbl_uefi_log {
 
 &apps_rsc {
 	/*
+	 * Every VRM rail that has a "qcom,init-voltage" downstream (regulators-r02.txt) and whose
+	 * init voltage lies on the mainline driver's voltage grid is described here, pinned to that
+	 * voltage. Rails NOT described (left as the bootloader set them, nothing is voted):
+	 * - off the mainline grid (pinning would fail registration of the whole PMIC): L12B 0.751,
+	 *   L13B 0.53, L15B 0.765, L16B 1.1, L17B 1.7, S1C 2.19, L2C/L4C/L5C 1.62, L3C 3.3 V;
+	 * - display L8C (VDDI, init 1.62 V outside its 1.8 V range) and L13C (VCI, init 2.7 V
+	 *   outside 3.0 V): the bootloader keeps the panel running on them until a panel driver;
+	 * - no init voltage downstream: BOB, L5E, L6E; ARC level rails (cx/mx/ebi/lmx/lcx);
+	 * - PMR735A (L2E 1.2, L3E 0.912, L4E 1.776 V downstream): this phone's cmd-db has no
+	 *   ldoe* resources ("could not find RPMh address for resource ldoe2", run ml73-c), and
+	 *   its ADC die temperature does not answer: the PMIC is not populated / not ours.
+	 * The new rails get no mode and no enable: only the voltage vote that downstream sends.
+	 *
 	 * Each rail is pinned to the voltage the downstream kernel initialises it to
 	 * ("qcom,init-voltage" in downstream-dt/regulators-r02.txt), min == max. This matters:
 	 * Linux cannot read an RPMh regulator's voltage back, so when it registers one it
@@ -260,6 +342,75 @@ vreg_l9b: ldo9 {
 			regulator-always-on;
 			regulator-boot-on;
 		};
+		/* pm7325_s1 (1.856 - 2.04 V) */
+		vreg_s1b: smps1 {
+			regulator-name = "vreg_s1b";
+			regulator-min-microvolt = <1872000>;
+			regulator-max-microvolt = <1872000>;
+		};
+
+		/* pm7325_s7 (0.535 - 1.12 V) */
+		vreg_s7b: smps7 {
+			regulator-name = "vreg_s7b";
+			regulator-min-microvolt = <972000>;
+			regulator-max-microvolt = <972000>;
+		};
+
+		/* pm7325_s8 (1.2 - 1.5 V) */
+		vreg_s8b: smps8 {
+			regulator-name = "vreg_s8b";
+			regulator-min-microvolt = <1272000>;
+			regulator-max-microvolt = <1272000>;
+		};
+
+		/* pm7325_l1 (0.825 - 0.925 V) */
+		vreg_l1b: ldo1 {
+			regulator-name = "vreg_l1b";
+			regulator-min-microvolt = <912000>;
+			regulator-max-microvolt = <912000>;
+		};
+
+		/* pm7325_l3 (0.312 - 0.91 V) */
+		vreg_l3b: ldo3 {
+			regulator-name = "vreg_l3b";
+			regulator-min-microvolt = <504000>;
+			regulator-max-microvolt = <504000>;
+		};
+
+		/* pm7325_l8 (0.87 - 0.97 V) */
+		vreg_l8b: ldo8 {
+			regulator-name = "vreg_l8b";
+			regulator-min-microvolt = <904000>;
+			regulator-max-microvolt = <904000>;
+		};
+
+		/* pm7325_l11 (1.504 - 2.0 V) */
+		vreg_l11b: ldo11 {
+			regulator-name = "vreg_l11b";
+			regulator-min-microvolt = <1504000>;
+			regulator-max-microvolt = <1504000>;
+		};
+
+		/* pm7325_l14 (1.08 - 1.304 V) */
+		vreg_l14b: ldo14 {
+			regulator-name = "vreg_l14b";
+			regulator-min-microvolt = <1080000>;
+			regulator-max-microvolt = <1080000>;
+		};
+
+		/* pm7325_l18 (1.8 - 2.0 V) */
+		vreg_l18b: ldo18 {
+			regulator-name = "vreg_l18b";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
+
+		/* pm7325_l19 (1.8 - 2.0 V) */
+		vreg_l19b: ldo19 {
+			regulator-name = "vreg_l19b";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
 	};
 
 	regulators-1 {
@@ -285,6 +436,47 @@ vreg_l10c: ldo10 {
 			regulator-always-on;
 			regulator-boot-on;
 		};
+		/* pm8350c_s9 (1.01 - 1.17 V) */
+		vreg_s9c: smps9 {
+			regulator-name = "vreg_s9c";
+			regulator-min-microvolt = <1084000>;
+			regulator-max-microvolt = <1084000>;
+		};
+
+		/* pm8350c_l6 (1.65 - 3.544 V): microSD I/O; pinned at 2.96 V, so no 1.8 V signalling */
+		vreg_l6c: ldo6 {
+			regulator-name = "vreg_l6c";
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <2960000>;
+		};
+
+		/* pm8350c_l7 (3.0 V): touch AVDD */
+		vreg_l7c: ldo7 {
+			regulator-name = "vreg_l7c";
+			regulator-min-microvolt = <3000000>;
+			regulator-max-microvolt = <3000000>;
+		};
+
+		/* pm8350c_l9 (2.7 - 3.544 V): microSD card VDD */
+		vreg_l9c: ldo9 {
+			regulator-name = "vreg_l9c";
+			regulator-min-microvolt = <2960000>;
+			regulator-max-microvolt = <2960000>;
+		};
+
+		/* pm8350c_l11 (2.8 - 3.544 V) */
+		vreg_l11c: ldo11 {
+			regulator-name = "vreg_l11c";
+			regulator-min-microvolt = <2800000>;
+			regulator-max-microvolt = <2800000>;
+		};
+
+		/* pm8350c_l12 (1.8 V) */
+		vreg_l12c: ldo12 {
+			regulator-name = "vreg_l12c";
+			regulator-min-microvolt = <1800000>;
+			regulator-max-microvolt = <1800000>;
+		};
 	};
 };
 
@@ -455,3 +647,238 @@ firmware: firmware {
 &{/soc@0/tpdm@6b0c000} { status = "disabled"; };
 &{/soc@0/tpdm@6b0d000} { status = "disabled"; };
 &{/soc@0/cti@6b11000} { status = "disabled"; };
+
+/*
+ * M2 board base (mainline track). Values from downstream-dt/a52sxq-r02.dts (line numbers in
+ * MAINLINE-STATUS.md of the a52sxq-mainline project).
+ */
+
+/*
+ * The phone's L3 follows the AP vote in the EPSS L3_VOTE register (+0x90, as the downstream 5.4
+ * epss-l3 driver writes it). Measured on 7.3 (run ml73-b): with the sc7280 descriptor the vote
+ * goes to PERF_STATE (+0x320, idx 10 = 1516.8 MHz) and the L3 stays at 1190.4 MHz (another
+ * voter's floor); 6.12 writing +0x90 idx 10 ran the L3 at 1516.8 MHz. The generic "qcom,epss-l3"
+ * descriptor writes +0x90.
+ */
+&epss_l3 {
+	compatible = "qcom,epss-l3";
+};
+
+/* ADC7 channels of the downstream pmk8350_vadc (thermistors 100k pull-up, ratiometric) */
+&pmk8350_vadc {
+	channel@3 {
+		reg = <PMK8350_ADC7_DIE_TEMP>;
+		label = "pmk8350_die_temp";
+		qcom,pre-scaling = <1 1>;
+	};
+
+	channel@44 {
+		reg = <PMK8350_ADC7_AMUX_THM1_100K_PU>;
+		label = "pmk8350_xo_therm";
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+	};
+
+	channel@103 {
+		reg = <PM7325_ADC7_DIE_TEMP>;
+		label = "pm7325_die_temp";
+		qcom,pre-scaling = <1 1>;
+	};
+
+	channel@144 {
+		reg = <PM7325_ADC7_AMUX_THM1_100K_PU>;
+		label = "pm7325_quiet_therm";
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+	};
+
+	channel@145 {
+		reg = <PM7325_ADC7_AMUX_THM2_100K_PU>;
+		label = "pm7325_cam_flash_therm";
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+	};
+
+	/* downstream sec_ap_thermistor */
+	channel@146 {
+		reg = <PM7325_ADC7_AMUX_THM3_100K_PU>;
+		label = "ap_therm";
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+	};
+
+	channel@147 {
+		reg = <PM7325_ADC7_AMUX_THM4_100K_PU>;
+		label = "pm7325_wide_rfc_therm";
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+	};
+
+	/*
+	 * pa_therm (AMUX_THM5, pin PM7325 GPIO1) and the GPIO channels chg/bat/wf_therm: the
+	 * pins belong to the modem's execution environment (APPS writes are refused) and read
+	 * ~70 C until the modem configures them (drivers612/power/THERMISTOR-ADC.md). Described
+	 * for completeness; no pinctrl is applied from here.
+	 */
+	channel@148 {
+		reg = <PM7325_ADC7_AMUX_THM5_100K_PU>;
+		label = "pa_therm";
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+	};
+
+	channel@14a {
+		reg = <PM7325_ADC7_GPIO1_100K_PU>;
+		label = "chg_therm";
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+	};
+
+	channel@14b {
+		reg = <PM7325_ADC7_GPIO2_100K_PU>;
+		label = "bat_therm";
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+	};
+
+	channel@14c {
+		reg = <PM7325_ADC7_GPIO3_100K_PU>;
+		label = "wf_therm";
+		qcom,hw-settle-time = <200>;
+		qcom,pre-scaling = <1 1>;
+		qcom,ratiometric;
+	};
+
+	channel@18e {
+		reg = <PM7325_ADC7_VPH_PWR>;
+		label = "pm7325_vph_pwr";
+		qcom,pre-scaling = <1 3>;
+	};
+};
+
+/* downstream pmk8350_adc_tm (the downstream node lists ap_therm 0x146 in io-channels too) */
+&pmk8350_adc_tm {
+	status = "okay";
+
+	xo-therm@0 {
+		reg = <0>;
+		io-channels = <&pmk8350_vadc PMK8350_ADC7_AMUX_THM1_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time-us = <200>;
+	};
+
+	quiet-therm@1 {
+		reg = <1>;
+		io-channels = <&pmk8350_vadc PM7325_ADC7_AMUX_THM1_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time-us = <200>;
+	};
+
+	sdm-skin-therm@3 {
+		reg = <3>;
+		io-channels = <&pmk8350_vadc PM7325_ADC7_AMUX_THM3_100K_PU>;
+		qcom,ratiometric;
+		qcom,hw-settle-time-us = <200>;
+	};
+};
+
+/*
+ * ADSP and CDSP with the phone's own split firmware from its apnhlos partition
+ * (/vendor/firmware_mnt/image on Android): firmware_class.path points at that directory.
+ * Downstream firmware names "adsp" / "cdsp" (pas-id 1 / 18). The PAS driver is a module.
+ */
+&remoteproc_adsp {
+	firmware-name = "adsp.mdt";
+
+	status = "okay";
+};
+
+&remoteproc_cdsp {
+	firmware-name = "cdsp.mdt";
+
+	status = "okay";
+};
+
+/* downstream adsprpc cb12 (SID 0x1805) has shared-cb = <5> */
+&{/soc@0/remoteproc@3700000/glink-edge/fastrpc/compute-cb@5} {
+	qcom,nsessions = <5>;
+};
+
+/*
+ * microSD, as downstream sdhc_2: VDD L9C 2.96 V, I/O L6C (pinned 2.96 V: no UHS 1.8 V
+ * signalling), card detect TLMM 91 active low. sdhci-msm is a module, loaded by hand; nothing
+ * mounts the card (phone 1's card must never be written).
+ */
+&sdhc_2 {
+	cd-gpios = <&tlmm 91 GPIO_ACTIVE_LOW>;
+
+	vmmc-supply = <&vreg_l9c>;
+	vqmmc-supply = <&vreg_l6c>;
+	no-1-8-v;
+
+	pinctrl-0 = <&sdc2_clk>, <&sdc2_cmd>, <&sdc2_data>, <&sd_cd_default>;
+	pinctrl-1 = <&sdc2_clk_sleep>, <&sdc2_cmd_sleep>, <&sdc2_data_sleep>, <&sd_cd_default>;
+	pinctrl-names = "default", "sleep";
+
+	status = "okay";
+};
+
+/* downstream sdc2_on (default state) */
+&sdc2_clk {
+	drive-strength = <16>;
+	bias-disable;
+};
+
+&sdc2_cmd {
+	drive-strength = <10>;
+	bias-pull-up;
+};
+
+&sdc2_data {
+	drive-strength = <10>;
+	bias-pull-up;
+};
+
+&tlmm {
+	/* downstream sdc2_on/sdc2_off: card detect */
+	sd_cd_default: sd-cd-default-state {
+		pins = "gpio91";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+
+	/* downstream hall_irq: input, 2 mA, pull-up */
+	hall_irq_default: hall-irq-default-state {
+		pins = "gpio101";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-pull-up;
+		input-enable;
+	};
+
+	/* vibrator enable: plain GPIO output (downstream has no pinctrl state for it) */
+	vib_en_default: vib-en-default-state {
+		pins = "gpio62";
+		function = "gpio";
+		drive-strength = <2>;
+		bias-disable;
+	};
+};
+
+/*
+ * The QCE crypto engine has no user here (CONFIG_CRYPTO_DEV_QCOM_QCE is off) and, as an
+ * interconnect consumer that never probes, it kept every interconnect provider from reaching
+ * sync_state: all paths, the L3 included, stayed at the INT_MAX boot floor (run ml73-c).
+ */
+&crypto {
+	status = "disabled";
+};
