  */
 #define FDT_EXTRA_SPACE 0x1000
 
+/*
+ * a52sxq: alternative base FDT for the next kexec_file_load().
+ * Root writes a complete dtb to /sys/firmware/kexec_fdt (sequentially, from offset 0); the
+ * next kexec_file_load() then starts from that blob instead of initial_boot_params, so a
+ * kernel with different bindings can be started. /chosen is still filled in as usual.
+ * A write of fewer than 8 bytes at offset 0 clears it. An invalid blob fails the load.
+ */
+#define KEXEC_ALT_FDT_MAX	(4 * 1024 * 1024)
+static DEFINE_MUTEX(kexec_alt_fdt_lock);
+static void *kexec_alt_fdt;
+static size_t kexec_alt_fdt_len;
+
+static ssize_t kexec_fdt_write(struct file *file, struct kobject *kobj,
+			       const struct bin_attribute *attr, char *buf,
+			       loff_t off, size_t count)
+{
+	ssize_t ret = count;
+
+	mutex_lock(&kexec_alt_fdt_lock);
+	if (off == 0) {
+		kexec_alt_fdt_len = 0;
+		if (count < 8)
+			goto out;
+	}
+	if (off != kexec_alt_fdt_len || off + count > KEXEC_ALT_FDT_MAX) {
+		kexec_alt_fdt_len = 0;
+		ret = -EFBIG;
+		goto out;
+	}
+	if (!kexec_alt_fdt) {
+		kexec_alt_fdt = vzalloc(KEXEC_ALT_FDT_MAX);
+		if (!kexec_alt_fdt) {
+			ret = -ENOMEM;
+			goto out;
+		}
+	}
+	memcpy(kexec_alt_fdt + off, buf, count);
+	kexec_alt_fdt_len = off + count;
+out:
+	mutex_unlock(&kexec_alt_fdt_lock);
+	return ret;
+}
+
+static ssize_t kexec_fdt_read(struct file *file, struct kobject *kobj,
+			      const struct bin_attribute *attr, char *buf,
+			      loff_t off, size_t count)
+{
+	ssize_t ret = 0;
+
+	mutex_lock(&kexec_alt_fdt_lock);
+	if (off < kexec_alt_fdt_len) {
+		ret = min_t(size_t, count, kexec_alt_fdt_len - off);
+		memcpy(buf, kexec_alt_fdt + off, ret);
+	}
+	mutex_unlock(&kexec_alt_fdt_lock);
+	return ret;
+}
+
+static const BIN_ATTR_ADMIN_RW(kexec_fdt, 0);
+
+/* fdt_check_full() is not built into the kernel's libfdt: header, size and a full node walk. */
+static int kexec_alt_fdt_check(const void *fdt, size_t len)
+{
+	int node;
+
+	if (len < sizeof(struct fdt_header) || fdt_check_header(fdt) ||
+	    fdt_totalsize(fdt) > len)
+		return -EINVAL;
+	/*
+	 * No depth pointer: with one, fdt_next_node() returns the offset behind the root's
+	 * END_NODE (not -FDT_ERR_NOTFOUND) when the depth drops below zero, and the next call
+	 * then fails with BADOFFSET, which made every valid dtb look invalid here.
+	 */
+	for (node = 0; node >= 0; node = fdt_next_node(fdt, node, NULL))
+		;
+	if (node != -FDT_ERR_NOTFOUND || fdt_path_offset(fdt, "/memory") < 0)
+		return -EINVAL;
+	return 0;
+}
+
+static int __init kexec_alt_fdt_init(void)
+{
+	return sysfs_create_bin_file(firmware_kobj, &bin_attr_kexec_fdt);
+}
+late_initcall(kexec_alt_fdt_init);
