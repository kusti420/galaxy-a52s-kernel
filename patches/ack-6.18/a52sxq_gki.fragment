# Samsung Galaxy A52s 5G (a52sxq, SM7325) on top of gki_defconfig.
# Bring-up stage: SoC drivers built in (=y) so one Image boots without vendor_dlkm.
# CONFIG_MODULE_SIG_ALL is not set
CONFIG_PINCTRL_MSM=y
CONFIG_PINCTRL_SC7280=y
CONFIG_PINCTRL_SC7280_LPASS_LPI=y
CONFIG_PINCTRL_QCOM_SPMI_PMIC=y
CONFIG_PINCTRL_LPASS_LPI=y
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_CLK_RPMH=y
CONFIG_SC_GCC_7280=y
CONFIG_SC_DISPCC_7280=y
CONFIG_SC_GPUCC_7280=y
CONFIG_SC_VIDEOCC_7280=y
CONFIG_SC_CAMCC_7280=y
CONFIG_SC_LPASS_CORECC_7280=y
CONFIG_QCOM_GDSC=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMHPD=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_QCOM_SMP2P=y
CONFIG_QCOM_SMSM=y
CONFIG_QCOM_SOCINFO=y
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_AOSS_QMP=y
CONFIG_QCOM_PDC=y
CONFIG_QCOM_IPCC=y
CONFIG_QCOM_GENI_SE=y
CONFIG_QCOM_STATS=y
CONFIG_QCOM_RMTFS_MEM=y
CONFIG_QCOM_PDR_HELPERS=y
CONFIG_QCOM_APR=y
CONFIG_HWSPINLOCK_QCOM=y
CONFIG_INTERCONNECT_QCOM=y
CONFIG_INTERCONNECT_QCOM_SC7280=y
CONFIG_INTERCONNECT_QCOM_OSM_L3=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_ARM_SMMU=y
CONFIG_ARM_SMMU_QCOM=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_REGULATOR_QCOM_RPMH=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_RESET_QCOM_AOSS=y
CONFIG_RESET_QCOM_PDC=y
CONFIG_POWER_RESET_QCOM_PON=y
CONFIG_INPUT_PM8941_PWRKEY=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_QCOM_WDT=y
CONFIG_QCOM_TSENS=y
CONFIG_QCOM_SPMI_TEMP_ALARM=y
CONFIG_QCOM_SPMI_ADC5=y
CONFIG_QCOM_SPMI_ADC_TM5=y
CONFIG_QCOM_LMH=y
CONFIG_RTC_DRV_PM8XXX=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_NVMEM_SPMI_SDAM=y
CONFIG_SERIAL_QCOM_GENI=y
CONFIG_SERIAL_QCOM_GENI_CONSOLE=y
CONFIG_I2C_QCOM_GENI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_QCOM_GPI_DMA=y
CONFIG_SCSI_UFS_QCOM=y
CONFIG_PHY_QCOM_QMP=y
CONFIG_PHY_QCOM_QMP_UFS=y
CONFIG_PHY_QCOM_QMP_COMBO=y
CONFIG_PHY_QCOM_USB_SNPS_FEMTO_V2=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_QCOM=y
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_MAILBOX=y
CONFIG_QCOM_Q6V5_PAS=y
CONFIG_QCOM_SYSMON=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
CONFIG_QCOM_FASTRPC=y
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
CONFIG_MAGIC_SYSRQ=y
# DMA-BUF heaps backing modules/ioncompat (/dev/ion for the 5.4 vendor blobs)
CONFIG_DMABUF_HEAPS_SYSTEM=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_REBOOT_MODE=y
CONFIG_NVMEM_REBOOT_MODE=y
# bring-up ramdisk needs /dev without Android init
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
# kexec chain (kexec/README.md): experimental kernels are started from this harness
CONFIG_KEXEC=y
CONFIG_KEXEC_FILE=y
