# Additions to fp5_defconfig for the A52s bring-up. Apply with:
#   cd linux && ./scripts/kconfig/merge_config.sh -m -O ../out ../out/.config ../a52sxq.config && make ARCH=arm64 LLVM=1 O=../out olddefconfig
# Crash log that survives a reboot (read back from Android as SYSTEM_LAST_KMSG).
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_PMSG=y
# Serial console over USB for the initramfs debug shell.
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_MAGIC_SYSRQ=y
