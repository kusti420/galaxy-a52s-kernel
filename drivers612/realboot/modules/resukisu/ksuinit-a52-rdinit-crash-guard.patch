+
+/// a52sxq: true when /sys/fs/pstore holds a dmesg-* (oops/panic) record; the records are removed.
+fn a52_previous_boot_panicked() -> bool {
+    const MP: &str = "/a52pstore";
+    if mount_filesystem("pstore", MP).is_err() {
+        return false;
+    }
+    let mut found = false;
+    if let Ok(dir) = std::fs::read_dir(MP) {
+        for e in dir.flatten() {
+            let name = e.file_name();
+            let name = name.to_string_lossy();
+            if name.starts_with("dmesg-") {
+                found = true;
+                log::error!("a52: panic record {}", name);
+                let _ = unlink(format!("{MP}/{name}").as_str());
+            }
+        }
+    }
+    let _ = unmount(MP, UnmountFlags::DETACH);
+    let _ = std::fs::remove_dir(MP);
+    found
+}
