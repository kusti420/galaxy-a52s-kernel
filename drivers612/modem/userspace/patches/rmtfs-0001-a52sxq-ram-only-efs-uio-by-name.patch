+/*
+ * a52sxq (Qualcomm 6.12 BSP, kernel-only test): the buffer is msm_sharedmem's UIO device with
+ * name "rmtfs" (/sys/class/uio/uioN, map0 = physical address + size, mmap offset 0 = map0).
+ * Found by name in sysfs (no udev in the test ramdisk). The upstream qcom_rmtfs_mem and
+ * /dev/mem paths are compiled out: on this setup /proc/device-tree/reserved-memory/rmtfs* is
+ * the 6.18 harness's region that is stage-2 assigned to the modem, touching it from HLOS
+ * would fault.
+ */
+static int read_sys_hex(const char *path, uint64_t *value)
+{
+	char buf[64];
+	char *end;
+	ssize_t n;
+	int fd;
+
+	fd = open(path, O_RDONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -errno;
+	n = read(fd, buf, sizeof(buf) - 1);
+	close(fd);
+	if (n <= 0)
+		return -EINVAL;
+	buf[n] = '\0';
+	errno = 0;
+	*value = strtoull(buf, &end, 16);
+	if (errno || end == buf)
+		return -EINVAL;
+	return 0;
+}
+
+static int rmtfs_mem_open_uio_by_name(struct rmtfs_mem *rmem)
+{
+	char path[PATH_MAX];
+	char name[64];
+	struct dirent *de;
+	struct stat sb;
+	DIR *dir;
+	ssize_t n;
+	int found = 0;
+	int fd;
+
+	dir = opendir("/sys/class/uio");
+	if (!dir) {
+		fprintf(stderr, "[RMTFS] no /sys/class/uio: %s\n", strerror(errno));
+		return -ENOENT;
+	}
+	while ((de = readdir(dir)) != NULL) {
+		if (strncmp(de->d_name, "uio", 3))
+			continue;
+		snprintf(path, sizeof(path), "/sys/class/uio/%s/name", de->d_name);
+		fd = open(path, O_RDONLY | O_CLOEXEC);
+		if (fd < 0)
+			continue;
+		n = read(fd, name, sizeof(name) - 1);
+		close(fd);
+		if (n <= 0)
+			continue;
+		name[n] = '\0';
+		if (name[n - 1] == '\n')
+			name[n - 1] = '\0';
+		if (strcmp(name, "rmtfs"))
+			continue;
+		found = 1;
+		break;
+	}
+	if (!found) {
+		closedir(dir);
+		fprintf(stderr, "[RMTFS] no UIO device named rmtfs (msm_sharedmem loaded?)\n");
+		return -ENOENT;
+	}
+
+	snprintf(path, sizeof(path), "/sys/class/uio/%s/maps/map0/addr", de->d_name);
+	if (read_sys_hex(path, &rmem->address) < 0) {
+		closedir(dir);
+		fprintf(stderr, "[RMTFS] cannot read %s\n", path);
+		return -EINVAL;
+	}
+	snprintf(path, sizeof(path), "/sys/class/uio/%s/maps/map0/size", de->d_name);
+	if (read_sys_hex(path, &rmem->size) < 0 || !rmem->size) {
+		closedir(dir);
+		fprintf(stderr, "[RMTFS] cannot read %s\n", path);
+		return -EINVAL;
+	}
+	snprintf(path, sizeof(path), "/dev/%s", de->d_name);
+	closedir(dir);
+
+	fd = open(path, O_RDWR | O_CLOEXEC);
+	if (fd < 0) {
+		fprintf(stderr, "[RMTFS] failed to open %s: %s\n", path, strerror(errno));
+		return -errno;
+	}
+	if (fstat(fd, &sb) < 0 || !S_ISCHR(sb.st_mode)) {
+		fprintf(stderr, "[RMTFS] %s is not a character device: refusing\n", path);
+		close(fd);
+		return -EINVAL;
+	}
+	rmem->fd = fd;
+	rmem->base = mmap(0, rmem->size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
+	if (rmem->base == MAP_FAILED) {
+		fprintf(stderr, "[RMTFS] failed to mmap %s: %s\n", path, strerror(errno));
+		rmem->base = NULL;
+		close(fd);
+		return -EINVAL;
+	}
+	printf("[RMTFS] shared memory: %s (uio name rmtfs) phys 0x%" PRIx64 " size 0x%" PRIx64 "\n",
+	       path, rmem->address, rmem->size);
+	return 0;
+}
