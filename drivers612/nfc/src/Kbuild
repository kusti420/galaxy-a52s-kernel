# a52sxq NFC (Samsung S.LSI S3NRN4V, "sec-nfc" on I2C) for the Qualcomm 6.12 BSP.
# Copied into src/ by port.sh. Mirrors the phone's 5.4 drivers/nfc/Makefile with the a52sxq
# defconfig switches (arch/arm64/configs/vendor/lineage-a52sxq_defconfig):
#   CONFIG_SAMSUNG_NFC=m  CONFIG_SEC_NFC=y  CONFIG_SEC_NFC_LOGGER=y
#   CONFIG_SEC_NFC_DUPLICATED_IRQ_WQ_QC=y  CONFIG_SEC_NFC_WAKELOCK_METHOD=0
#   off: ESE_P3_LSI, ESE_SECURE, ESE_USE_TZ_API, NFC_PVDD_LATE_ENABLE, SEC_NFC_COMPAT_IOCTL,
#        SEC_NFC_DUPLICATED_IRQ_WQ_LSI, SEC_NFC_LOGGER_ADD_ACPM_LOG, NFC_PN547, ESE_COLDRESET
# An external tree has no Kconfig, so the switches are passed as -D. The 5.4 Makefile's
# -DENABLE_ESE_SPI_SECURED is left out: only pn547.c reads it, and pn547 is not built.
# CONFIG_BATTERY_SAMSUNG is deliberately NOT defined (see README: lpcharge).
#
# One module, as on 5.4 (vendor modules.load line "nfc_sec.ko"):
#   nfc_sec.ko = sec_nfc.o + nfc_logger/nfc_logger.o  (i2c driver "sec-nfc", /dev/sec-nfc,
#                /proc/nfclog, /sys/class/nfc_sec, /sys/class/nfc_test)

ccflags-y := -Wformat \
	-DCONFIG_SAMSUNG_NFC_MODULE=1 \
	-DCONFIG_SEC_NFC=1 \
	-DCONFIG_SEC_NFC_LOGGER=1 \
	-DCONFIG_SEC_NFC_DUPLICATED_IRQ_WQ_QC=1 \
	-DCONFIG_SEC_NFC_WAKELOCK_METHOD=0

obj-m += nfc_sec.o
nfc_sec-y := sec_nfc.o nfc_logger/nfc_logger.o
