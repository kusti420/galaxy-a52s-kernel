+	 * relied on the composer setting the dim layer property in every
+	 * commit; set it ourselves whenever the FOD dim layer is shown (its
+	 * alpha follows the backlight) and on the commit that removes it, so a
+	 * removed FOD dim layer can never stay on the mixer.
+	 */
+	if (cstate->fod_dim_layer || (old_cstate && old_cstate->fod_dim_layer))
+		set_bit(SDE_CRTC_DIRTY_DIM_LAYERS, cstate->dirty);
+
+	if (!cstate->fod_dim_layer)
+		return;
+
+	for (plane_idx = 0; plane_idx < cnt; plane_idx++)
+		if (pstates[plane_idx].stage >= dim_layer_stage)
+			pstates[plane_idx].stage++;
+}
