+				tc_cfg.start_pos, tc_cfg.sync_threshold_start,
+				is_running_vrr(vdd), ss_is_panel_lpm(vdd), lp_commit, vdd->check_early_te);
+
+			SDE_EVT32_PICK(0xAAAA, is_running_vrr(vdd), tc_cfg.start_pos, tc_cfg.sync_threshold_start);
