+exit:
+	if (update) {
+		SDE_ATRACE_BEGIN((update == 0x1111) ? "start_change" : "start_restore");
+
+		if (phys->has_intf_te && phys->hw_intf->ops.update_start)
+			phys->hw_intf->ops.update_start(phys->hw_intf, &tc_cfg);
+		else if (phys->hw_pp->ops.update_start)
