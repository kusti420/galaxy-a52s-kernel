+ * into the "fod" plane property. While such a plane is staged, a full-screen
+ * black dim layer (alpha from dsi_panel_get_fod_dim_alpha) is staged right
+ * below it and every plane at or above its stage moves up one stage.
+ * The Samsung finger mask (HBM) is switched from the committed state in
+ * sde_connector_pre_kickoff(), not here (atomic_check also runs for
+ * TEST_ONLY commits, which must not touch the panel state).
+ */
+static struct dsi_display *_sde_crtc_fod_get_display(struct sde_crtc_state *cstate)
+{
+	struct sde_connector *c_conn;
+	int i;
+
+	for (i = 0; i < cstate->num_connectors; i++) {
+		if (!cstate->connectors[i] ||
+		    cstate->connectors[i]->connector_type != DRM_MODE_CONNECTOR_DSI)
+			continue;
+		c_conn = to_sde_connector(cstate->connectors[i]);
+		if (c_conn->display)
+			return (struct dsi_display *)c_conn->display;
+	}
+
+	return NULL;
+}
+
+static struct sde_hw_dim_layer *
+sde_crtc_setup_fod_dim_layer(struct sde_crtc_state *cstate, uint32_t stage)
+{
+	struct drm_crtc_state *crtc_state = &cstate->base;
+	struct drm_display_mode *mode = &crtc_state->adjusted_mode;
+	struct sde_hw_dim_layer *dim_layer = NULL;
+	struct dsi_display *display;
+	struct sde_kms *kms;
+	uint32_t alpha;
+	uint32_t layer_stage;
+
+	kms = _sde_crtc_get_kms(crtc_state->crtc);
+	if (!kms || !kms->catalog) {
+		SDE_ERROR("Invalid kms\n");
+		goto error;
+	}
+
+	if (!test_bit(SDE_FEATURE_BASE_LAYER, kms->catalog->features))
+		layer_stage = SDE_STAGE_0 + stage;	/* = 5.4 (no base layer) */
+	else
+		layer_stage = stage;
+	if (layer_stage >= kms->catalog->mixer[0].sblk->maxblendstages) {
+		SDE_ERROR("Stage too large %u vs max %u\n", layer_stage,
+			  kms->catalog->mixer[0].sblk->maxblendstages);
+		goto error;
+	}
+
+	if (cstate->num_dim_layers == SDE_MAX_DIM_LAYERS) {
+		SDE_ERROR("Max dim layers reached\n");
+		goto error;
+	}
+
+	display = _sde_crtc_fod_get_display(cstate);
+	if (!display || !display->panel) {
+		SDE_ERROR("Invalid primary display\n");
+		goto error;
+	}
+
+	/* 5.4 held panel_lock around this u32 read; READ_ONCE in the helper instead */
+	alpha = dsi_panel_get_fod_dim_alpha(display->panel);
+
+	dim_layer = &cstate->fod_dim_layer_cfg;
+	dim_layer->flags = SDE_DRM_DIM_LAYER_INCLUSIVE;
+	dim_layer->stage = layer_stage;
+	dim_layer->rect.x = 0;
+	dim_layer->rect.y = 0;
+	dim_layer->rect.w = mode->hdisplay;
+	dim_layer->rect.h = mode->vdisplay;
+	dim_layer->color_fill.color_0 = 0;
+	dim_layer->color_fill.color_1 = 0;
+	dim_layer->color_fill.color_2 = 0;
+	dim_layer->color_fill.color_3 = alpha;
+
+error:
+	return dim_layer;
+}
+
+static void
+sde_crtc_fod_atomic_check(struct drm_crtc *crtc, struct sde_crtc_state *cstate,
+			  struct plane_state *pstates, int cnt)
+{
+	struct sde_crtc_state *old_cstate = crtc->state ?
+			to_sde_crtc_state(crtc->state) : NULL;
+	uint32_t dim_layer_stage = 0;
+	int plane_idx;
+
+	for (plane_idx = 0; plane_idx < cnt; plane_idx++)
+		if (sde_plane_is_fod_layer(pstates[plane_idx].drm_pstate))
+			break;
+
+	if (plane_idx == cnt) {
+		cstate->fod_dim_layer = NULL;
+	} else {
+		dim_layer_stage = pstates[plane_idx].stage;
+		cstate->fod_dim_layer = sde_crtc_setup_fod_dim_layer(cstate,
+							     dim_layer_stage);
+	}
+
+	/*
+	 * The mixer only (re)programs dim layers when this bit is set. 5.4
+	 * relied on the composer setting the dim layer property in every
+	 * commit; set it ourselves whenever the FOD dim layer is shown (its
+	 * alpha follows the backlight) and on the commit that removes it, so a
+	 * removed FOD dim layer can never stay on the mixer.
+	 */
+	if (cstate->fod_dim_layer || (old_cstate && old_cstate->fod_dim_layer))
+		set_bit(SDE_CRTC_DIRTY_DIM_LAYERS, cstate->dirty);
+
+	if (!cstate->fod_dim_layer)
+		return;
+
+	for (plane_idx = 0; plane_idx < cnt; plane_idx++)
+		if (pstates[plane_idx].stage >= dim_layer_stage)
+			pstates[plane_idx].stage++;
+}
+#endif
