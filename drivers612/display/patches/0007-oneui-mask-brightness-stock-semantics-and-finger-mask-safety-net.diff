+					!(READ_ONCE(ichthys_mask_by_sysfs) && time_before(jiffies,
+						READ_ONCE(ichthys_mask_sysfs_deadline)))) {
+				if (++ichthys_mask_orphan_frames >= ICHTHYS_MASK_ORPHAN_FRAMES) {
+					ichthys_mask_orphan_frames = 0;
+					_sde_connector_finger_mask_force_off(vdd, false,
+						"no fod layer, property 0, no live sysfs request");
+				}
+			} else {
+				ichthys_mask_orphan_frames = 0;
+			}
 		}
 	}
 #endif
