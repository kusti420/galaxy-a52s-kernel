 }
+
+/*
+ * a52sxq finger mask safety net (2026-11-22, stuck 547 nit HBM under OneUI).
+ * The mask may only stay on while something holds it: the FOD dim layer, a non-zero
+ * "fingerprint_mask" property, or a mask_brightness request that is younger than
+ * ICHTHYS_MASK_SYSFS_HOLD_MS. Anything else is dropped after ICHTHYS_MASK_ORPHAN_FRAMES
+ * kickoffs, and a sysfs-held mask also by a timer (a static screen has no kickoff).
+ * One panel with an optical sensor per device: file statics, so no struct layout changes.
+ */
+#define ICHTHYS_MASK_SYSFS_HOLD_MS	10000
+#define ICHTHYS_MASK_ORPHAN_FRAMES	3
+static struct samsung_display_driver_data *ichthys_mask_wd_vdd;
+static bool ichthys_mask_by_sysfs;
+static unsigned long ichthys_mask_sysfs_deadline;
+static unsigned int ichthys_mask_orphan_frames;
+
+/* returns true if the mask was on and has been switched off */
+static bool _sde_connector_finger_mask_force_off(struct samsung_display_driver_data *vdd,
+		bool sysfs_only, const char *why)
+{
+	bool dropped = false;
+
+	mutex_lock(&vdd->vrr.vrr_lock);
+	if (vdd->finger_mask && (!sysfs_only || READ_ONCE(ichthys_mask_by_sysfs))) {
+		SDE_ERROR("[FINGER_MASK] safety net: mask on with no holder (%s), forcing off\n", why);
+		vdd->br_info.common_br.finger_mask_bl_level = 0;
+		vdd->finger_mask_updated = true;
+		vdd->finger_mask = 0;
+		ss_send_hbm_fingermask_image_tx(vdd, 0);
+		vdd->finger_mask_updated = false;
+		WRITE_ONCE(ichthys_mask_by_sysfs, false);
+		dropped = true;
+	}
+	mutex_unlock(&vdd->vrr.vrr_lock);
+	return dropped;
+}
+
+static void _sde_connector_finger_mask_wd_fn(struct work_struct *work)
+{
+	struct samsung_display_driver_data *vdd = READ_ONCE(ichthys_mask_wd_vdd);
+
+	if (!vdd)
+		return;
+	if (READ_ONCE(ichthys_mask_by_sysfs) &&
+			time_before(jiffies, READ_ONCE(ichthys_mask_sysfs_deadline)))
+		return;	/* re-armed by a newer request, its own work is queued */
+	_sde_connector_finger_mask_force_off(vdd, true, "mask_brightness request timed out");
+}
+static DECLARE_DELAYED_WORK(ichthys_mask_wd, _sde_connector_finger_mask_wd_fn);
 #endif
 
