+/*
+ * a52sxq port to the S23 (sm8550) framework: cell_id_dsi, octa_id_dsi and ddi_id_dsi are no
+ * longer fixed arrays of raw bytes inside vdd. They are heap strings holding exactly the text
+ * that /sys/class/lcd/panel/{cell_id,octa_id,SVC_OCTA*} print (the 5.4 sysfs code did this
+ * formatting; in the S23 framework the panel driver does). MAX_* are the 5.4 sizes.
+ */
+#define MAX_CELL_ID 16
+#define MAX_OCTA_ID 20
+static void ss_fc3_set_id_string(struct samsung_display_driver_data *vdd,
+		u8 **dst, int *dst_len, const char *text)
+{
+	int len = strlen(text) + 1;
+
+	kfree(*dst);
+	*dst = kzalloc(len, GFP_KERNEL);
+	if (!*dst) {
+		*dst_len = 0;
+		LCD_ERR(vdd, "fail to kzalloc for id string\n");
+		return;
+	}
+	memcpy(*dst, text, len);
+	*dst_len = len;
+}
