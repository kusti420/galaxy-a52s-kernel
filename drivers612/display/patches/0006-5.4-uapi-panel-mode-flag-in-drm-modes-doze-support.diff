+/*
+ * a52sxq: 5.4 UAPI compatibility (see a52_drm_ioctl() in msm_drv.c): is this DSI connector's
+ * panel a command-mode panel? 1 = command, 0 = video, -1 = not a DSI panel / unknown.
+ */
+int a52_dsi_conn_panel_cmd_mode(struct drm_connector *connector)
+{
+	struct sde_connector *c_conn;
+	struct dsi_display *display;
+
+	if (!connector || connector->connector_type != DRM_MODE_CONNECTOR_DSI)
+		return -1;
+	c_conn = to_sde_connector(connector);
+	display = c_conn->display;
+	if (!display || !display->panel)
+		return -1;
+	return display->panel->panel_mode == DSI_OP_CMD_MODE ? 1 : 0;
+}
diff --color -ruN a/msm/msm_drv.c b/msm/msm_drv.c
--- a/msm/msm_drv.c	2026-11-19 19:15:57.496387179 +0200
+++ b/msm/msm_drv.c	2026-11-19 19:15:57.498184945 +0200
@@ -1906,6 +1906,146 @@
 			DRM_UNLOCKED),
