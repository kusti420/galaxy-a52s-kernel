+ * a52sxq: the phone's composer/QDCM blobs are built against the 5.4 UAPI, where
+ * struct drm_msm_sixzone ends after curve[] (kernel_a52sxq_bone msm_drm_pp.h). r7 appended
+ * sat_adjust_p0/p1 and curve_p2[]; the 5.4 struct is a strict prefix.
+ */
+struct drm_msm_sixzone_v54 {
+	__u64 flags;
+	__u32 threshold;
+	__u32 adjust_p0;
+	__u32 adjust_p1;
+	__u32 sat_hold;
+	__u32 val_hold;
+	struct drm_msm_sixzone_curve curve[SIXZONE_LUT_SIZE];
+};
+static_assert(offsetofend(struct drm_msm_sixzone_v54, curve) ==
+		offsetof(struct drm_msm_sixzone, sat_adjust_p0));
