--- /dev/null	2026-11-11 17:32:01.900323637 +0200
+++ b/config/gki_a52sxq.conf	2026-11-11 20:39:21.502602310 +0200
@@ -0,0 +1,28 @@
+# SPDX-License-Identifier: GPL-2.0-only
+# Samsung Galaxy A52s 5G (a52sxq, yupik) on the 6.12 BSP.
+# Values = the phone's 5.4 defconfig (lineage-a52sxq_defconfig: IDLE_TIMEOUT 80, CONTEXT_DEBUG,
+# IOCOHERENCY_DEFAULT, msm-adreno-tz) plus SORT_POOL (5.4 default y).
+# Memory allocator: the 5.4 kernel has only the page pools (no shmem, no process reclaim), and the
+# phone's DT carries qcom,gpu-mempools. KGSL_RECLAIM=y switches to Qualcomm's 6.12 lahaina choice
+# (config/lahaina_perf_gpuconf: shmem + process reclaim, no pools).
+
+CONFIG_QCOM_KGSL_IDLE_TIMEOUT = 80
+CONFIG_QCOM_KGSL_SORT_POOL = y
+CONFIG_QCOM_KGSL_CONTEXT_DEBUG = y
+CONFIG_QCOM_KGSL_IOCOHERENCY_DEFAULT = y
+CONFIG_QCOM_ADRENO_DEFAULT_GOVERNOR = \"msm-adreno-tz\"
+
+ccflags-y += -DCONFIG_QCOM_KGSL_IDLE_TIMEOUT=80 \
+		-DCONFIG_QCOM_KGSL_SORT_POOL=1 \
+		-DCONFIG_QCOM_KGSL_CONTEXT_DEBUG=1 \
+		-DCONFIG_QCOM_KGSL_IOCOHERENCY_DEFAULT=1 \
+		-DCONFIG_QCOM_ADRENO_DEFAULT_GOVERNOR=\"msm-adreno-tz\"
+
+ifeq ($(KGSL_RECLAIM), y)
+CONFIG_QCOM_KGSL_USE_SHMEM = y
+CONFIG_QCOM_KGSL_PROCESS_RECLAIM = y
+ccflags-y += -DCONFIG_QCOM_KGSL_USE_SHMEM=1 -DCONFIG_QCOM_KGSL_PROCESS_RECLAIM=1
+else
+CONFIG_QCOM_KGSL_POOL = y
+ccflags-y += -DCONFIG_QCOM_KGSL_POOL=1
+endif
