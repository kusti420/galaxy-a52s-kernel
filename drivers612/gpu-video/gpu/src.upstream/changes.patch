 void kgsl_context_destroy_deferred(struct kref *kref);
+/**
+ * kgsl_copy_from_user_compat54 - copy a variable-size user struct the way the 5.4 driver did
+ * @dest: kernel struct (zero-filled first)
+ * @ksize: sizeof the kernel struct
+ * @src: user pointer
+ * @usize: size the caller says its struct has
+ *
+ * a52sxq: the closed 5.4-era Adreno userspace was written against kgsl_copy_from_user() of the
+ * 5.4 driver: copy min(ksize, usize) bytes and ignore whatever follows. The 6.x driver uses
+ * copy_struct_from_user(), which fails with -E2BIG when usize > ksize and the bytes after ksize
+ * are not zero. Old libgsl is known to pass the size of the whole list as the entry size for
+ * cmdlist/memlist/synclist (the "extra" bytes are the next entry), so every multi-entry
+ * IOCTL_KGSL_GPU_COMMAND would fail. Keep the 5.4 contract for every call site that used
+ * kgsl_copy_from_user() in 5.4. As in 5.4, a zero size is -EINVAL.
+ */
+static inline int kgsl_copy_from_user_compat54(void *dest, size_t ksize,
+		const void __user *src, size_t usize)
+{
+	size_t copy = min(ksize, usize);
+
+	if (!copy)
+		return -EINVAL;
+
+	memset(dest, 0, ksize);
+
+	return copy_from_user(dest, src, copy) ? -EFAULT : 0;
+}
+
 #endif /* __KGSL_H */
