diff --color -urN -x '*.o' -x '.*' -x Makefile $ANDROID_TREE/kernel/samsung/sm7325/techpack/video/msm/vidc/vidc_612.c msm/vidc/vidc_612.c
--- $ANDROID_TREE/kernel/samsung/sm7325/techpack/video/msm/vidc/vidc_612.c	1970-01-01 03:00:00.000000000 +0300
+++ msm/vidc/vidc_612.c	2026-11-11 20:38:31.224359020 +0200
@@ -0,0 +1,85 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * See vidc_612.h.
+ */
+#include <linux/err.h>
+#include <linux/firmware.h>
+#include <linux/io.h>
+#include <linux/of.h>
+#include <linux/of_reserved_mem.h>
+#include <linux/slab.h>
+#include <linux/soc/qcom/mdt_loader.h>
+
+#include "vidc_612.h"
+
+struct vidc_fw {
+	struct device *dev;
+	void *va;
+	size_t size;
+};
+
+void *vidc_fw_load(struct device *dev, const char *fw_name)
+{
+	struct device_node *np;
+	struct reserved_mem *rmem;
+	const struct firmware *fw;
+	struct vidc_fw *vfw;
+	char path[64];
+	phys_addr_t reloc;
+	int ret;
+
+	np = of_parse_phandle(dev->of_node, "memory-region", 0);
+	rmem = np ? of_reserved_mem_lookup(np) : NULL;
+	of_node_put(np);
+	if (!rmem) {
+		dev_err(dev, "no memory-region for the venus firmware\n");
+		return ERR_PTR(-EINVAL);
+	}
+
+	vfw = kzalloc(sizeof(*vfw), GFP_KERNEL);
+	if (!vfw)
+		return ERR_PTR(-ENOMEM);
+	vfw->dev = dev;
+	vfw->size = rmem->size;
+	vfw->va = memremap(rmem->base, rmem->size, MEMREMAP_WC);
+	if (!vfw->va) {
+		ret = -ENOMEM;
+		goto free;
+	}
+
+	snprintf(path, sizeof(path), "%s.mdt", fw_name);
+	ret = request_firmware(&fw, path, dev);
+	if (ret)
+		goto unmap;
+	ret = qcom_mdt_load(dev, fw, path, VIDC_PAS_ID, vfw->va, rmem->base,
+			    rmem->size, &reloc);
+	release_firmware(fw);
+	if (ret) {
+		dev_err(dev, "loading %s failed: %d\n", path, ret);
+		goto unmap;
+	}
+	ret = qcom_scm_pas_auth_and_reset(VIDC_PAS_ID);
+	if (ret) {
+		dev_err(dev, "booting venus failed: %d\n", ret);
+		goto unmap;
+	}
+	dev_info(dev, "venus up from %s\n", path);
+	return vfw;
+
+unmap:
+	memunmap(vfw->va);
+free:
+	kfree(vfw);
+	return ERR_PTR(ret);
+}
+
+void vidc_fw_unload(void *cookie)
+{
+	struct vidc_fw *vfw = cookie;
+
+	if (IS_ERR_OR_NULL(vfw))
+		return;
+	qcom_scm_pas_shutdown(VIDC_PAS_ID);
+	memunmap(vfw->va);
+	kfree(vfw);
+}
diff --color -urN -x '*.o' -x '.*' -x Makefile $ANDROID_TREE/kernel/samsung/sm7325/techpack/video/msm/vidc/vidc_612.h msm/vidc/vidc_612.h
--- $ANDROID_TREE/kernel/samsung/sm7325/techpack/video/msm/vidc/vidc_612.h	1970-01-01 03:00:00.000000000 +0300
+++ msm/vidc/vidc_612.h	2026-11-11 20:38:31.224359020 +0200
@@ -0,0 +1,49 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * What the lahaina msm_vidc needs on 6.12 that 5.4 had elsewhere: venus
+ * booted with the MDT loader and PAS instead of PIL, the DDR type from the
+ * device tree, and the msm SCM calls through their mainline versions.
+ * Buffers come straight from the qcom DMA-BUF heaps (msm_smem.c).
+ */
+#ifndef VIDC_612_H
+#define VIDC_612_H
+
+#include <linux/device.h>
+#include <linux/dma-buf.h>
+#include <linux/firmware/qcom/qcom_scm.h>
+#include <soc/qcom/of_common.h>
+
+/* LPDDR4X (7) when the device tree doesn't say */
+static inline int vidc_ddr_type(void)
+{
+	int type = of_fdt_get_ddrtype();
+
+	return type > 0 ? type : 0x7;
+}
+
+/*
+ * DMA_ATTR_DELAYED_UNMAP keeps one IOVA per buffer for the buffer's life,
+ * as 5.4's lazy mapping did. The driver relies on it: venus names reference
+ * frames by device address, and the release-buffer-reference handling finds
+ * the buffer by that address. Without it every queue maps the buffer at a
+ * new address, references are never released and playback starves.
+ */
+#include <linux/qcom-dma-mapping.h>
+#ifndef DMA_ATTR_IOMMU_USE_UPSTREAM_HINT
+#define DMA_ATTR_IOMMU_USE_UPSTREAM_HINT 0
+#endif
+
+/* the venus PAS id */
+#define VIDC_PAS_ID	9
+
+void *vidc_fw_load(struct device *dev, const char *fw_name);
+void vidc_fw_unload(void *cookie);
+
+static inline int qcom_scm_mem_protect_video(u32 cp_start, u32 cp_size,
+					     u32 cp_nonpixel_start, u32 cp_nonpixel_size)
+{
+	return qcom_scm_mem_protect_video_var(cp_start, cp_size,
+					      cp_nonpixel_start, cp_nonpixel_size);
+}
+
+#endif
