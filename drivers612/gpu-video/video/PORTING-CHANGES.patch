+	switch (cmd) {
+	case MSM_VIDIOC_QBUF32:
+	case MSM_VIDIOC_QBUF32_TIME32:
+		rc = msm_v4l2_compat_words(inst, cmd, (void __user *)arg, false);
+		if (rc)
