+		return video_ioctl2(filp, cmd, arg);
+	case MSM_VIDIOC_DQBUF32:
+	case MSM_VIDIOC_DQBUF32_TIME32:
+		rc = video_ioctl2(filp, cmd, arg);
+		if (rc)
+			return rc;
+		return msm_v4l2_compat_words(inst, cmd, (void __user *)arg, true);
+	default:
+		return video_ioctl2(filp, cmd, arg);
+	}
+}
