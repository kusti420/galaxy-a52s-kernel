+static long msm_v4l2_compat_ioctl(struct file *filp, unsigned int cmd,
+		unsigned long arg)
+{
+	struct msm_vidc_inst *inst = get_vidc_inst(filp, NULL);
+	long rc;
+
+	if (!inst->compat_reserved)
+		return video_ioctl2(filp, cmd, arg);
