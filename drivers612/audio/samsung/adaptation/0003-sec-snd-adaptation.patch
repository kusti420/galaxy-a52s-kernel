+			return;
+		}
+		memcpy(&this_afe.volume_monitor_data, &payload[5],
+			sizeof(this_afe.volume_monitor_data));
+		break;
+	default:
+		pr_err("%s: Unrecognized command %d\n", __func__, opcode);
+		return;
+	}
+
+	atomic_set(&this_afe.state, 0);
+}
