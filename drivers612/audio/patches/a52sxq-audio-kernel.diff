+int tas256x_interrupt_read(struct tas256x_priv *p_tas256x,
+	int *intr1, int *intr2, int ch)
+{
+	int n_result = 0;
+
+	n_result = p_tas256x->read(p_tas256x, ch,
+		TAS256X_LATCHEDINTERRUPTREG0, intr1);
+	n_result |= p_tas256x->read(p_tas256x, ch,
+		TAS256X_LATCHEDINTERRUPTREG1, intr2);
+
+	return n_result;
+}
