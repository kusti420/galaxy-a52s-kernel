+static ssize_t calibration_show(struct device *dev,
+					struct device_attribute *attr,
+					char *buf)
+{
+	/*Enough to check for only one channel*/
+	return snprintf(buf, MAX_STRING, "%s\n",
+			(calibration_status) ? "Enabled" : "Disabled");
+}
