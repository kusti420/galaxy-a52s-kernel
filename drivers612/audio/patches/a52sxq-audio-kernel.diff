+static int sec_voice_voice_isolation_cmd(struct voice_data *v, int mode)
+{
+	struct cvp_set_voice_isolation_cmd cvp_voice_isolation_cmd;
+	int ret = 0;
+	u16 cvp_handle;
+
+	if (v == NULL) {
+		pr_err("%s: v is NULL\n", __func__);
+		return -EINVAL;
