+	/* fill in the header */
+	cvs_set_loopback_cmd.hdr.hdr_field =
+	APR_HDR_FIELD(APR_MSG_TYPE_SEQ_CMD,
+				APR_HDR_LEN(APR_HDR_SIZE), APR_PKT_VER);
+	cvs_set_loopback_cmd.hdr.pkt_size =
