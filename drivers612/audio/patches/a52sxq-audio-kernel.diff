+	int ret = 0;
+
+	mutex_lock(&p_tas256x->codec_lock);
+
+	dev_dbg(plat_data->dev, "%s\n", __func__);
+	plat_data->runtime_suspend(p_tas256x);
+
+	mutex_unlock(&p_tas256x->codec_lock);
+	return ret;
+}
