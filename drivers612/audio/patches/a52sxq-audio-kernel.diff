+	/*TX Edge Settings*/
+	n_result |= tas256x_tx_set_edge(p_tas256x,
+		p_tas256x->mn_tx_edge, ch);
+	/*TX Offset Settings*/
+	n_result |= tas256x_tx_set_start_slot(p_tas256x,
