-				rc = msm_audio_ion_unmap_kernel(
-							alloc_data->vaddr,
-							handle, cma_mem);
+				/*
+				 * a52sxq: msm_audio_ion_map_kernel() records the kernel mapping in
+				 * alloc_data->vmap (an iosys_map), never in ->vaddr, so the old call
+				 * here always failed (leak) or, once skipped, released a still-mapped
+				 * dma_buf (BUG at dma-buf.c:179, A52s 2026-11-13). Undo the real
