 	return rc;
 }
 
-static int msm_audio_ion_unmap_kernel(void *vaddr, void *handle, bool cma_mem)
+static int __maybe_unused msm_audio_ion_unmap_kernel(void *vaddr, void *handle, bool cma_mem)
 {
 	int rc = 0;
