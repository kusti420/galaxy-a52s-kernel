+				 */
+				rc = 0;
+				if (alloc_data->vmap) {
+					dma_buf_vunmap((struct dma_buf *)handle, alloc_data->vmap);
+					rc = dma_buf_end_cpu_access((struct dma_buf *)handle,
+								    DMA_BIDIRECTIONAL);
+					kfree(alloc_data->vmap);
+					alloc_data->vmap = NULL;
+				}
 			if (rc) {
 				pr_err("%s: Unable to unmap ion mem rc: %d\n",
 				       __func__, rc);
@@ -729,7 +741,18 @@
 		}
 	}
 
-	msm_audio_dma_buf_map(*handle, paddr, (dma_addr_t *) plen, &bufsz);
+	/*
+	 * a52sxq: attach + map the imported dma_buf like 5.4 did (msm_audio_dma_buf_map there is
+	 * msm_audio_ion_dma_buf_map here). The call that was here registered the user's buffer
+	 * as a kernel DMA allocation with shifted arguments: paddr was never filled, and on
+	 * free (audio_cal_release) dma_free_coherent() was called on memory the kernel never
+	 * allocated -> oops in __free_pages (seen on the A52s 2026-11-13 when the audio HAL exited).
+	 */
+	rc = msm_audio_ion_dma_buf_map((struct dma_buf *)*handle, paddr, plen, true);
+	if (rc) {
+		pr_err("%s: dma_buf map failed: %d\n", __func__, rc);
+		goto err_ion_flag;
+	}
 
 	return 0;
 
