+/*
+ * a52sxq: /proc/asound/cardN/state. On 5.4 (CONFIG_AUDIO_QGKI) sound/core
+ * created this entry ("ONLINE\n"/"OFFLINE\n", poll wakes with POLLPRI on a
+ * change) and the vendor HAL's sndmonitor polls it to follow ADSP SSR. The
+ * 6.12 GKI core has no such entry, so the machine driver provides it.
+ */
+#define MSM_CARD_STATE_MAX_LEN 16
+
+static DECLARE_WAIT_QUEUE_HEAD(msm_card_state_wq);
+static atomic_t msm_card_state_changed;
+static bool msm_card_offline;
+
+static ssize_t msm_card_state_read(struct snd_info_entry *entry,
+			void *file_private_data, struct file *file,
+			char __user *buf, size_t count, loff_t pos)
+{
+	char buffer[MSM_CARD_STATE_MAX_LEN];
+	int len;
+
+	len = scnprintf(buffer, sizeof(buffer), "%s\n",
+			READ_ONCE(msm_card_offline) ? "OFFLINE" : "ONLINE");
+	return simple_read_from_buffer(buf, count, &pos, buffer, len);
+}
+
+static __poll_t msm_card_state_poll(struct snd_info_entry *entry,
+			void *file_private_data, struct file *file,
+			poll_table *wait)
+{
+	poll_wait(file, &msm_card_state_wq, wait);
+	if (atomic_xchg(&msm_card_state_changed, 0))
+		return EPOLLIN | EPOLLPRI | EPOLLRDNORM;
+	return 0;
+}
+
+static const struct snd_info_entry_ops msm_card_state_ops = {
+	.read = msm_card_state_read,
+	.poll = msm_card_state_poll,
+};
+
+static void msm_card_state_set(bool offline)
+{
+	WRITE_ONCE(msm_card_offline, offline);
+	atomic_set(&msm_card_state_changed, 1);
+	wake_up_interruptible(&msm_card_state_wq);
+}
+
+static void msm_card_state_proc_init(struct snd_soc_card *card)
+{
+	struct snd_info_entry *entry;
+
+	if (!card->snd_card || !card->snd_card->proc_root)
+		return;
+
+	entry = snd_info_create_card_entry(card->snd_card, "state",
+					   card->snd_card->proc_root);
+	if (!entry)
+		return;
+	entry->size = MSM_CARD_STATE_MAX_LEN;
+	entry->content = SNDRV_INFO_CONTENT_DATA;
+	entry->c.ops = &msm_card_state_ops;
+	if (snd_info_register(entry) < 0)
+		snd_info_free_entry(entry);
+}
