+/* one vote bit per FE dai link and direction (prepare/shutdown run under
+ * card->pcm_mutex) */
+static DECLARE_BITMAP(msm_fe_qos_voted, MSM_FRONTEND_DAI_MAX * 2);
+
+static int msm_fe_qos_bit(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	int id = rtd->dai_link->id;
+
+	if (id < 0 || id >= MSM_FRONTEND_DAI_MAX)
+		return -1;
+	return id * 2 + substream->stream;
+}
