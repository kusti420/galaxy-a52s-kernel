+/* a52sxq (Samsung 5.4 parity, 5.4 dsp/q6afe.c afe_q6_slimbus_update_sbm /
+ * afe_q6_slimbus_update_dyn_bitrate): run-time parameters of the AFE encoder on SLIMBUS_7_RX
+ * (A2DP offload). One helper for both: pack one parameter and send it to the port.
+ */
+static int a52_afe_slim7_enc_param(u32 param_id, void *data, u32 size)
+{
+	struct param_hdr_v3 param_hdr;
+	u8 *packed_param_data;
+	u32 packed_data_size;
+	int index, ret;
+	u16 port_id;
+
+	index = q6audio_get_port_index(SLIMBUS_7_RX);
+	port_id = q6audio_get_port_id(SLIMBUS_7_RX);
+	if (index < 0 || index >= AFE_MAX_PORTS) {
+		pr_err("%s: AFE port index[%d] invalid!\n", __func__, index);
+		return -EINVAL;
+	}
+
+	memset(&param_hdr, 0, sizeof(param_hdr));
+	param_hdr.module_id = AFE_MODULE_ID_ENCODER;
+	param_hdr.instance_id = INSTANCE_ID_0;
+	param_hdr.param_id = param_id;
+	param_hdr.param_size = size;
+
+	packed_data_size = sizeof(union param_hdrs) + size;
+	packed_param_data = kzalloc(packed_data_size, GFP_KERNEL);
+	if (!packed_param_data)
+		return -ENOMEM;
+
+	ret = q6common_pack_pp_params(packed_param_data, &param_hdr, data,
+				      &packed_data_size);
+	if (ret) {
+		pr_err("%s: Failed to pack param header and data, error %d\n",
+		       __func__, ret);
+		goto done;
+	}
+
+	ret = q6afe_set_params(port_id, index, NULL, packed_param_data,
+			       packed_data_size);
+	if (ret) {
+		pr_err("%s: param 0x%x on port 0x%x failed %d\n", __func__,
+		       param_id, port_id, ret);
+		ret = -EINVAL;
+	}
+done:
+	kfree(packed_param_data);
+	return ret;
+}
+
+int afe_q6_slimbus_update_sbm(struct asm_sbm_param_t *sbm_param)
+{
+	if (!sbm_param)
+		return -EINVAL;
+	pr_info("%s: updating mode\n", __func__);
+	return a52_afe_slim7_enc_param(AVS_MEDIA_ID_SBM_ID, sbm_param,
+				       sizeof(*sbm_param));
+}
+EXPORT_SYMBOL(afe_q6_slimbus_update_sbm);
+
+int afe_q6_slimbus_update_dyn_bitrate(uint32_t bitrate)
+{
+	struct asm_bitrate_param_t dyn_bitrate = { .enc_bitrate = bitrate };
+
+	pr_info("%s: bitrate[%u]\n", __func__, bitrate);
+	return a52_afe_slim7_enc_param(AVS_ENCODER_PARAM_ID_ENC_BITRATE,
+				       &dyn_bitrate, sizeof(dyn_bitrate));
+}
+EXPORT_SYMBOL(afe_q6_slimbus_update_dyn_bitrate);
+
