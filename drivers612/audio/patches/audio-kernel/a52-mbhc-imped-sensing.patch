+/* a52sxq: Samsung's headphone impedance -> extra digital gain table (5.4 CONFIG_SND_SOC_IMPED_SENSING) */
+#define MAX_IMPEDANCE_TABLE 8
+
+struct wcd938x_gain_table {
+	uint32_t min;      /* Min impedance */
+	uint32_t max;      /* Max impedance */
