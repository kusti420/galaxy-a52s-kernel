diff --color -ruN a/asoc/codecs/wcd938x/wcd938x.c b/asoc/codecs/wcd938x/wcd938x.c
--- a/asoc/codecs/wcd938x/wcd938x.c	2026-11-21 14:48:37.591435098 +0200
+++ b/asoc/codecs/wcd938x/wcd938x.c	2026-11-21 14:49:45.600276325 +0200
@@ -4352,6 +4352,38 @@
 
 	wcd938x_dt_parse_micbias_info(dev, &pdata->micbias);
 
+	/* a52sxq: Samsung imp-table (DT `imp-table` + `#list-imp-cells`, else Samsung's defaults) */
+	{
+		static const struct wcd938x_gain_table default_table[MAX_IMPEDANCE_TABLE] = {
+			{    0,       0, 6},
+			{    1,      13, 0},
+			{   14,      25, 3},
+			{   26,      42, 4},
+			{   43,     100, 5},
+			{  101,     200, 7},
+			{  201,    1000, 8},
+			{ 1001, INT_MAX, 6},
+		};
+		struct of_phandle_args imp_list;
+		int i, rc;
+
+		for (i = 0; i < ARRAY_SIZE(pdata->imp_table); i++) {
+			rc = of_parse_phandle_with_args(dev->of_node, "imp-table",
+							"#list-imp-cells", i, &imp_list);
+			if (rc < 0 || imp_list.args_count < 3) {
+				pdata->imp_table[i] = default_table[i];
+			} else {
+				pdata->imp_table[i].min = imp_list.args[0];
+				pdata->imp_table[i].max = imp_list.args[1];
+				pdata->imp_table[i].gain = imp_list.args[2];
+				of_node_put(imp_list.np);
+			}
+			dev_info(dev, "impedance gain table %u, %u, %d%s\n",
+				 pdata->imp_table[i].min, pdata->imp_table[i].max,
+				 pdata->imp_table[i].gain, rc < 0 ? " (default)" : "");
+		}
+	}
+
 	return pdata;
 }
 
