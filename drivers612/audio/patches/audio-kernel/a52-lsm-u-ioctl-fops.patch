 	return ret;
 }
 
+void a52_pcm_vendor_ioctl_enable(struct snd_pcm_substream *substream);
+
 static int msm_pcm_hw_params(struct snd_soc_component *component,
 				struct snd_pcm_substream *substream,
 				struct snd_pcm_hw_params *params)
 {
