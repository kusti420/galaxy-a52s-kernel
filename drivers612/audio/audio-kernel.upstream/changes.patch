+/* one vote bit per FE dai link and direction (prepare/shutdown run under
+ * card->pcm_mutex) */
+static DECLARE_BITMAP(msm_fe_qos_voted, MSM_FRONTEND_DAI_MAX * 2);
+
+static int msm_fe_qos_bit(struct snd_pcm_substream *substream)
+{
+	struct snd_soc_pcm_runtime *rtd = substream->private_data;
+	int id = rtd->dai_link->id;
+
+	if (id < 0 || id >= MSM_FRONTEND_DAI_MAX)
+		return -1;
+	return id * 2 + substream->stream;
+}
+
 static int msm_fe_qos_prepare(struct snd_pcm_substream *substream)
 {
+	/* a52sxq: as on 5.4, vote through the per-CPU resume-latency requests that
+	 * msm_audio_add_qos_request() registered at probe. The r70 code removed the
+	 * substream's request and then updated the removed one ("called for unknown
+	 * object" WARN), so low-latency playback never got a latency vote. */
+	int bit = msm_fe_qos_bit(substream);
+
 	if (cpu_latency_qos_request_active(&substream->latency_pm_qos_req))
 		cpu_latency_qos_remove_request(&substream->latency_pm_qos_req);
 
-	qos_client_active_cnt++;
-	if (qos_client_active_cnt == 1)
-		cpu_latency_qos_update_request(&substream->latency_pm_qos_req, MSM_LL_QOS_VALUE);
+	/* a52sxq: .prepare runs on every PREPARE ioctl (each xrun, each
+	 * stop/start) but .shutdown only once per close: count one vote per
+	 * FE stream, not one per call, or the vote sticks forever. */
+	if (bit < 0 || test_and_set_bit(bit, msm_fe_qos_voted))
+		return 0;
+
+	if (++qos_client_active_cnt == 1)
+		msm_audio_update_qos_request(MSM_LL_QOS_VALUE);
 
 	return 0;
 }
 
