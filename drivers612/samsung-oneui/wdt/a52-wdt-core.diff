+/* a52: "enabled" follows what the backend reports; a failed enable = no watchdog (and no bite) until the next resume */
+static void a52_wdt_reenable(u32 val, struct msm_watchdog_data *wdog_data)
+{
+	if (wdog_data->enabled)
+		return;
+	if (wdog_data->ops->enable_wdt(val, wdog_data)) {
+		atomic_inc(&a52_stats.resume_enable_fails);
+		dev_err(wdog_data->dev, "watchdog could not be enabled after resume\n");
+		return;
+	}
+	wdog_data->enabled = true;
+}
