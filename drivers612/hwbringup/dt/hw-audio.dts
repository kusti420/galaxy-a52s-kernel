		disp_rsc: rsc@af20000 {
			label = "disp_rsc";
			compatible = "qcom,rpmh-rsc";
			reg = <0xaf20000 0x10000>;
			reg-names = "drv-0";
			interrupts = <0x00 0x81 0x04>;
			qcom,drv-count = <0x01>;
			phandle = <0x2b9>;

			disp_rsc_drv0: drv@0 {
				qcom,tcs-offset = <0x1c00>;
				qcom,drv-id = <0x00>;
				phandle = <0x2ba>;

				sde_rsc_rpmh {
					cell-index = <0x00>;
					compatible = "qcom,sde-rsc-rpmh";
				};

				channel@0 {
					qcom,tcs-config = <0x02 0x00 0x00 0x01 0x01 0x01 0x03 0x00 0x04 0x00>;
				};

				disp_bcm_voter: bcm_voter {
					compatible = "qcom,bcm-voter";
					qcom,tcs-wait = <0x01>;
					phandle = <0x4f>;
				};
			};
		};

		sram@c3f0000 {
			compatible = "qcom,rpmh-stats";
			reg = <0xc3f0000 0x400>;
			ss-name = "modem", "adsp", "adsp_island", "cdsp", "apss";
		};

		cluster-device {
			compatible = "qcom,lpm-cluster-dev";
			power-domains = <0x24>;
		};

		spmi_bus: qcom,spmi@c440000 {
			compatible = "qcom,spmi-pmic-arb";
			reg = <0xc440000 0x1100 0xc600000 0x2000000 0xe600000 0x100000 0xe700000 0xa0000 0xc40a000 0x26000>;
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
			interrupts-extended = <0x2d 0x01 0x04>;
			interrupt-names = "periph_irq";
			interrupt-controller;
			#interrupt-cells = <0x04>;
			#address-cells = <0x02>;
			#size-cells = <0x00>;
			cell-index = <0x00>;
			qcom,channel = <0x00>;
			qcom,ee = <0x00>;
			phandle = <0x2bb>;

			qcom,pmr735a@4 {
				#size-cells = <0x00>;
				#address-cells = <0x01>;
