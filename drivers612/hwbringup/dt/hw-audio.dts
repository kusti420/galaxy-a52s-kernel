	ddr-regions {
	};

	mem-offline {
		compatible = "qcom,mem-offline";
		offline-sizes = <0x01 0x40000000 0x00 0x40000000 0x01 0xc0000000 0x00 0x80000000 0x02 0xc0000000 0x01 0x40000000>;
		granule = <0x200>;
		qcom,qmp = <0x02>;
		ddr-old-version;
	};

	aliases: aliases {
		swr2 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/tx-macro@3220000/tx_swr_master";
		swr1 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/rx-macro@3200000/rx_swr_master";
		swr0 = "/soc/qcom,msm-audio-apr/qcom,q6core-audio/bolero-cdc/wsa-macro@3240000/wsa_swr_master";
		i2c23 = "/soc/i2c@a80000";
		i2c21 = "/soc/i2c@98c000";
		i2c18 = "/soc/qcom,qupv3_0_geni_se@9c0000/i2c@984000";
		hsuart8 = "/soc/qcom,qup_hsuart@994000";
		ufshc1 = "/soc/ufshc@1d84000";
		mmc0 = "/soc/sdhci@7C4000";
		mmc1 = "/soc/sdhci@8804000";
		serial0 = "/soc/qcom,qupv3_0_geni_se@9c0000/qcom,qup_uart@994000";
		hsuart0 = "/soc/qcom,qupv3_0_geni_se@9c0000/qcom,qup_uart@99c000";
		phandle = <0x272>;
	};

	firmware: firmware {
		phandle = <0x273>;

		android {
			compatible = "android,firmware";

			vbmeta {
				parts = "vbmeta,boot,system,vendor,dtbo,product,odm,prism,optics,vbmeta_system,vendor_boot,recovery,abl,xbl,tz,hyp";
				compatible = "android,vbmeta";
			};
		};

		qcom_scm: qcom_scm {
			compatible = "qcom,scm";
			qcom,dload-mode = <0x03 0x13000>;
			phandle = <0xee>;
		};

		qcom_smcinvoke {
			compatible = "qcom,smcinvoke";
		};

		qcom_mem_object {
			compatible = "qcom,mem-object";
		};

		qtee_shmbridge {
			compatible = "qcom,tee-shared-memory-bridge";
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		CPU0: cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05>;
			power-domains = <0x06>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x07 0x00 0x04>;
			next-level-cache = <0x08>;
			#cooling-cells = <0x02>;
			phandle = <0x1a>;

			L2_0: l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				next-level-cache = <0x09>;
				phandle = <0x08>;

				L3_0: l3-cache {
					compatible = "cache";
					cache-level = <0x03>;
					phandle = <0x09>;
				};
			};
		};

		CPU1: cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05>;
			power-domains = <0x0a>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x07 0x00 0x04>;
			next-level-cache = <0x0b>;
			#cooling-cells = <0x02>;
			phandle = <0x1b>;

			L2_1: l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				next-level-cache = <0x09>;
				phandle = <0x0b>;
			};
		};

		CPU2: cpu@200 {
			device_type = "cpu";
			compatible = "qcom,kryo";
			reg = <0x00 0x200>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05>;
			power-domains = <0x0c>;
			power-domain-names = "psci";
			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x07 0x00 0x04>;
			next-level-cache = <0x0d>;
			#cooling-cells = <0x02>;
			phandle = <0x1c>;

			L2_2: l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				next-level-cache = <0x09>;
				phandle = <0x0d>;
			};
		};

		CPU3: cpu@300 {
