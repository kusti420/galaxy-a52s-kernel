						linux,default-trigger = "timer";
						led-sources = <0x02>;
						pwms = <0x4af 0x02 0xf4240>;
						label = "blue";
					};

					green {
						linux,default-trigger = "timer";
						led-sources = <0x01>;
						pwms = <0x4af 0x01 0xf4240>;
						label = "green";
