			capacity-dmips-mhz = <0x400>;
			dynamic-power-coefficient = <0x64>;
			qcom,freq-domain = <0x07 0x00 0x04>;
			next-level-cache = <0x0f>;
			#cooling-cells = <0x02>;
			phandle = <0x1d>;

			L2_3: l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
