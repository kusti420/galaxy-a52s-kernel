		qcom,pmic_glink_log {
			compatible = "qcom,qti-pmic-glink";
			qcom,pmic-glink-channel = "PMIC_LOGS_ADSP_APPS";

			qcom,battery_debug {
				compatible = "qcom,battery-debug";
			};

			spmi_glink_debug: qcom,spmi_glink_debug {
				compatible = "qcom,spmi-glink-debug";
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				status = "ok";
				phandle = <0x2c0>;

				spmi@0 {
					reg = <0x00>;
					#address-cells = <0x02>;
					#size-cells = <0x00>;

					qcom,pm8350b-debug@3 {
						compatible = "qcom,spmi-pmic";
						reg = <0x03 0x00>;
						qcom,can-sleep;
					};
				};

				spmi@1 {
					reg = <0x01>;
					#address-cells = <0x02>;
					#size-cells = <0x00>;

					qcom,smb1394-debug@b {
						compatible = "qcom,spmi-pmic";
						reg = <0x0b 0x00>;
						qcom,can-sleep;
					};

					qcom,smb1394-debug@c {
						compatible = "qcom,spmi-pmic";
						reg = <0x0c 0x00>;
						qcom,can-sleep;
					};
				};
			};
		};

