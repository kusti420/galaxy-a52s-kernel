/dts-v1/;

/ {
	model = "Qualcomm Technologies, Inc. Yupik SoC";
	compatible = "qcom,yupik";
	qcom,msm-id = <0x1db 0x10000 0x203 0x10000>;
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	qcom,board-id = <0x00 0x00>;

	sec_debug_partition {
		part-table = <0x00 0x1000 0x1000 0x1000 0x2000 0x1000 0x3000 0x1000 0x4000 0xa000 0xe000 0x1000 0xf000 0x80000 0x8f000 0x1000 0x90000 0x3000 0x93000 0x1000 0x94000 0x1000 0x95000 0x1000 0xfe000 0x2000 0x100000 0x200000 0x300000 0x200000 0x500000 0x300000>;
	};

	chosen: chosen {
		bootargs = "loglevel=6 log_buf_len=512K rcupdate.rcu_expedited=1 printk.console_no_auto_verbose=1 rcu_nocbs=0-7 kpti=0 cpufreq.default_governor=performance pcie_ports=compat fw_devlink.strict=1 android_arch_task_struct_size=512 arm64.nosme sysctl.kernel.sched_pelt_multiplier=4 no-steal-acc swiotlb=0 loop.max_part=7 irqaffinity=0-1 kasan=off cgroup_disable=pressure sysctl.kernel.panic_on_rcu_stall=1 ftrace_dump_on_oops restrict_cma_redirect=false slub_debug=-";
		stdout-path = "/soc/qcom,qupv3_0_geni_se@9c0000/qcom,qup_uart@994000:115200n8";
		phandle = <0x25f>;
	};

	memory {
		device_type = "memory";
		reg = <0x00 0x00 0x00 0x00>;
	};

	reserved_memory: reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		phandle = <0x260>;

		a52_cvp_mem: pil_video_mem: cvp@8b200000 {
			phandle = <0x57d>;
			no-map;
			reg = <0x00 0x8b200000 0x00 0x500000>;
		};

		camera_heap: camera_heap {
			phandle = <0x4f1>;
			ion,recyclable;
			non_gki_size = <0x00 0x1f400000>;
			size = <0x00 0x00>;
			alignment = <0x00 0x2000000>;
			alloc-ranges = <0x01 0x80000000 0x00 0x80000000>;
		};

		dummy_mem: dummy_mem {
			phandle = <0x52d>;
			no-map;
			reg = <0x00 0x9c700000 0x00 0x100000>;
		};

		hdm_region: hdm_region@9FB00000 {
			phandle = <0x52c>;
			reg = <0x00 0x9fb00000 0x00 0x1000>;
			no-map;
			compatible = "removed-dma-pool";
		};

		modem_shared_mem: modem_shared_mem_region@d0000000 {
			phandle = <0x4cf>;
			non_gki_size = <0x00 0x6000000>;
			reg = <0x00 0xd0000000 0x00 0x800000>;
			no-map;
			compatible = "modem-removed-dma-pool";
		};

		tima_mem: tima_region@B0100000 {
			phandle = <0x52b>;
			reg = <0x00 0xb0100000 0x00 0x100000>;
			no-map;
			compatible = "removed-dma-pool";
		};

		kaslr_region: kaslr_region@A0001000 {
			phandle = <0x52a>;
			reg = <0x00 0xa0001000 0x00 0x1000>;
			no-map;
			compatible = "removed-dma-pool";
		};

		ramoops@F0B00000 {
			pmsg-size = <0x40000>;
			ftrace-size = <0x40000>;
			console-size = <0x40000>;
			record-size = <0x20000>;
			reg = <0x00 0xf0b00000 0x00 0xe0000>;
			compatible = "ramoops";
		};

		ss_plog@1B0900000 {
			reg = <0x00 0xf0900000 0x00 0x200000>;
			no-map;
			compatible = "ss_plog";
		};

		sec_debug_rdx_bootdev: sec_debug_rdx_bootdev@0 {
			phandle = <0x529>;
			non_gki_size = <0x00 0xad00000>;
			size = <0x00 0x00>;
			alloc-ranges = <0x01 0x00 0x00 0xad00000>;
		};

		sec_debug_region: sec_debug_region@F0000000 {
			phandle = <0x528>;
			reg = <0x00 0xf0000000 0x00 0x900000>;
			no-map;
			compatible = "removed-dma-pool";
		};

		hyp_mem: hyp@80000000 {
			no-map;
			reg = <0x00 0x80000000 0x00 0x600000>;
			phandle = <0x261>;
		};

		xbl_aop_mem: xbl_aop_mem@80700000 {
			no-map;
			reg = <0x00 0x80700000 0x00 0x160000>;
			phandle = <0x262>;
		};

		cmd_db: cmd_db@80860000 {
			compatible = "qcom,cmd-db";
			no-map;
			reg = <0x00 0x80860000 0x00 0x20000>;
			phandle = <0x263>;
		};

		reserved_xbl_uefi: reserved_xbl_uefi@80880000 {
			no-map;
			reg = <0x00 0x80880000 0x00 0x14000>;
			phandle = <0x264>;
		};

		secdata_apss_mem: secdata_apss@808ff000 {
			no-map;
			reg = <0x00 0x808ff000 0x00 0x1000>;
			phandle = <0x265>;
		};

		smem_mem: smem@80900000 {
			no-map;
			reg = <0x00 0x80900000 0x00 0x200000>;
			phandle = <0xab>;
		};

		fw_mem: fw@80b00000 {
			no-map;
			reg = <0x00 0x80b00000 0x00 0x100000>;
			phandle = <0x266>;
		};

		wlan_fw_mem: wlan_fw@80c00000 {
			no-map;
			reg = <0x00 0x80c00000 0x00 0xc00000>;
			phandle = <0x267>;
		};

		cdsp_secure_heap_mem: cdsp_secure_heap@81800000 {
			status = "disabled";
			no-map;
			reg = <0x00 0x81800000 0x00 0x1e00000>;
			phandle = <0xef>;
		};

		pil_cvp_mem: camera@86200000 {
			status = "disabled";
			no-map;
			reg = <0x00 0x86200000 0x00 0x500000>;
			phandle = <0x268>;
		};

		pil_adsp_mem: adsp@86700000 {
			no-map;
			reg = <0x00 0x84700000 0x00 0x4800000>;
			phandle = <0xbf>;
		};

		pil_cdsp_mem: cdsp@88f00000 {
			no-map;
			reg = <0x00 0x88f00000 0x00 0x1e00000>;
			phandle = <0xc2>;
		};

		adsp_mem: adsp_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0xc00000>;
			phandle = <0xc8>;
		};

		pil_camera_mem: video@8ad00000 {
			no-map;
			reg = <0x00 0x8ad00000 0x00 0x500000>;
			phandle = <0x269>;
		};

		pil_ipa_fw_mem: ipa_fw@8b700000 {
			no-map;
			reg = <0x00 0x8b700000 0x00 0x10000>;
			phandle = <0x26a>;
		};

		pil_ipa_gsi_mem: ipa_gsi@8b710000 {
			no-map;
			reg = <0x00 0x8b710000 0x00 0xa000>;
			phandle = <0x26b>;
		};

		pil_gpu_micro_code_mem: gpu_micro_code@8b71a000 {
			no-map;
			reg = <0x00 0x8b71a000 0x00 0x2000>;
			phandle = <0x26c>;
		};

		pil_mpss_mem: mpss@8b800000 {
			no-map;
			reg = <0x00 0x8b800000 0x00 0xf600000>;
			phandle = <0xba>;
		};

		pil_wpss_mem: wlan@9ae00000 {
			no-map;
			reg = <0x00 0x9ae00000 0x00 0x1900000>;
			phandle = <0xb0>;
		};

		removed_mem: removed_region@c0000000 {
			no-map;
			reg = <0x00 0xc0000000 0x00 0x6a00000>;
			phandle = <0x26d>;
		};

		pil_trustedvm_mem: pil_trustedvm_region@d0800000 {
			status = "disabled";
			no-map;
			reg = <0x00 0xd0800000 0x00 0x76f7000>;
			phandle = <0xb5>;
		};

		qrtr_shbuf: qrtr-shmem {
			no-map;
			reg = <0x00 0xd7ef7000 0x00 0x9000>;
			phandle = <0xb8>;
		};

		chan0_shbuf: neuron_block@0 {
			no-map;
			reg = <0x00 0xd7f00000 0x00 0x80000>;
			phandle = <0xb6>;
		};

		chan1_shbuf: neuron_block@1 {
			no-map;
			reg = <0x00 0xd7f80000 0x00 0x80000>;
			phandle = <0xb7>;
		};

		video_mem: video_region@85b00000 {
			status = "disabled";
			no-map;
			reg = <0x00 0x85b00000 0x00 0x700000>;
			phandle = <0x26e>;
		};

		user_contig_mem: user_contig_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x2a>;
		};

		qseecom_mem: qseecom_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1c00000>;
			phandle = <0x28>;
		};

		non_secure_display_memory: non_secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x6400000>;
			phandle = <0xf0>;
		};

		qseecom_ta_mem: qseecom_ta_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1000000>;
			phandle = <0x29>;
		};

		secure_display_memory: secure_display_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x8c00000>;
			phandle = <0xf1>;
		};

		ramoops_mem: ramoops-region {
			alloc-ranges = <0x01 0x00 0xfffffffe 0xffffffff>;
			size = <0x00 0x200000>;
			no-map;
			phandle = <0xc9>;
		};

		system_cma: linux,cma {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x2000000>;
			linux,cma-default;
			phandle = <0xf4>;
		};

		kinfo_mem: debug_kinfo_region {
			alloc-ranges = <0x00 0x00 0xffffffff 0xffffffff>;
			size = <0x00 0x1000>;
			no-map;
			phandle = <0x4b>;
		};

		va_md_mem: va_md_mem_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			size = <0x00 0x1000000>;
			phandle = <0x4c>;
		};

		audio_cma_mem: audio_cma_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1c00000>;
			phandle = <0xf2>;
		};

		splash_memory: splash_region {
			reg = <0x00 0xe1000000 0x00 0x2300000>;
			label = "cont_splash_region";
			phandle = <0x26f>;
		};

		dfps_data_memory: dfps_data_memory {
			reg = <0x00 0xe3300000 0x00 0x100000>;
			label = "dfps_data_memory";
			phandle = <0x270>;
		};

		memshare_mem: memshare_region {
			compatible = "shared-dma-pool";
			no-map;
			alloc-ranges = <0x00 0x00 0x00 0xdfffffff>;
			alignment = <0x00 0x100000>;
			size = <0x00 0x800000>;
			phandle = <0x2e>;
		};

		cnss_wlan_mem: cnss_wlan_region {
			compatible = "shared-dma-pool";
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			reusable;
			alignment = <0x00 0x400000>;
			size = <0x00 0x1400000>;
			phandle = <0x271>;
		};

		dump_mem: dump_mem_region {
			alloc-ranges = <0x00 0x00 0x00 0xffffffff>;
			size = <0x00 0x2c00000>;
			phandle = <0xed>;
		};
