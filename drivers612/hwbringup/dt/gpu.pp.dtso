   };
   qcom,gpu-pwrlevel@5 {
    reg = <5>;
    qcom,gpu-freq = <315000000>;
    qcom,level = <64>;
    qcom,bus-freq-ddr7 = <3>;
    qcom,bus-min-ddr7 = <2>;
    qcom,bus-max-ddr7 = <9>;
    qcom,bus-freq-ddr8 = <3>;
    qcom,bus-min-ddr8 = <2>;
    qcom,bus-max-ddr8 = <7>;
    qcom,acd-level = <0x882F5FFD>;
   };
  };
  qcom,gpu-pwrlevels-1 {
   #address-cells = <1>;
   #size-cells = <0>;
   qcom,speed-bin = <172>;
   qcom,initial-pwrlevel = <5>;
   qcom,gpu-pwrlevel@0 {
    reg = <0>;
    qcom,gpu-freq = <812000000>;
    qcom,level = <320>;
    qcom,bus-freq-ddr7 = <11>;
