   };
   qcom,gpu-pwrlevel@3 {
    reg = <3>;
    qcom,gpu-freq = <550000000>;
    qcom,level = <192>;
    qcom,bus-freq-ddr7 = <9>;
    qcom,bus-min-ddr7 = <8>;
