    qcom,acd-level = <0x882F5FFD>;
   };
  };
  qcom,gpu-pwrlevels-3 {
   #address-cells = <1>;
   #size-cells = <0>;
   qcom,speed-bin = <96>;
   qcom,initial-pwrlevel = <1>;
   qcom,gpu-pwrlevel@0 {
    reg = <0>;
    qcom,gpu-freq = <450000000>;
    qcom,level = <128>;
    qcom,bus-freq-ddr7 = <6>;
    qcom,bus-min-ddr7 = <5>;
    qcom,bus-max-ddr7 = <10>;
    qcom,bus-freq-ddr8 = <6>;
    qcom,bus-min-ddr8 = <6>;
    qcom,bus-max-ddr8 = <8>;
    qcom,acd-level = <0x802B5FFD>;
