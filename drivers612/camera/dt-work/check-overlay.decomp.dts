	fragment@1 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";

			s2mpb03_pmic@56 {
				s2mpb03,wakeup;
				reg = <0x56>;
				compatible = "samsung,s2mpb03pmic";
				phandle = <0x7a>;

				regulators {

					s2mpb03-ldo7 {
						regulator-max-microvolt = <0x2ab980>;
						regulator-min-microvolt = <0x2ab980>;
						regulator-name = "CAM0_s2mpb03-l7";
						phandle = <0x09>;
					};

					s2mpb03-ldo6 {
						regulator-max-microvolt = <0x2c4020>;
						regulator-min-microvolt = <0x2c4020>;
						regulator-name = "CAM0_s2mpb03-l6";
						phandle = <0x1f>;
					};

					s2mpb03-ldo5 {
						regulator-max-microvolt = <0x2ab980>;
						regulator-min-microvolt = <0x2ab980>;
						regulator-name = "CAM0_s2mpb03-l5";
						phandle = <0x0a>;
					};

					s2mpb03-ldo4 {
						regulator-max-microvolt = <0x124f80>;
						regulator-min-microvolt = <0x124f80>;
						regulator-name = "CAM0_s2mpb03-l4";
						phandle = <0x15>;
					};

					s2mpb03-ldo3 {
						regulator-max-microvolt = <0x1b7740>;
						regulator-min-microvolt = <0x1b7740>;
						regulator-name = "CAM0_s2mpb03-l3";
						phandle = <0x0b>;
					};

					s2mpb03-ldo2 {
						regulator-max-microvolt = <0x10c8e0>;
						regulator-min-microvolt = <0x10c8e0>;
						regulator-name = "CAM0_s2mpb03-l2";
						phandle = <0x0c>;
					};

					s2mpb03-ldo1 {
						regulator-max-microvolt = <0x100590>;
						regulator-min-microvolt = <0x100590>;
						regulator-name = "CAM0_s2mpb03-l1";
						phandle = <0x20>;
					};
				};
			};
		};
	};

	fragment@2 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";

			sm5714-fled {
				timeout = <0xff>;
				factory_current = <0x00>;
				torch-brightness = <0x07>;
				preflash-brightness = <0x07>;
				flash-brightness = <0x0f>;
				torch-en-gpio = <0xffffffff 0x61 0x00>;
				flash-en-gpio = <0xffffffff 0x60 0x00>;
				slave-addr = <0x92>;
				status = "disabled";
				reg = <0x49>;
				compatible = "siliconmitus,sm5714-fled";
			};
		};
	};

	fragment@3 {
		target = <0xffffffff>;

		__overlay__ {
			status = "ok";

			qcom,ois@62 {
				status = "ok";
				gpio-req-tbl-label = "MCU_RESET0", "MCU_VANA", "MCU_BOOT0";
				gpio-req-tbl-flags = <0x00 0x00 0x00>;
				gpio-req-tbl-num = <0x00 0x01 0x02>;
				gpio-custom1 = <0x02>;
				gpio-vana = <0x01>;
				gpio-reset = <0x00>;
				gpios = <0xffffffff 0x2d 0x00 0xffffffff 0x0b 0x00 0xffffffff 0x2e 0x00>;
				gpio-no-mux = <0x00>;
				pinctrl-1 = <0x34>;
				pinctrl-0 = <0x35>;
				pinctrl-names = "cam_default", "cam_suspend";
				qcom,cam-power-seq-delay = <0x01 0x01 0x01 0x0a>;
				qcom,cam-power-seq-cfg-val = <0x01 0x01 0x01 0x01>;
				qcom,cam-power-seq-type = "cam_vana", "cam_vaf", "cam_vio", "cam_reset";
				rgltr-load-current = <0x30d40 0x30d40>;
				rgltr-max-voltage = <0x1b7740 0x2ab980>;
				rgltr-min-voltage = <0x1b7740 0x2ab980>;
				rgltr-cntrl-support;
				regulator-names = "cam_vio", "cam_vaf";
				cam_vaf-supply = <0x09>;
				cam_vio-supply = <0xffffffff>;
				gyro-orientation = <0x00>;
				pole-values = <0x00 0x01 0x00 0x00 0x00 0x00>;
				slave-id = <0x456>;
				slave-addr = <0xc4>;
				reg = <0x51>;
				cell-index = <0x00>;
				compatible = "qcom,ois";
				phandle = <0x0e>;
			};
		};
	};

	fragment@4 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,cam_smmu {
				#address-cells = <0x01>;
				#size-cells = <0x01>;
			};

			cam_iommu_region_partition {
				iommu-addresses = <0x36 0x00 0x100000 0x36 0xfff00000 0x100000 0x37 0x00 0x100000 0x37 0xfff00000 0x100000 0x38 0x00 0x10c00000 0x38 0xfef00000 0x1100000 0x38 0xdff00000 0x300000 0x39 0x00 0x100000 0x39 0xfff00000 0x100000 0x3a 0x00 0xd800000 0x3a 0xfff00000 0x100000>;
				phandle = <0x24>;
			};
		};
	};

	fragment@5 {
		target = <0xffffffff>;

		__overlay__ {

			cam_sensor_suspend_vana0 {
				phandle = <0x03>;

				config {
					drive-strength = <0x02>;
					bias-pull-down;
					pins = "gpio11";
				};

				mux {
					function = "gpio";
					pins = "gpio11";
				};
			};

			cam_sensor_active_vana0 {
				phandle = <0x04>;

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio11";
				};

				mux {
					function = "gpio";
					pins = "gpio11";
				};
			};

			cam_sensor_suspend_mclk0 {
				phandle = <0x05>;

				config {
					output-low;
					drive-strength = <0x04>;
					bias-pull-down;
					pins = "gpio64";
				};

				mux {
					function = "cam_mclk";
					pins = "gpio64";
				};
			};

			cam_flash_suspend {
				phandle = <0x06>;

				config {
					output-low;
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio96", "gpio97";
				};

				mux {
					function = "gpio";
					pins = "gpio96", "gpio97";
				};
			};

			cam_sensor_active_mclk0 {
				phandle = <0x07>;

				config {
					drive-strength = <0x04>;
					bias-disable;
					pins = "gpio64";
				};

				mux {
					function = "cam_mclk";
					pins = "gpio64";
				};
			};

			cam_flash_active {
				phandle = <0x08>;

				config {
					drive-strength = <0x02>;
					bias-disable;
					pins = "gpio96", "gpio97";
				};

				mux {
					function = "gpio";
					pins = "gpio96", "gpio97";
				};
			};

			cam_sensor_suspend_mclk4 {
				phandle = <0x11>;

				config {
					output-low;
					drive-strength = <0x04>;
					bias-pull-down;
