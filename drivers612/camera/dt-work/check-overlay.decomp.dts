/dts-v1/;

/ {

	fragment@0 {
		target = <0xffffffff>;

		__overlay__ {

			qcom,camera-flash@0 {
				status = "ok";
				torch-source = <0x01>;
				flash-source = <0x02>;
				compatible = "qcom,camera-flash";
				cell-index = <0x00>;
				phandle = <0x0d>;
			};

			qcom,torch_0 {
				qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
				qcom,hdrm-voltage-mv = <0x145>;
				qcom,ires-ua = <0x30d4>;
				qcom,current-ma = <0x12c>;
				qcom,id = <0x00>;
				qcom,default-led-trigger = "torch0_trigger";
				qcom,max-current = <0x1f4>;
				qcom,led-name = "led:torch_0";
				label = "torch";
				phandle = <0x01>;
			};

			qcom,flash_0 {
				qcom,record-current-ma = <0x32>;
				qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
				qcom,hdrm-voltage-mv = <0x145>;
				qcom,ires-ua = <0x30d4>;
				qcom,duration-ms = <0x500>;
				qcom,current-ma = <0x578>;
				qcom,id = <0x00>;
				qcom,default-led-trigger = "flash0_trigger";
				qcom,max-current = <0x5dc>;
				qcom,led-name = "led:flash_0";
				label = "flash";
				phandle = <0x02>;
			};

			qcom,cam-req-mgr {
				compatible = "qcom,cam-req-mgr";
				status = "ok";
			};

			qcom,cam-sync {
				compatible = "qcom,cam-sync";
				status = "ok";
			};

			qcom,cam-res-mgr {
				pinctrl-1 = <0x03>;
				pinctrl-0 = <0x04>;
				pinctrl-names = "cam_res_mgr_default", "cam_res_mgr_suspend";
				shared-gpios = <0x15b>;
				compatible = "qcom,cam-res-mgr";
				status = "ok";
			};

			qcom,csiphy0 {
				cell-index = <0x00>;
				compatible = "qcom,csiphy-v1.2.1", "qcom,csiphy";
				reg = <0xace0000 0x2000>;
				reg-names = "csiphy";
				reg-cam-base = <0xe0000>;
