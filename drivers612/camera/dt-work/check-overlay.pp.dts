/dts-v1/;
/plugin/;
&soc {
 led_flash_rear: qcom,camera-flash@0 {
  status = "ok";
  torch-source = <&sm5714_torch0>;
  flash-source = <&sm5714_flash0>;
  compatible = "qcom,camera-flash";
  cell-index = <0x00>;
 };
 sm5714_torch0: qcom,torch_0 {
  qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
  qcom,hdrm-voltage-mv = <0x145>;
  qcom,ires-ua = <0x30d4>;
  qcom,current-ma = <0x12c>;
  qcom,id = <0x00>;
  qcom,default-led-trigger = "torch0_trigger";
  qcom,max-current = <0x1f4>;
  qcom,led-name = "led:torch_0";
  label = "torch";
 };
 sm5714_flash0: qcom,flash_0 {
  qcom,record-current-ma = <0x32>;
  qcom,hdrm-vol-hi-lo-win-mv = <0x64>;
  qcom,hdrm-voltage-mv = <0x145>;
  qcom,ires-ua = <0x30d4>;
  qcom,duration-ms = <0x500>;
  qcom,current-ma = <0x578>;
  qcom,id = <0x00>;
  qcom,default-led-trigger = "flash0_trigger";
  qcom,max-current = <0x5dc>;
  qcom,led-name = "led:flash_0";
  label = "flash";
 };
 qcom,cam-req-mgr {
  compatible = "qcom,cam-req-mgr";
  status = "ok";
 };
 qcom,cam-sync {
  compatible = "qcom,cam-sync";
  status = "ok";
 };
 qcom,cam-res-mgr {
  pinctrl-1 = <&cam_sensor_suspend_vana0>;
  pinctrl-0 = <&cam_sensor_active_vana0>;
  pinctrl-names = "cam_res_mgr_default", "cam_res_mgr_suspend";
  shared-gpios = <0x15b>;
  compatible = "qcom,cam-res-mgr";
  status = "ok";
 };
 cam_csiphy0: qcom,csiphy0 {
  cell-index = <0x00>;
  compatible = "qcom,csiphy-v1.2.1", "qcom,csiphy";
  reg = <0xace0000 0x2000>;
  reg-names = "csiphy";
  reg-cam-base = <0xe0000>;
  interrupts = <0 477 1>;
  interrupt-names = "csiphy0";
  gdscr-supply = <&cam_cc_titan_top_gdsc>;
  refgen-supply = <&refgen>;
  csi-vdd-1p2-supply = <&pm7325_l6>;
  csi-vdd-0p9-supply = <&pm8350c_l10>;
  regulator-names = "gdscr", "refgen", "csi-vdd-1p2", "csi-vdd-0p9";
  rgltr-cntrl-support;
  rgltr-min-voltage = <0 0 1200000 880000>;
  rgltr-max-voltage = <0 0 1260000 1050000>;
  rgltr-load-current = <0 0 54000 96400>;
  clocks = <&camcc 31>,
           <&camcc 42>,
           <&camcc 33>,
           <&camcc 32>;
  clock-names = "cphy_rx_clk_src", "csiphy0_clk", "csi0phytimer_clk_src", "csi0phytimer_clk";
  src-clock-name = "csi0phytimer_clk_src";
  clock-cntl-level = "lowsvs", "svs";
  clock-rates = <300000000 0 300000000 0 400000000 0 300000000 0>;
  status = "ok";
 };
 cam_csiphy1: qcom,csiphy1 {
  cell-index = <0x01>;
  compatible = "qcom,csiphy-v1.2.1", "qcom,csiphy";
  reg = <0xace2000 0x2000>;
  reg-names = "csiphy";
  reg-cam-base = <0xe2000>;
  interrupts = <0 478 1>;
  interrupt-names = "csiphy1";
  gdscr-supply = <&cam_cc_titan_top_gdsc>;
  refgen-supply = <&refgen>;
  csi-vdd-1p2-supply = <&pm7325_l6>;
  csi-vdd-0p9-supply = <&pm8350c_l10>;
  regulator-names = "gdscr", "refgen", "csi-vdd-1p2", "csi-vdd-0p9";
  rgltr-cntrl-support;
  rgltr-min-voltage = <0 0 1200000 880000>;
  rgltr-max-voltage = <0 0 1260000 1050000>;
  rgltr-load-current = <0 0 54000 96400>;
  clocks = <&camcc 31>,
           <&camcc 43>,
           <&camcc 35>,
           <&camcc 34>;
  clock-names = "cphy_rx_clk_src", "csiphy1_clk", "csi1phytimer_clk_src", "csi1phytimer_clk";
  src-clock-name = "csi1phytimer_clk_src";
  clock-cntl-level = "lowsvs", "svs";
  clock-rates = <300000000 0 300000000 0 400000000 0 300000000 0>;
  status = "ok";
 };
