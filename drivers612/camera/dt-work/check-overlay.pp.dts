   cci-master = <0x00>;
   cci-device = <0x01>;
   sensor-mode = <0x00>;
   gpio-req-tbl-label = "CAMIF_MCLK1", "CAM_RESET1", "CAM_VANA1";
   gpio-req-tbl-flags = <0x01 0x00 0x00>;
