           <&tlmm 0xe 0>;
   pinctrl-1 = <&cam_sensor_suspend_mclk1 &cam_sensor_suspend_rst1 &cam_sensor_suspend_vana1>;
   pinctrl-0 = <&cam_sensor_active_mclk1 &cam_sensor_active_rst1 &cam_sensor_active_vana1>;
   pinctrl-names = "cam_default", "cam_suspend";
   gpio-no-mux = <0x00>;
   rgltr-load-current = <200000 200000 0>;
   rgltr-max-voltage = <1800000 1200000 0>;
   rgltr-min-voltage = <1800000 1200000 0>;
