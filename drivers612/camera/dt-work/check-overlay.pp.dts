           <&camcc 36>;
  clock-names = "cphy_rx_clk_src", "csiphy2_clk", "csi2phytimer_clk_src", "csi2phytimer_clk";
  src-clock-name = "csi2phytimer_clk_src";
  clock-cntl-level = "lowsvs", "svs";
  clock-rates = <300000000 0 300000000 0 400000000 0 300000000 0>;
