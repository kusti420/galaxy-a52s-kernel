&qupv3_se0_i2c {
 status = "ok";
 s2mpb03_pmic_0: s2mpb03_pmic@56 {
  s2mpb03,wakeup;
  reg = <0x56>;
  compatible = "samsung,s2mpb03pmic";
  regulators {
   s2mpb03_0_l7: s2mpb03-ldo7 {
    regulator-max-microvolt = <2800000>;
    regulator-min-microvolt = <2800000>;
    regulator-name = "CAM0_s2mpb03-l7";
   };
   s2mpb03_0_l6: s2mpb03-ldo6 {
    regulator-max-microvolt = <2900000>;
    regulator-min-microvolt = <2900000>;
    regulator-name = "CAM0_s2mpb03-l6";
   };
   s2mpb03_0_l5: s2mpb03-ldo5 {
    regulator-max-microvolt = <2800000>;
    regulator-min-microvolt = <2800000>;
    regulator-name = "CAM0_s2mpb03-l5";
   };
   s2mpb03_0_l4: s2mpb03-ldo4 {
    regulator-max-microvolt = <1200000>;
    regulator-min-microvolt = <1200000>;
    regulator-name = "CAM0_s2mpb03-l4";
   };
   s2mpb03_0_l3: s2mpb03-ldo3 {
    regulator-max-microvolt = <1800000>;
    regulator-min-microvolt = <1800000>;
    regulator-name = "CAM0_s2mpb03-l3";
   };
   s2mpb03_0_l2: s2mpb03-ldo2 {
    regulator-max-microvolt = <1100000>;
    regulator-min-microvolt = <1100000>;
    regulator-name = "CAM0_s2mpb03-l2";
   };
   s2mpb03_0_l1: s2mpb03-ldo1 {
    regulator-max-microvolt = <1050000>;
    regulator-min-microvolt = <1050000>;
    regulator-name = "CAM0_s2mpb03-l1";
   };
  };
 };
};
&qupv3_se3_i2c {
 status = "ok";
 sm5714-fled {
  timeout = <0xff>;
  factory_current = <0x00>;
  torch-brightness = <0x07>;
  preflash-brightness = <0x07>;
  flash-brightness = <0x0f>;
  torch-en-gpio = <&tlmm 0x61 0>;
  flash-en-gpio = <&tlmm 0x60 0>;
  slave-addr = <0x92>;
  status = "disabled";
  reg = <0x49>;
  compatible = "siliconmitus,sm5714-fled";
 };
};
&qupv3_se4_i2c {
 status = "ok";
 ois_rear: qcom,ois@62 {
  status = "ok";
  gpio-req-tbl-label = "MCU_RESET0", "MCU_VANA", "MCU_BOOT0";
  gpio-req-tbl-flags = <0x00 0x00 0x00>;
  gpio-req-tbl-num = <0x00 0x01 0x02>;
  gpio-custom1 = <0x02>;
  gpio-vana = <0x01>;
  gpio-reset = <0x00>;
  gpios = <&tlmm 0x2d 0>,
          <&tlmm 0xb 0>,
          <&tlmm 0x2e 0>;
  gpio-no-mux = <0x00>;
  pinctrl-1 = <&mcu_suspend>;
  pinctrl-0 = <&mcu_active>;
  pinctrl-names = "cam_default", "cam_suspend";
  qcom,cam-power-seq-delay = <0x01 0x01 0x01 0x0a>;
  qcom,cam-power-seq-cfg-val = <0x01 0x01 0x01 0x01>;
  qcom,cam-power-seq-type = "cam_vana", "cam_vaf", "cam_vio", "cam_reset";
  rgltr-load-current = <200000 200000>;
  rgltr-max-voltage = <1800000 2800000>;
  rgltr-min-voltage = <1800000 2800000>;
  rgltr-cntrl-support;
  regulator-names = "cam_vio", "cam_vaf";
  cam_vaf-supply = <&s2mpb03_0_l7>;
  cam_vio-supply = <&pm8350c_l2>;
  gyro-orientation = <0x00>;
  pole-values = <0x00 0x01 0x00 0x00 0x00 0x00>;
  slave-id = <0x456>;
  slave-addr = <0xc4>;
  reg = <0x51>;
  cell-index = <0x00>;
  compatible = "qcom,ois";
 };
};
&soc {
 qcom,cam_smmu {
  #address-cells = <1>;
  #size-cells = <1>;
 };
 cam_iova: cam_iommu_region_partition {
  iommu-addresses = <&cam_smmu_ife 0x0 0x100000>,
      <&cam_smmu_ife 0xfff00000 0x100000>,
      <&cam_smmu_jpeg 0x0 0x100000>,
      <&cam_smmu_jpeg 0xfff00000 0x100000>,
      <&cam_smmu_icp 0x0 0x10c00000>,
      <&cam_smmu_icp 0xfef00000 0x1100000>,
      <&cam_smmu_icp 0xdff00000 0x300000>,
      <&cam_smmu_cpas_cdm 0x0 0x100000>,
      <&cam_smmu_cpas_cdm 0xfff00000 0x100000>,
      <&cam_smmu_lrme 0x0 0xd800000>,
      <&cam_smmu_lrme 0xfff00000 0x100000>;
 };
};
&cam_smmu_ife {
 memory-region = <&cam_iova>;
 qcom,iommu-faults = "stall-disable", "HUPCF", "non-fatal";
};
&cam_smmu_jpeg {
 memory-region = <&cam_iova>;
 qcom,iommu-faults = "stall-disable", "HUPCF", "non-fatal";
};
&cam_smmu_icp {
 memory-region = <&cam_iova>;
 qcom,iommu-faults = "stall-disable", "HUPCF", "non-fatal";
};
&cam_smmu_cpas_cdm {
 memory-region = <&cam_iova>;
 qcom,iommu-faults = "stall-disable", "HUPCF", "non-fatal";
};
&cam_smmu_lrme {
 memory-region = <&cam_iova>;
 qcom,iommu-faults = "stall-disable", "HUPCF", "non-fatal";
};
