   pinctrl-1 = <&cam_sensor_suspend_mclk2 &cam_sensor_suspend_rst2 &cam_sensor_suspend_vana2>;
   pinctrl-0 = <&cam_sensor_active_mclk2 &cam_sensor_active_rst2 &cam_sensor_active_vana2>;
   pinctrl-names = "cam_default", "cam_suspend";
   use-shared-clk;
   gpio-no-mux = <0x00>;
