   cam,isp = <0x00>;
   clock-rates = <24000000>;
   clock-cntl-level = "turbo";
   clock-names = "cam_clk";
   clocks = <&camcc 96>;
   status = "ok";
   cci-master = <0x00>;
   cci-device = <0x01>;
   sensor-mode = <0x00>;
   gpio-req-tbl-label = "CAMIF_MCLK2", "CAM_RESET2", "CAM_VANA2";
   gpio-req-tbl-flags = <0x01 0x00 0x00>;
   gpio-req-tbl-num = <0x00 0x01 0x02>;
   gpio-vana = <0x02>;
   gpio-reset = <0x01>;
   gpios = <&tlmm 0x42 0>,
