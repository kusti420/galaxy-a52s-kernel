     iova-region-name = "shared";
     iova-region-start = <0x7400000>;
     iova-region-len = <0x6400000>;
     iova-region-id = <0x01>;
     status = "ok";
    };
    iova-mem-region-io {
     iova-region-name = "io";
     iova-region-start = <0x100000>;
     iova-region-len = <0xffe00000>;
     iova-region-id = <0x03>;
     status = "ok";
    };
   };
  };
 };
