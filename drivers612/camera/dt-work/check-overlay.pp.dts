 };
 cam_csiphy3: qcom,csiphy3 {
  cell-index = <0x03>;
  compatible = "qcom,csiphy-v1.2.1", "qcom,csiphy";
  reg = <0xace6000 0x2000>;
  reg-names = "csiphy";
  reg-cam-base = <0xe6000>;
  interrupts = <0 448 1>;
  interrupt-names = "csiphy3";
  gdscr-supply = <&cam_cc_titan_top_gdsc>;
  refgen-supply = <&refgen>;
  csi-vdd-1p2-supply = <&pm7325_l6>;
  csi-vdd-0p9-supply = <&pm8350c_l10>;
  regulator-names = "gdscr", "refgen", "csi-vdd-1p2", "csi-vdd-0p9";
  rgltr-cntrl-support;
  rgltr-min-voltage = <0 0 1200000 880000>;
  rgltr-max-voltage = <0 0 1260000 1050000>;
  rgltr-load-current = <0 0 54000 96400>;
  clocks = <&camcc 31>,
           <&camcc 45>,
           <&camcc 39>,
           <&camcc 38>;
  clock-names = "cphy_rx_clk_src", "csiphy3_clk", "csi3phytimer_clk_src", "csi3phytimer_clk";
  src-clock-name = "csi3phytimer_clk_src";
  clock-cntl-level = "lowsvs", "svs";
  clock-rates = <300000000 0 300000000 0 400000000 0 300000000 0>;
  status = "ok";
 };
 cam_csiphy4: qcom,csiphy4 {
  cell-index = <0x04>;
  compatible = "qcom,csiphy-v1.2.1", "qcom,csiphy";
  reg = <0xace8000 0x2000>;
  reg-names = "csiphy";
  reg-cam-base = <0xe8000>;
  interrupts = <0 122 1>;
  interrupt-names = "csiphy4";
  gdscr-supply = <&cam_cc_titan_top_gdsc>;
  refgen-supply = <&refgen>;
  csi-vdd-1p2-supply = <&pm7325_l6>;
  csi-vdd-0p9-supply = <&pm8350c_l10>;
  regulator-names = "gdscr", "refgen", "csi-vdd-1p2", "csi-vdd-0p9";
  rgltr-cntrl-support;
  rgltr-min-voltage = <0 0 1200000 880000>;
  rgltr-max-voltage = <0 0 1260000 1050000>;
  rgltr-load-current = <0 0 54000 96400>;
  clocks = <&camcc 31>,
           <&camcc 46>,
           <&camcc 41>,
           <&camcc 40>;
  clock-names = "cphy_rx_clk_src", "csiphy4_clk", "csi4phytimer_clk_src", "csi4phytimer_clk";
  src-clock-name = "csi4phytimer_clk_src";
  clock-cntl-level = "lowsvs", "svs";
  clock-rates = <300000000 0 300000000 0 400000000 0 300000000 0>;
  status = "ok";
 };
 cam_cci0: qcom,cci0 {
  cell-index = <0x00>;
  compatible = "qcom,cci", "simple-bus";
  reg = <0xac4a000 0x1000>;
  reg-names = "cci";
  reg-cam-base = <0x4a000>;
  interrupt-names = "cci";
  interrupts = <0 460 1>;
  status = "ok";
  gdscr-supply = <&cam_cc_titan_top_gdsc>;
  regulator-names = "gdscr";
  clocks = <&camcc 26>,
           <&camcc 25>;
  clock-names = "cci_0_clk_src", "cci_0_clk";
  src-clock-name = "cci_0_clk_src";
  clock-cntl-level = "lowsvs";
  clock-rates = <37500000 0>;
  pinctrl-names = "cam_default", "cam_suspend";
  pinctrl-0 = <&cci0_active &cci1_active>;
  pinctrl-1 = <&cci0_suspend &cci1_suspend>;
  gpios = <&tlmm 0x45 0>,
          <&tlmm 0x46 0>,
          <&tlmm 0x47 0>,
          <&tlmm 0x48 0>;
  gpio-req-tbl-num = <0x00 0x01 0x02 0x03>;
  gpio-req-tbl-flags = <0x01 0x01 0x01 0x01>;
  gpio-req-tbl-label = "CCI_I2C_DATA0", "CCI_I2C_CLK0", "CCI_I2C_DATA1", "CCI_I2C_CLK1";
  sensor_rear_wide: qcom,cam-sensor0 {
   cam,valid = <0x01>;
   cam,dual_open = <0x00>;
   cam,ois = <0x01>;
   cam,companion_chip = <0x00>;
   cam,fw_dump = <0x01>;
   cam,fw_write = <0x03>;
   cam,upgrade = <0x02>;
   cam,core_voltage = <0x01>;
   cam,read_version = <0x01>;
   cam,cal_memory = <0x02>;
   cam,isp = <0x00>;
   clock-rates = <19200000>;
   clock-cntl-level = "turbo";
   clock-names = "cam_clk";
   clocks = <&camcc 92>;
   status = "ok";
   cci-master = <0x00>;
   sensor-mode = <0x00>;
   gpio-req-tbl-label = "CAMIF_MCLK0", "CAM_RESET0", "CAM_VANA0";
   gpio-req-tbl-flags = <0x01 0x00 0x00>;
   gpio-req-tbl-num = <0x00 0x01 0x02>;
   gpio-vana = <0x02>;
   gpio-reset = <0x01>;
   gpios = <&tlmm 0x40 0>,
           <&tlmm 0x14 0>,
           <&tlmm 0xb 0>;
   pinctrl-1 = <&cam_sensor_suspend_mclk0 &cam_sensor_suspend_rst0 &cam_flash_suspend>;
   pinctrl-0 = <&cam_sensor_active_mclk0 &cam_sensor_active_rst0 &cam_flash_active>;
   pinctrl-names = "cam_default", "cam_suspend";
   use-shared-clk;
   gpio-no-mux = <0x00>;
   rgltr-load-current = <200000 200000 5000 200000 0>;
   rgltr-max-voltage = <1100000 1800000 2800000 2800000 0>;
   rgltr-min-voltage = <1100000 1800000 2800000 2800000 0>;
   rgltr-cntrl-support;
   regulator-names = "cam_vdig", "cam_vio", "cam_vana", "cam_vaf", "cam_clk";
   cam_clk-supply = <&cam_cc_titan_top_gdsc>;
   cam_vaf-supply = <&s2mpb03_0_l7>;
   cam_vana-supply = <&s2mpb03_0_l5>;
   cam_vio-supply = <&s2mpb03_0_l3>;
   cam_vdig-supply = <&s2mpb03_0_l2>;
   led-flash-src = <&led_flash_rear>;
   ois-src = <&ois_rear>;
   eeprom-src = <&eeprom0>;
   actuator-src = <&actuator_rear0>;
   sensor-position-yaw = <0xb4>;
   sensor-position-pitch = <0x00>;
   sensor-position-roll = <0x5a>;
   csiphy-sd-index = <0x00>;
   compatible = "qcom,cam-sensor";
   cell-index = <0x00>;
  };
  i2c_freq_100Khz_cci0: qcom,i2c_standard_mode {
   hw-thigh = <0xc9>;
   hw-tlow = <0xae>;
   hw-tsu-sto = <0xcc>;
   hw-tsu-sta = <0xe7>;
   hw-thd-dat = <0x16>;
   hw-thd-sta = <0xa2>;
   hw-tbuf = <0xe3>;
   hw-scl-stretch-en = <0x00>;
   hw-trdhld = <0x06>;
   hw-tsp = <0x03>;
   cci-clk-src = <37500000>;
   status = "ok";
  };
  i2c_freq_400Khz_cci0: qcom,i2c_fast_mode {
   hw-thigh = <0x26>;
   hw-tlow = <0x38>;
   hw-tsu-sto = <0x28>;
   hw-tsu-sta = <0x28>;
   hw-thd-dat = <0x16>;
   hw-thd-sta = <0x23>;
   hw-tbuf = <0x3e>;
   hw-scl-stretch-en = <0x00>;
   hw-trdhld = <0x06>;
   hw-tsp = <0x03>;
   cci-clk-src = <37500000>;
   status = "ok";
  };
  i2c_freq_custom_cci0: qcom,i2c_custom_mode {
   hw-thigh = <0x26>;
   hw-tlow = <0x38>;
   hw-tsu-sto = <0x28>;
   hw-tsu-sta = <0x28>;
   hw-thd-dat = <0x16>;
   hw-thd-sta = <0x23>;
   hw-tbuf = <0x3e>;
   hw-scl-stretch-en = <0x01>;
   hw-trdhld = <0x06>;
   hw-tsp = <0x03>;
   cci-clk-src = <37500000>;
   status = "ok";
  };
  i2c_freq_1Mhz_cci0: qcom,i2c_fast_plus_mode {
   hw-thigh = <0x10>;
   hw-tlow = <0x16>;
   hw-tsu-sto = <0x11>;
   hw-tsu-sta = <0x12>;
   hw-thd-dat = <0x10>;
   hw-thd-sta = <0x0f>;
   hw-tbuf = <0x18>;
   hw-scl-stretch-en = <0x00>;
   hw-trdhld = <0x03>;
   hw-tsp = <0x03>;
   cci-clk-src = <37500000>;
   status = "ok";
  };
 };
 cam_cci1: qcom,cci1 {
  cell-index = <0x01>;
  compatible = "qcom,cci", "simple-bus";
  reg = <0xac4b000 0x1000>;
  reg-names = "cci";
  reg-cam-base = <0x4b000>;
  interrupt-names = "cci";
  interrupts = <0 271 1>;
  status = "ok";
  gdscr-supply = <&cam_cc_titan_top_gdsc>;
  regulator-names = "gdscr";
  clocks = <&camcc 28>,
           <&camcc 27>;
  clock-names = "cci_1_clk_src", "cci_1_clk";
  src-clock-name = "cci_1_clk_src";
  clock-cntl-level = "lowsvs";
  clock-rates = <37500000 0>;
  pinctrl-names = "cam_default", "cam_suspend";
  pinctrl-0 = <&cci2_active &cci3_active>;
  pinctrl-1 = <&cci2_suspend &cci3_suspend>;
  gpios = <&tlmm 0x49 0>,
          <&tlmm 0x4a 0>,
          <&tlmm 0x4b 0>,
          <&tlmm 0x4c 0>;
  gpio-req-tbl-num = <0x00 0x01 0x02 0x03>;
  gpio-req-tbl-flags = <0x01 0x01 0x01 0x01>;
  gpio-req-tbl-label = "CCI_I2C_DATA2", "CCI_I2C_CLK2", "CCI_I2C_DATA3", "CCI_I2C_CLK3";
  actuator_rear0: qcom,actuator@0xC {
   qcom,cam-power-seq-delay = <0x01 0x0c>;
   qcom,cam-power-seq-cfg-val = <0x01 0x01>;
   qcom,cam-power-seq-type = "cam_vio", "cam_vaf";
   rgltr-load-current = <200000 200000>;
   rgltr-max-voltage = <1800000 2800000>;
   rgltr-min-voltage = <1800000 2800000>;
   rgltr-cntrl-support;
   regulator-names = "cam_vio", "cam_vaf";
   cam_vaf-supply = <&s2mpb03_0_l7>;
   cam_vio-supply = <&s2mpb03_0_l3>;
   i2c-freq-mode = <0x03>;
   compatible = "qcom,actuator";
   cci-master = <0x01>;
   cci-device = <0x01>;
   slave-addr = <0x18>;
   reg = <0x0c>;
   cell-index = <0x00>;
  };
  eeprom4: qcom,eeprom@0x3F {
   cam,valid = <0x01>;
   cam,dual_open = <0x00>;
   cam,ois = <0x00>;
   cam,companion_chip = <0x00>;
   cam,fw_dump = <0x01>;
   cam,fw_write = <0x03>;
   cam,upgrade = <0x02>;
   cam,core_voltage = <0x01>;
   cam,read_version = <0x01>;
   cam,cal_memory = <0x02>;
   cam,isp = <0x00>;
   clock-rates = <24000000>;
   clock-cntl-level = "turbo";
   clock-names = "cam_clk";
   clocks = <&camcc 98>;
   status = "ok";
   cci-master = <0x00>;
   cci-device = <0x01>;
   sensor-mode = <0x00>;
   gpio-req-tbl-label = "CAMIF_MCLK3", "CAM_RESET3", "CAM_VANA1";
   gpio-req-tbl-flags = <0x01 0x00 0x00>;
   gpio-req-tbl-num = <0x00 0x01 0x02>;
   gpio-vana = <0x02>;
   gpio-reset = <0x01>;
   gpios = <&tlmm 0x43 0>,
           <&tlmm 0x4e 0>,
           <&tlmm 0xe 0>;
   pinctrl-1 = <&cam_sensor_suspend_mclk4 &cam_sensor_suspend_rst4 &cam_sensor_suspend_vana1>;
   pinctrl-0 = <&cam_sensor_active_mclk4 &cam_sensor_active_rst4 &cam_sensor_active_vana1>;
   pinctrl-names = "cam_default", "cam_suspend";
   use-shared-clk;
   gpio-no-mux = <0x00>;
   rgltr-load-current = <200000 200000 0>;
   rgltr-max-voltage = <1200000 1800000 0>;
   rgltr-min-voltage = <1200000 1800000 0>;
   rgltr-cntrl-support;
   regulator-names = "cam_vdig", "cam_vio", "cam_clk";
   cam_clk-supply = <&cam_cc_titan_top_gdsc>;
   cam_vio-supply = <&s2mpb03_0_l3>;
   cam_vdig-supply = <&s2mpb03_0_l4>;
   sensor-position-yaw = <0xb4>;
   sensor-position-pitch = <0x00>;
   sensor-position-roll = <0x5a>;
   csiphy-sd-index = <0x02>;
   sub-type = <0x02>;
   i2c-freq-mode = <0x01>;
   compatible = "qcom,eeprom";
   slave-addr = <0x7e>;
   reg = <0x3f>;
   cell-index = <0x04>;
  };
  eeprom3: qcom,eeprom@37 {
   cam,valid = <0x01>;
   cam,dual_open = <0x00>;
   cam,ois = <0x00>;
   cam,companion_chip = <0x00>;
   cam,fw_dump = <0x01>;
   cam,fw_write = <0x03>;
   cam,upgrade = <0x02>;
   cam,core_voltage = <0x01>;
   cam,read_version = <0x01>;
   cam,cal_memory = <0x02>;
   cam,isp = <0x00>;
