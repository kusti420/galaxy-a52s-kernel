   i2c-freq-mode = <0x01>;
   compatible = "qcom,eeprom";
   reg = <0x37>;
   cell-index = <0x03>;
  };
  eeprom2: qcom,eeprom@0x2D {
   cam,valid = <0x01>;
   cam,dual_open = <0x00>;
   cam,ois = <0x00>;
   cam,companion_chip = <0x00>;
   cam,fw_dump = <0x01>;
   cam,fw_write = <0x03>;
   cam,upgrade = <0x02>;
   cam,core_voltage = <0x01>;
