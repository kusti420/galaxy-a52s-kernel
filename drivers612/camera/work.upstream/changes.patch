+				offset_y       = 0x0070;
+				offset_z       = 0x0074;
+				offset_sx      = 0x03C0;
+				offset_sy      = 0x03C4;
+				offset_range   = 0x04E0;
+				offset_max_err = 0x04E4;
+				offset_avg_err = 0x04E8;
