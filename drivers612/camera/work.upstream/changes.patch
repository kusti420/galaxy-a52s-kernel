+		CAM_ERR(CAM_SENSOR, "DPC_DBG GC5035 Macro Sensor OTP DD Autoload Step 3b failed");
+		return rc;
+	} else {
+		CAM_ERR(CAM_SENSOR, "DPC_DBG GC5035 Macro Sensor OTP DD Autoload Step 3b Success");
+	}
+
+	rc = camera_io_dev_read(
+			&(s_ctrl->io_master_info),
