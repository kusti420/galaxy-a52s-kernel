 sdhc1_opp_table: sdhc1-opp-table {
  compatible = "operating-points-v2";

  opp-100000000 {
   opp-hz = /bits/ 64 <100000000>;
   opp-peak-kBps = <250000 133320>;
   opp-avg-kBps = <104000 0>;
  };

  opp-384000000 {
   opp-hz = /bits/ 64 <384000000>;
   opp-peak-kBps = <800000 300000>;
   opp-avg-kBps = <400000 0>;
  };
 };

 sdhc_1: sdhci@7C4000 {
  compatible = "qcom,sdhci-msm-v5";
  reg = <0x007C4000 0x1000>, <0x007C5000 0x1000>,
        <0x007c8000 0x18000>;
  reg-names = "hc", "cqhci", "ice";

  iommus = <&apps_smmu 0xc0 0x0>;
  dma-coherent;
  qcom,iommu-dma = "fastmap";
  qcom,iommu-geometry = <0x40000000 0x20000000>;

  interrupts = <0 652 4>,
    <0 656 4>;
  interrupt-names = "hc_irq", "pwr_irq";

  qcom,ice-use-hwkm;

  clocks = <&gcc 109>,
   <&gcc 108>,
   <&gcc 111>;
  clock-names = "core", "iface", "ice_core";

  qcom,ice-clk-rates = <300000000 100000000>;

  interconnects = <&aggre1_noc 47 &mc_virt 512>,
   <&gem_noc 2 &cnoc2 551>;
  interconnect-names = "sdhc-ddr","cpu-sdhc";

  operating-points-v2 = <&sdhc1_opp_table>;


  qcom,dll-hsr-list = <0x000f642c 0x0 0x0 0x2C010800 0x80040868>;

  mmc-ddr-1_8v;
  mmc-hs200-1_8v;
  mmc-hs400-1_8v;
  mmc-hs400-enhanced-strobe;

  cap-mmc-hw-reset;

  bus-width = <8>;
  non-removable;
  supports-cqe;

  boot_device_type = <0x1>;
  nvmem-cells = <&boot_config>;
  nvmem-cell-names = "boot_conf";

  qcom,scaling-lower-bus-speed-mode = "DDR52";


  resets = <&gcc 6>;
  reset-names = "core_reset";

  status = "disabled";

  qos0 {
   mask = <0x0f>;
   vote = <61>;
  };

  qos1 {
   mask = <0xf0>;
   vote = <67>;
  };
 };

 sdhc2_opp_table: sdhc2-opp-table {
  compatible = "operating-points-v2";

  opp-100000000 {
   opp-hz = /bits/ 64 <100000000>;
   opp-peak-kBps = <250000 133320>;
   opp-avg-kBps = <50000 0>;
  };

  opp-202000000 {
   opp-hz = /bits/ 64 <202000000>;
   opp-peak-kBps = <800000 300000>;
   opp-avg-kBps = <104000 0>;
  };
 };

 sdhc_2: sdhci@8804000 {
  compatible = "qcom,sdhci-msm-v5";
  reg = <0x08804000 0x1000>;
  reg-names = "hc_mem";

  iommus = <&apps_smmu 0x100 0x0>;
  dma-coherent;
  qcom,iommu-dma = "fastmap";

  interrupts = <0 207 4>,
    <0 223 4>;
  interrupt-names = "hc_irq", "pwr_irq";

  clocks = <&gcc 114>, <&gcc 113>;
  clock-names = "core", "iface";

  bus-width = <4>;

  interconnects = <&aggre1_noc 48 &mc_virt 512>,
   <&gem_noc 2 &cnoc2 552>;
  interconnect-names = "sdhc-ddr","cpu-sdhc";

  operating-points-v2 = <&sdhc2_opp_table>;

  qcom,dll-hsr-list = <0x0007642c 0x0 0x10 0x2C010800 0x80040868>;

  status = "disabled";

  qos0 {
   mask = <0x0f>;
   vote = <61>;
  };

  qos1 {
   mask = <0xf0>;
   vote = <67>;
  };
 };

