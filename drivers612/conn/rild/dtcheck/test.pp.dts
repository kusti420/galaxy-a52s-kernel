# 1 "./bsp612/soc-repo/include/dt-bindings/iio/qcom,spmi-adc7-pmr735b.h" 1
# 15 "./bsp612/devicetree/qcom/pmk8350.dtsi" 2

&spmi_bus {
 #address-cells = <2>;
 #size-cells = <0>;
 interrupt-controller;
 #interrupt-cells = <4>;

 pmk8350: qcom,pmk8350@0 {
  compatible = "qcom,spmi-pmic";
  reg = <0 0>;
  #address-cells = <1>;
  #size-cells = <0>;

  pmic-ecid@100 {
   compatible = "qcom,pmic-ecid";
   reg = <0x100>;
   qcom,pmic-name = "pmk8350";
  };

  pmk8350_pon: pon@1300 {
   compatible = "qcom,pmk8350-pon";
   reg = <0x1300>, <0x800>;
   reg-names = "hlos", "pbs";

   pon_pwrkey: pwrkey {
    compatible = "qcom,pmk8350-pwrkey";
    interrupts = <0 0x13 0x7 (2 | 1)>;
    linux,code = <116>;
   };

   pon_resin: resin {
    compatible = "qcom,pmk8350-resin";
    interrupts = <0 0x13 0x6 (2 | 1)>;
    linux,code = <114>;
   };
  };

  pmk8350_qvadj: qcom,voltage-adj-device {
   compatible = "qcom,vadj";
  };

  pmk8350_vadc: vadc@3100 {
   compatible = "qcom,spmi-adc7";
   reg = <0x3100>;
   #address-cells = <1>;
   #size-cells = <0>;
   interrupts = <0x0 0x31 0x0 1>;
   interrupt-names = "eoc-int-en-set";
   #io-channel-cells = <1>;
   io-channel-ranges;


   pmk8350_ref_gnd {
    reg = <(0 << 8 | 0x0)>;
    label = "pmk8350_ref_gnd";
    qcom,pre-scaling = <1 1>;
   };

   pmk8350_vref_1p25 {
    reg = <(0 << 8 | 0x01)>;
    label = "pmk8350_vref_1p25";
    qcom,pre-scaling = <1 1>;
   };

   pmk8350_die_temp {
    reg = <(0 << 8 | 0x03)>;
    label = "pmk8350_die_temp";
    qcom,pre-scaling = <1 1>;
   };

   pmk8350_xo_therm {
    reg = <(0 << 8 | 0x44)>;
    label = "pmk8350_xo_therm";
    qcom,ratiometric;
    qcom,hw-settle-time = <200>;
    qcom,pre-scaling = <1 1>;
   };


   pm8350_ref_gnd {
    reg = <(1 << 8 | 0x0)>;
    label = "pm8350_ref_gnd";
    qcom,pre-scaling = <1 1>;
   };

   pm8350_vref_1p25 {
    reg = <(1 << 8 | 0x01)>;
    label = "pm8350_vref_1p25";
    qcom,pre-scaling = <1 1>;
   };

   pm8350_die_temp {
    reg = <(1 << 8 | 0x03)>;
    label = "pm8350_die_temp";
    qcom,pre-scaling = <1 1>;
   };

   pm8350_vph_pwr {
    reg = <(1 << 8 | 0x8e)>;
    label = "pm8350_vph_pwr";
    qcom,pre-scaling = <1 3>;
   };


   pm8350b_ref_gnd {
    reg = <(3 << 8 | 0x0)>;
    label = "pm8350b_ref_gnd";
    qcom,pre-scaling = <1 1>;
   };

   pm8350b_vref_1p25 {
    reg = <(3 << 8 | 0x01)>;
    label = "pm8350b_vref_1p25";
    qcom,pre-scaling = <1 1>;
   };

   pm8350b_die_temp {
    reg = <(3 << 8 | 0x03)>;
    label = "pm8350b_die_temp";
    qcom,pre-scaling = <1 1>;
   };

   pm8350b_vph_pwr {
    reg = <(3 << 8 | 0x8e)>;
    label = "pm8350b_vph_pwr";
    qcom,pre-scaling = <1 3>;
   };

   pm8350b_vbat_sns {
    reg = <(3 << 8 | 0x8f)>;
    label = "pm8350b_vbat_sns";
    qcom,pre-scaling = <1 3>;
   };


   pmr735a_ref_gnd {
    reg = <(4 << 8 | 0x0)>;
    label = "pmr735a_ref_gnd";
    qcom,pre-scaling = <1 1>;
   };

   pmr735a_vref_1p25 {
    reg = <(4 << 8 | 0x01)>;
    label = "pmr735a_vref_1p25";
    qcom,pre-scaling = <1 1>;
   };

   pmr735a_die_temp {
    reg = <(4 << 8 | 0x03)>;
    label = "pmr735a_die_temp";
    qcom,pre-scaling = <1 1>;
   };


   pmr735b_ref_gnd {
    reg = <(5 << 8 | 0x0)>;
    label = "pmr735b_ref_gnd";
    qcom,pre-scaling = <1 1>;
   };

   pmr735b_vref_1p25 {
    reg = <(5 << 8 | 0x01)>;
    label = "pmr735b_vref_1p25";
    qcom,pre-scaling = <1 1>;
   };

   pmr735b_die_temp {
    reg = <(5 << 8 | 0x03)>;
    label = "pmr735b_die_temp";
    qcom,pre-scaling = <1 1>;
   };
  };

  pmk8350_adc_tm: adc_tm@3400 {
   compatible = "qcom,spmi-adc-tm5-gen2";
   reg = <0x3400>;
   interrupts = <0x0 0x34 0x0 1>;
   #address-cells = <1>;
   #size-cells = <0>;
   #thermal-sensor-cells = <1>;
  };

  pmk8350_sdam_1: sdam@7000 {
   compatible = "qcom,spmi-sdam";
   reg = <0x7000>;
   #address-cells = <1>;
   #size-cells = <1>;
  };

  pmk8350_sdam_2: sdam@7100 {
   compatible = "qcom,spmi-sdam";
   reg = <0x7100>;
   #address-cells = <1>;
   #size-cells = <1>;

   restart_reason: restart@48 {
    reg = <0x48 0x1>;
    bits = <1 7>;
   };
  };

  pmk8350_sdam_5: sdam@7400 {
   compatible = "qcom,spmi-sdam";
   reg = <0x7400>;
  };

  pmk8350_sdam_13: sdam@7c00 {
   compatible = "qcom,spmi-sdam";
   reg = <0x7c00>;
  };

  pmk8350_sdam_14: sdam@7d00 {
   compatible = "qcom,spmi-sdam";
   reg = <0x7d00>;
  };

  pmk8350_sdam_21: sdam@8400 {
   compatible = "qcom,spmi-sdam";
   reg = <0x8400>;
  };

  pmk8350_sdam_22: sdam@8500 {
   compatible = "qcom,spmi-sdam";
   reg = <0x8500>;
  };

  pmk8350_sdam_23: sdam@8600 {
   compatible = "qcom,spmi-sdam";
   reg = <0x8600>;
   #address-cells = <1>;
   #size-cells = <1>;
  };

  pmk8350_sdam_46: sdam@9d00 {
   compatible = "qcom,spmi-sdam";
   reg = <0x9d00>;
  };

  pmk8350_gpios: pinctrl@b000 {
   compatible = "qcom,pmk8350-gpio";
   reg = <0xb000>;
   gpio-controller;
   #gpio-cells = <2>;
   interrupt-controller;
   #interrupt-cells = <2>;
  };

  pmk8350_rtc: rtc@6100 {
   compatible = "qcom,pmk8350-rtc";
   reg = <0x6100>, <0x6200>;
   reg-names = "rtc", "alarm";
   interrupts = <0x0 0x62 0x1 1>;
  };
 };
};
# 10 "./bsp612/devicetree/qcom/yupik-pmic-overlay.dtsi" 2
# 1 "./bsp612/devicetree/qcom/pm7325.dtsi" 1
# 9 "./bsp612/devicetree/qcom/pm7325.dtsi"
&spmi_bus {
 #address-cells = <2>;
 #size-cells = <0>;
 interrupt-controller;
 #interrupt-cells = <4>;

 qcom,pm7325@1 {
  compatible = "qcom,spmi-pmic";
  reg = <1 0>;
  #address-cells = <1>;
  #size-cells = <0>;

  qcom,power-on@800 {
  compatible = "qcom,qpnp-power-on";
  reg = <0x800>;
  interrupts = <0x0 0x8 0x0 (2 | 1)>,
     <0x0 0x8 0x1 (2 | 1)>;
  interrupt-name = "kpdpwr", "resin";
  qcom,pon-dbc-delay = <15625>;
  qcom,kpdpwr-sw-debounce;
  qcom,system-reset;
  qcom,store-hard-reset-reason;

  qcom,pon_1 {
   qcom,pon-type = <0>;
   qcom,pull-up;
   linux,code = <116>;
  };

  qcom,pon_2 {
   qcom,pon-type = <1>;
   qcom,pull-up;
   linux,code = <116>;
  };
 };

  pm7325_tz: qcom,temp-alarm@a00 {
   compatible = "qcom,spmi-temp-alarm";
   reg = <0xa00>;
   interrupts = <0x1 0xa 0x0 (2 | 1)>;
   #thermal-sensor-cells = <0>;
  };

  pm7325_gpios: pinctrl@8800 {
   compatible = "qcom,pm7325-gpio";
   reg = <0x8800>;
   gpio-controller;
   #gpio-cells = <2>;
   interrupt-controller;
   #interrupt-cells = <2>;
  };
 };
};

&thermal_zones {
 pm7325_temp_alarm: pm7325_tz {
  polling-delay-passive = <100>;
  polling-delay = <0>;
  thermal-governor = "step_wise";
  thermal-sensors = <&pm7325_tz>;

  trips {
   pm7325_trip0: trip0 {
    temperature = <95000>;
    hysteresis = <0>;
    type = "passive";
   };

   pm7325_trip1: trip1 {
    temperature = <115000>;
    hysteresis = <0>;
    type = "critical";
   };

   pm7325_trip2: trip2 {
    temperature = <145000>;
    hysteresis = <0>;
    type = "critical";
   };
  };
 };
};
# 11 "./bsp612/devicetree/qcom/yupik-pmic-overlay.dtsi" 2
# 1 "./bsp612/devicetree/qcom/pm8350c.dtsi" 1






# 1 "./bsp612/kernel/include/dt-bindings/leds/common.h" 1
# 8 "./bsp612/devicetree/qcom/pm8350c.dtsi" 2


&spmi_bus {
 #address-cells = <2>;
 #size-cells = <0>;
 interrupt-controller;
 #interrupt-cells = <4>;

 qcom,pm8350c@2 {
  compatible = "qcom,spmi-pmic";
  reg = <2 0>;
  #address-cells = <1>;
  #size-cells = <0>;

  pm8350c_tz: qcom,temp-alarm@a00 {
   compatible = "qcom,spmi-temp-alarm";
   reg = <0xa00>;
   interrupts = <0x2 0xa 0x0 (2 | 1)>;
   #thermal-sensor-cells = <0>;
  };

  pm8350c_gpios: pinctrl@8800 {
   compatible = "qcom,pm8350c-gpio";
   reg = <0x8800>;
   gpio-controller;
   #gpio-cells = <2>;
   interrupt-controller;
   #interrupt-cells = <2>;
  };

  pm8350c_pwm: pwms@e800 {
   compatible = "qcom,pm8350c-pwm";
   #address-cells = <1>;
   #size-cells = <0>;
   #pwm-cells = <2>;
   nvmem = <&pmk8350_sdam_21 &pmk8350_sdam_22>;
   nvmem-names = "lpg_chan_sdam", "lut_sdam";

   led@1 {
    reg = <1>;
    color = <1>;
    label = "red";
   };

   led@2 {
    reg = <2>;
    color = <2>;
    label = "green";
   };

   led@3 {
    reg = <3>;
    color = <3>;
    label = "blue";
   };
  };

  pm8350c_pwm_2: pwms@eb00 {
   compatible = "qcom,pm8350c-pwm";
   #pwm-cells = <2>;
  };

  pm8350c_bcl: bcl@4700 {
   compatible = "qcom,bcl-v5";
   reg = <0x4700 0x100>;
   interrupts = <0x2 0x47 0x0 0>,
     <0x2 0x47 0x1 0>,
     <0x2 0x47 0x2 0>;
   interrupt-names = "bcl-lvl0",
      "bcl-lvl1",
      "bcl-lvl2";
   qcom,pmic7-threshold;
   #thermal-sensor-cells = <1>;
  };

  pm8350c_flash: qcom,flash_led@ee00 {
   compatible = "qcom,qti-pm8350c-flash-led";
   reg = <0xee00>;
   interrupts = <0x2 0xee 0x0 1>,
         <0x2 0xee 0x3 1>,
         <0x2 0xee 0x4 1>;
   interrupt-names = "led-fault-irq",
       "all-ramp-down-done-irq",
       "all-ramp-up-done-irq";
   qcom,thermal-derate-current = <200 500>;
   qcom,hw-strobe-gpios = <&pm8350c_gpios 1 0>;
   status = "disabled";

   pm8350c_flash0: qcom,flash_0 {
    label = "flash";
    qcom,led-name = "led:flash_0";
    qcom,max-current-ma = <1500>;
    qcom,default-led-trigger = "flash0_trigger";
    qcom,id = <0>;
    qcom,duration-ms = <1280>;
    qcom,ires-ua = <12500>;
   };

   pm8350c_flash1: qcom,flash_1 {
    label = "flash";
    qcom,led-name = "led:flash_1";
    qcom,max-current-ma = <1500>;
    qcom,default-led-trigger = "flash1_trigger";
    qcom,id = <1>;
    qcom,duration-ms = <1280>;
    qcom,ires-ua = <12500>;
   };

   pm8350c_flash2: qcom,flash_2 {
    label = "flash";
    qcom,led-name = "led:flash_2";
    qcom,max-current-ma = <1500>;
