# 3180 "./bsp612/devicetree/qcom/yupik.dtsi" 2
# 1 "./bsp612/devicetree/qcom/yupik-walt.dtsi" 1





&soc {
 walt {
  #address-cells = <1>;
  #size-cells = <1>;
  ranges;

  qcom,cycle-cntr {
   compatible = "qcom,epss";
   reg = <0x18591000 0x1000>,
    <0x18592000 0x1000>,
    <0x18593000 0x1000>;
   reg-names = "freq-domain0",
    "freq-domain1",
    "freq-domain2";
  };
 };
};
