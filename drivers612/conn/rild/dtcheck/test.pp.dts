   compatible = "qcom,spi-geni";
   reg = <0xa9c000 0x4000>;
   #address-cells = <1>;
   #size-cells = <0>;
   reg-names = "se_phys";
   interrupts = <0 369 4>;
   clock-names = "se-clk";
   clocks = <&gcc 102>;
   pinctrl-names = "default", "sleep";
   pinctrl-0 = <&qupv3_se15_spi_mosi_active>, <&qupv3_se15_spi_miso_active>,
    <&qupv3_se15_spi_clk_active>, <&qupv3_se15_spi_cs_active>;
   pinctrl-1 = <&qupv3_se15_spi_sleep>;
   dmas = <&gpi_dma1 0 7 1 64 0>,
    <&gpi_dma1 1 7 1 64 0>;
   dma-names = "tx", "rx";
   spi-max-frequency = <50000000>;
   interconnect-names = "qup-core", "qup-config", "qup-memory";
   interconnects = <&clk_virt 33 &clk_virt 582>,
     <&gem_noc 2 &cnoc2 549>,
     <&aggre1_noc 9 &mc_virt 512>;
   status = "disabled";
  };
 };
};
