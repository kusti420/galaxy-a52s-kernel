 qup1_gpi_iommu_region: qup1_gpi_iommu_region {
  iommu-addresses = <&gpi_dma1 0x0 0x100000>,
    <&gpi_dma1 0x200000 0xffe00000>;
 };


 gpi_dma1: qcom,gpi-dma@a00000 {
  compatible = "qcom,gpi-dma";
  #dma-cells = <5>;
  reg = <0xa00000 0x60000>;
  reg-names = "gpi-top";
  iommus = <&apps_smmu 0x56 0x0>;
  qcom,max-num-gpii = <12>;
  interrupts = <0 279 4>,
   <0 280 4>,
   <0 281 4>,
   <0 282 4>,
   <0 283 4>,
   <0 284 4>,
   <0 293 4>,
   <0 294 4>,
   <0 295 4>,
   <0 296 4>,
   <0 297 4>,
   <0 298 4>;
  qcom,static-gpii-mask = <0x1>;
  qcom,gpii-mask = <0x1e>;
  qcom,ev-factor = <2>;
  memory-region = <&qup1_gpi_iommu_region>;
  qcom,gpi-ee-offset = <0x10000>;
  dma-coherent;
  status = "ok";
 };

 qup1_se_iommu_region: qup1_se_iommu_region {
  iommu-addresses = <&qupv3_1 0x0 0x40000000>,
    <&qupv3_1 0x50000000 0xb0000000>;
 };


