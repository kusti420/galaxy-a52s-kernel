  reg = <0x6048000 0x1000>,
   <0x6064000 0x15000>;
  reg-names = "tmc-base", "bam-base";

  device-name = "tmc_etr0";

  qcom,iommu-dma = "bypass";
  iommus = <&apps_smmu 0x04a0 0>,
