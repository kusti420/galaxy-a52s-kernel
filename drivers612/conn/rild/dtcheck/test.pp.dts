# 1 "./bsp612/soc-repo/include/dt-bindings/phy/qcom,usb3-6nm-qmp-combo.h" 1
# 8 "./bsp612/devicetree/qcom/yupik-usb.dtsi" 2

&soc {

 usb0: ssusb@a600000 {
  compatible = "qcom,dwc-usb3-msm";
  reg = <0xa600000 0x100000>;
  reg-names = "core_base";

  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  interrupts-extended = <&pdc 14 1>,
        <&intc 0 130 4>,
        <&pdc 17 4>,
        <&pdc 15 1>;
  interrupt-names = "dp_hs_phy_irq", "pwr_event_irq",
    "ss_phy_irq", "dm_hs_phy_irq";
  qcom,use-pdc-interrupts;

  USB3_GDSC-supply = <&gcc_usb30_prim_gdsc>;
  clocks = <&gcc 139>,
   <&gcc 15>,
   <&gcc 10>,
   <&gcc 141>,
   <&gcc 144>;
  clock-names = "core_clk", "iface_clk", "bus_aggr_clk",
     "utmi_clk", "sleep_clk";

  resets = <&gcc 10>;
  reset-names = "core_reset";

  qcom,core-clk-rate = <133333333>;
  qcom,core-clk-rate-hs = <66666667>;
  qcom,num-gsi-evt-buffs = <0x3>;
  qcom,pm-qos-latency = <61>;
  qcom,gsi-reg-offset =
   <0x0fc
   0x110
   0x120
   0x130
   0x144
   0x1a4>;
  usb-role-switch;
  extcon = <&eud>;

  interconnect-names = "usb-ddr", "usb-ipa", "ddr-usb";
  interconnects = <&aggre1_noc 51 &mc_virt 512>,
    <&aggre1_noc 51 &cnoc2 529>,
    <&gem_noc 2 &cnoc2 558>;

  dwc3_0: dwc3@a600000 {
   compatible = "snps,dwc3";
   reg = <0x0 0xa600000 0x0 0xe000>;

   iommus = <&apps_smmu 0xe0 0x0>;
   qcom,iommu-dma = "atomic";
   memory-region = <&dwc3_mem_region_0>;
   dma-coherent;

   interrupts = <0 133 4>;
   usb-phy = <&usb2_phy0>, <&usb_qmp_dp_phy>;
   snps,disable-clk-gating;
   snps,has-lpm-erratum;
   snps,hird-threshold = /bits/ 8 <0x0>;
   snps,is-utmi-l1-suspend;
   snps,dis-u1-entry-quirk;
   snps,dis-u2-entry-quirk;
   snps,dis_u2_susphy_quirk;
   snps,ssp-u3-u0-quirk;
   tx-fifo-resize;
   num-hc-interrupters = /bits/ 16 <3>;
   maximum-speed = "super-speed";
   dr_mode = "otg";
   usb-role-switch;
  };
 };

 dwc3_mem_region_0: dwc3_mem_region0 {
  iommu-addresses = <&dwc3_0 0x0 0x0 0x0 0x90000000>,
     <&dwc3_0 0x0 0xf0000000 0xffffffff 0x10000000>;
 };


 usb2_phy0: hsphy@88e3000 {
  compatible = "qcom,usb-hsphy-snps-femto";
  reg = <0x88e3000 0x114>,
   <0x088e2000 0x4>;
  reg-names = "hsusb_phy_base",
   "eud_enable_reg";

  vdd-supply = <&L10C>;
  vdda18-supply = <&L1C>;
  vdda33-supply = <&L2B>;
  qcom,vdd-voltage-level = <0 880000 880000>;

  clocks = <&rpmhcc 0>;
  clock-names = "ref_clk_src";

  resets = <&gcc 4>;
  reset-names = "phy_reset";
  qcom,param-override-seq =
   <0xe6 0x6c
    0x8b 0x70
    0x16 0x74>;
 };


