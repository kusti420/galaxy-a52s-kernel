  };

  gpu_gaming_bin: gpu_gaming_bin@1f5 {
   reg = <0x1f5 0x1>;
   bits = <5 1>;
  };

  gpu_model_bin: gpu_model_bin@1e9 {
   reg = <0x1e9 0x2>;
   bits = <5 8>;
  };

  tsens_chipinfo: tsens_chipinfo@4180 {
   reg = <0x4180 0x4>;
  };

  feat_conf_m7: feat_conf_m7@6020 {
   reg = <0x6020 0x4>;
  };

  feat_conf_m9: feat_conf_m9@6028 {
   reg = <0x6028 0x4>;
  };

  adsp_variant: adsp_variant@6020 {
   reg = <0x6022 0x1>;
   bits = <2 4>;
  };

  boot_config: boot_config@6070 {
   reg = <0x6070 0x4>;
  };
 };

 qfprom_sys: qfprom@0 {
  compatible = "qcom,qfprom-sys";

  nvmem-cells = <&feat_conf_m7>,
         <&feat_conf_m9>;
  nvmem-cell-names = "feat_conf_m7",
       "feat_conf_m9";
 };

 qcom,msm-cdsp-loader {
  compatible = "qcom,cdsp-loader";
  qcom,proc-img-to-load = "cdsp";
 };

 qcom,msm-adsprpc-mem {
  compatible = "qcom,msm-adsprpc-mem-region";
  memory-region = <&adsp_mem>;
  restrict-access;
 };

 qcom_ramoops {
  compatible = "qcom,ramoops";
  memory-region = <&ramoops_mem>;
  pmsg-size = <0x200000>;
  mem-type = <2>;
 };

 qcom,sps {
  compatible = "qcom,msm-sps-v1_7-4k";
  qcom,pipe-attr-ee;
 };

};

