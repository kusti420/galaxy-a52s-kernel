 usb1: hsusb@8c00000 {
  status = "disabled";
  compatible = "qcom,dwc-usb3-msm";
  reg = <0x8c00000 0x100000>;
  reg-names = "core_base";

  #address-cells = <2>;
  #size-cells = <2>;
  ranges;

  interrupts-extended = <&pdc 12 1>,
        <&intc 0 241 4>,
        <&pdc 13 1>;
  interrupt-names = "dp_hs_phy_irq", "pwr_event_irq",
    "dm_hs_phy_irq";
