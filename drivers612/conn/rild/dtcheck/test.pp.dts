   mx_pe_config1: mx-pe-config1 {
    temperature = <1>;
    hysteresis = <1>;
    type = "passive";
   };

   mx_pe_config2: mx-pe-config2 {
    temperature = <2>;
    hysteresis = <1>;
    type = "passive";
   };

   mx_pe_config3: mx-pe-config3 {
    temperature = <3>;
    hysteresis = <1>;
    type = "passive";
   };
  };

  cooling-maps {
   mx_pe_cdev_cpu4 {
    trip = <&mx_pe_config1>;
    cooling-device = <&cpu4_pause 0 1>;
   };

   mx_pe_cdev_cpu5 {
    trip = <&mx_pe_config1>;
    cooling-device = <&cpu5_pause 0 1>;
   };

   mx_pe_cdev_cpu6 {
    trip = <&mx_pe_config1>;
    cooling-device = <&cpu6_pause 0 1>;
   };

   mx_pe_cdev_cpu7 {
    trip = <&mx_pe_config1>;
    cooling-device = <&cpu7_pause 0 1>;
   };

   mx_pe_cdev_cdsp {
    trip = <&mx_pe_config1>;
    cooling-device = <&cdsp_sw 0 1>;
   };

   mx_pe_cdev_gpu {
    trip = <&mx_pe_config2>;
    cooling-device = <&msm_gpu 0 1>;
   };

   mx_pe_cdev_modem {
    trip = <&mx_pe_config3>;
    cooling-device = <&modem_tj 0 1>;
   };
  };
 };

 cx-pe {
  polling-delay-passive = <0>;
  polling-delay = <0>;
  thermal-sensors = <&cx_pe>;
  status = "disabled";
  trips {
   cx_pe_config1: cx-pe-config1 {
    temperature = <1>;
    hysteresis = <1>;
    type = "passive";
   };

   cx_pe_config2: cx-pe-config2 {
    temperature = <2>;
    hysteresis = <1>;
    type = "passive";
   };

   cx_pe_config3: cx-pe-config3 {
    temperature = <3>;
    hysteresis = <1>;
    type = "passive";
   };

   cx_pe_config4: cx-pe-config4 {
    temperature = <4>;
    hysteresis = <1>;
    type = "passive";
   };
  };

  cooling-maps {
   cx_pe_cdev_1 {
    trip = <&cx_pe_config1>;
