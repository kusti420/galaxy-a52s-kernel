&gcc {
 qcom,critical-devices = <&qupv3_se1_i2c>;
};

&qupv3_se1_i2c {
 #address-cells = <1>;
 #size-cells = <0>;
 status = "ok";

 pm8008i: pmic@8 {
  compatible = "qcom,pm8008";
  reg = <0x8>;

  interrupts-extended = <&tlmm 25 1>;
  reset-gpios = <&pm8350c_gpios 3 1>;

  vdd_l1_l2-supply = <&S8B>;
  vdd_l3_l4-supply = <&BOB>;
  vdd_l5-supply = <&S1B>;
  vdd_l6-supply = <&BOB>;
  vdd_l7-supply = <&BOB>;

  pinctrl-names = "default";
  pinctrl-0 = <&pm8008i_int_default>, <&pm8008i_reset_n_default>;

  gpio-controller;
  #gpio-cells = <2>;
  gpio-ranges = <&pm8008i 0 0 2>;

  interrupt-controller;
  #interrupt-cells = <2>;

  #thermal-sensor-cells = <0>;

  regulators {
   L1I: pm8008i_l1: ldo1 {
    regulator-name = "pm8008i_l1";
    regulator-min-microvolt = <1000000>;
    regulator-max-microvolt = <1200000>;
    regulator-allow-set-load;
   };

   L2I: pm8008i_l2: ldo2 {
    regulator-name = "pm8008i_l2";
    regulator-min-microvolt = <952000>;
    regulator-max-microvolt = <1200000>;
    regulator-allow-set-load;
   };

   L3I: pm8008i_l3: ldo3 {
    regulator-name = "pm8008i_l3";
    regulator-min-microvolt = <2704000>;
    regulator-max-microvolt = <3000000>;
    regulator-allow-set-load;
   };

   L4I: pm8008i_l4: ldo4 {
    regulator-name = "pm8008i_l4";
    regulator-min-microvolt = <2704000>;
    regulator-max-microvolt = <2896000>;
    regulator-allow-set-load;
   };

   L5I: pm8008i_l5: ldo5 {
    regulator-name = "pm8008i_l5";
    regulator-min-microvolt = <1704000>;
    regulator-max-microvolt = <1896000>;
    regulator-allow-set-load;
   };

   L6I: pm8008i_l6: ldo6 {
    regulator-name = "pm8008i_l6";
    regulator-min-microvolt = <2704000>;
    regulator-max-microvolt = <2896000>;
    regulator-allow-set-load;
   };

   L7I: pm8008i_l7: ldo7 {
    regulator-name = "pm8008i_l7";
    regulator-min-microvolt = <2704000>;
    regulator-max-microvolt = <3000000>;
    regulator-allow-set-load;
   };
  };
 };


 pm8008j: pmic@c {
  compatible = "qcom,pm8008";
  reg = <0xc>;

  interrupts-extended = <&tlmm 24 1>;
  reset-gpios = <&pm8350c_gpios 4 1>;

  vdd_l1_l2-supply = <&S8B>;
  vdd_l3_l4-supply = <&S1B>;
  vdd_l5-supply = <&BOB>;
  vdd_l6-supply = <&BOB>;
  vdd_l7-supply = <&BOB>;

  pinctrl-names = "default";
  pinctrl-0 = <&pm8008j_int_default>, <&pm8008j_reset_n_default>;

  gpio-controller;
  #gpio-cells = <2>;
  gpio-ranges = <&pm8008j 0 0 2>;

  interrupt-controller;
  #interrupt-cells = <2>;

  #thermal-sensor-cells = <0>;

  regulators {
   L1J: pm8008j_l1: ldo1 {
    regulator-name = "pm8008j_l1";
    regulator-min-microvolt = <952000>;
    regulator-max-microvolt = <1200000>;
    regulator-allow-set-load;
   };

   L2J: pm8008j_l2: ldo2 {
    regulator-name = "pm8008j_l2";
    regulator-min-microvolt = <952000>;
    regulator-max-microvolt = <1248000>;
    regulator-allow-set-load;
   };

   L3J: pm8008j_l3: ldo3 {
    regulator-name = "pm8008j_l3";
    regulator-min-microvolt = <1504000>;
    regulator-max-microvolt = <1800000>;
    regulator-allow-set-load;
   };

   L4J: pm8008j_l4: ldo4 {
    regulator-name = "pm8008j_l4";
    regulator-min-microvolt = <1504000>;
    regulator-max-microvolt = <1600000>;
    regulator-allow-set-load;
   };

   L5J: pm8008j_l5: ldo5 {
    regulator-name = "pm8008j_l5";
    regulator-min-microvolt = <1504000>;
    regulator-max-microvolt = <2896000>;
    regulator-allow-set-load;
   };

   L6J: pm8008j_l6: ldo6 {
    regulator-name = "pm8008j_l6";
    regulator-min-microvolt = <2800000>;
    regulator-max-microvolt = <2800000>;
    regulator-allow-set-load;
   };

   L7J: pm8008j_l7: ldo7 {
    regulator-name = "pm8008j_l7";
    regulator-min-microvolt = <3000000>;
    regulator-max-microvolt = <3400000>;
    regulator-allow-set-load;
   };
  };
 };
};

&pm7325_tz {
 io-channels = <&pmk8350_vadc (1 << 8 | 0x03)>;
 io-channel-names = "thermal";
};

&pmr735a_tz {
 io-channels = <&pmk8350_vadc (4 << 8 | 0x03)>;
 io-channel-names = "thermal";
};

&soc {
 reboot_reason {
  compatible = "qcom,reboot-reason";
  nvmem-cells = <&restart_reason>;
