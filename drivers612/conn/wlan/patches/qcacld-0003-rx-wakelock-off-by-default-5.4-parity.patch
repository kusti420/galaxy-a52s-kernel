a52sxq: qcacld: RX wakelock off by default (5.4 parity; it hard-woke every suspend)

--- a/core/hdd/inc/hdd_dp_cfg.h	2026-11-22 12:09:04.074205537 +0200
+++ b/core/hdd/inc/hdd_dp_cfg.h	2026-11-22 12:09:18.729741513 +0200
@@ -1233,7 +1233,7 @@
  * rx_wakelock_timeout - Amount of time to hold wakelock for RX unicast packets
  * @Min: 0
  * @Max: 100
- * @Default: 50
+ * @Default: 0 (a52sxq; upstream 50)
  *
  * This ini item configures the amount of time, in milliseconds, that the driver
  * should prevent system power collapse after receiving an RX unicast packet.
@@ -1247,9 +1247,16 @@
  *
  * </ini>
  */
+/*
+ * a52sxq (2026-11-22, AOD suspend loop on the daily phone): the ROM's 5.4 qcacld has no RX wakelock,
+ * and its WCNSS_qcom_cfg.ini does not set rx_wakelock_timeout, so this build took the 50 ms default:
+ * every unicast/ARP RX packet called qdf_wake_lock_timeout_acquire() = pm_wakeup_ws_event(.., hard)
+ * = pm_system_wakeup(), which aborted each suspend attempt (off-cable trace: 48262 of the s2idle
+ * wake calls). Default 0 = the feature off = 5.4 behaviour; an ini value still overrides it.
+ */
 #define CFG_DP_RX_WAKELOCK_TIMEOUT \
 	CFG_INI_UINT("rx_wakelock_timeout", \
-	0, 100, 50, CFG_VALUE_OR_DEFAULT, \
+	0, 100, 0, CFG_VALUE_OR_DEFAULT, \
 	"Amount of time to hold wakelock for RX unicast packets")
 
 /*
