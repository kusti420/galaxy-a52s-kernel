+#ifdef CONFIG_SEC
+/*
+ * Samsung: publish the driver state, version string and soft AP capabilities
+ * in /sys/wifi/{qcwlanstate,wifiver,softap} (kept by icnss2). Formats are
+ * the SM-A528B 5.4 driver's.
+ */
+static void hdd_sec_sysfs_update_driver_status(struct hdd_context *hdd_ctx,
+					       int32_t status)
+{
+	char *version, *softap;
+	int max_station = 0;
+
+	if (status != DRIVER_MODULES_ENABLED) {
+		cnss_sysfs_update_driver_status(status, NULL, NULL);
+		return;
+	}
+
+	version = qdf_mem_malloc(512);
+	softap = qdf_mem_malloc(512);
+	if (!version || !softap)
+		goto free;
+
+	ucfg_mlme_get_sap_max_peers(hdd_ctx->psoc, &max_station);
+	scnprintf(version, 512,
+		  "HostSW: %s, FW: %d.%d.%d.%d.%d.%d, HW: WCN6750, "
+		  "BoardVersion: %x RefdesignID: %x CustomerID: %x "
+		  "ProjectID: %x BoardDataRev: %x\n",
+		  QWLAN_VERSIONSTR,
+		  hdd_ctx->fw_version_info.major_spid,
+		  hdd_ctx->fw_version_info.minor_spid,
+		  hdd_ctx->fw_version_info.siid,
+		  hdd_ctx->fw_version_info.rel_id,
+		  hdd_ctx->fw_version_info.crmid,
+		  hdd_ctx->fw_version_info.sub_id,
+		  hdd_ctx->hw_bd_info.bdf_version,
+		  hdd_ctx->hw_bd_info.ref_design_id,
+		  hdd_ctx->hw_bd_info.customer_id,
+		  hdd_ctx->hw_bd_info.project_id,
+		  hdd_ctx->hw_bd_info.board_data_rev);
+	scnprintf(softap, 512,
+		  "#softap.info\nDualBandConcurrency=%s\n5G=%s\nmaxClient=%d\n"
+		  "HalFn_setCountryCodeHal=%s\nHalFn_getValidChannels=%s\n"
+		  "DualInterface=%s\n",
+		  policy_mgr_is_hw_dbs_capable(hdd_ctx->psoc) ? "yes" : "no",
+		  hdd_is_5g_supported(hdd_ctx) ? "yes" : "no",
+		  max_station, "yes", "yes", "yes");
+	cnss_sysfs_update_driver_status(status, version, softap);
+free:
+	qdf_mem_free(version);
+	qdf_mem_free(softap);
+}
+#else
+static inline void
+hdd_sec_sysfs_update_driver_status(struct hdd_context *hdd_ctx, int32_t status)
+{
+}
+#endif
