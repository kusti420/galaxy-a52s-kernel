+/*
+ * a52sxq 6.12: gpiod_free() drops a pinctrl module reference and a gpio_device reference even
+ * when the line is not requested (5.4 only when it really freed a line). bluetooth_power() freed
+ * the reset and debug GPIOs whenever their numbers were valid (power 0 after retention 2, a
+ * failed request at power on, a debug GPIO that was never asserted): each such free leaked one
+ * reference of pinctrl_yupik. Free only what this driver holds.
+ */
+static bool bt_rst_gpio_held;
+static bool bt_dbg_gpio_held;
 static int pwr_state;
 static struct class *bt_class;
 static int bt_major;
@@ -421,6 +430,7 @@
 					__func__, bt_reset_gpio, rc);
 			return rc;
 		}
