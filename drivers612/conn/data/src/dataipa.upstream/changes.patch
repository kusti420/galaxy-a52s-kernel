--- a/drivers/platform/msm/Kbuild
+++ b/drivers/platform/msm/Kbuild
@@ -2,17 +2,18 @@
 DATAIPADRVTOP = $(srctree)/techpack/dataipa/drivers/platform/msm
 
 #MSMs - GKI
+# a52sxq: lahaina on KERNEL.PLATFORM.5.0 (GKI 6.12 + soc-repo) is built out of tree like the
+# vendor-SI targets; the 5.4 in-tree path $(srctree)/techpack/dataipa and the QGKI config do
+# not exist there. Same headers/config the bazel perf variant uses (perf_config_headers +
+# perf_defconfig = dataipa_vendor.h + dataipa_GKI.conf); ipatestm is consolidate-only in bazel.
 ifeq ($(CONFIG_ARCH_LAHAINA), y)
-LINUXINCLUDE    += -include $(srctree)/techpack/dataipa/config/dataipa.h
-ifeq ($(CONFIG_QGKI),y)
-include $(srctree)/techpack/dataipa/config/dataipa_QGKI.conf
-ifeq ($(CONFIG_LOCALVERSION), "-qgki-debug")
-include $(srctree)/techpack/dataipa/config/dataipa_debug.conf
-LINUXINCLUDE    += -include $(srctree)/techpack/dataipa/config/dataipa_debug.h
-endif
-else
-include $(srctree)/techpack/dataipa/config/dataipa_GKI.conf
-endif
+DATAIPADRVTOP := $(abspath $(src))
+DATAIPATOP := $(abspath $(src)/../../..)
+LINUXINCLUDE    += -include $(DATAIPATOP)/config/dataipa_vendor.h
+include $(DATAIPATOP)/config/dataipa_GKI.conf
+export CONFIG_IPA_KERNEL_TESTS_MODULE=
+# ipam_local_defines of define_modules.bzl for every target but niobe/seraph
+LINUXINCLUDE    += -DCONFIG_IPA_RMNET_MEM=1
 endif
 
 #MSM - Vendor SI
--- a/drivers/platform/msm/ipa/ipa_v3/ipa_dp.c
+++ b/drivers/platform/msm/ipa/ipa_v3/ipa_dp.c
@@ -6568,6 +6568,15 @@
 				napi_schedule(&tx_pkt->sys->napi_tx);
 			}
 		} else if (ipa_net_initialized && sys->napi_tx_enable) {
+			/*
+			 * a52sxq: the NAPI poll (ipa3_aux_napi_tx_complete ->
+			 * ipa3_napi_tx_complete) only completes packets while
+			 * xmit_eot_cnt > 0, but r30 increments it only on the
+			 * tasklet path. With qcom,tx-napi and no qcom,tx-poll
+			 * (every 5.4 yupik tree) no WAN_PROD/LAN_PROD skb was
+			 * ever completed. Count the EOT as 5.4 did.
+			 */
+			atomic_inc(&tx_pkt->sys->xmit_eot_cnt);
 			if(!atomic_cmpxchg(&tx_pkt->sys->in_napi_context, 0, 1))
 				napi_schedule(&tx_pkt->sys->napi_tx);
 		} else {
