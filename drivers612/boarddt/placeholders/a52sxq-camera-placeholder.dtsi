		compatible = "qcom,cam-sensor";
		csiphy-sd-index = <0x3>;
		sensor-position-roll = <0x5a>;
		sensor-position-pitch = <0x0>;
		sensor-position-yaw = <0xb4>;
		led-flash-src = <&led_flash_rear>;
		eeprom-src = <&eeprom4>;
		cam_vdig-supply = <&s2mpb03_0_l4>;
		cam_vio-supply = <&s2mpb03_0_l3>;
		cam_clk-supply = <&cam_cc_titan_top_gdsc>;
		regulator-names = "cam_vdig", "cam_vio", "cam_clk";
		rgltr-cntrl-support;
		rgltr-min-voltage = <0x124f80 0x1b7740 0x0>;
		rgltr-max-voltage = <0x124f80 0x1b7740 0x0>;
		rgltr-load-current = <0x30d40 0x30d40 0x0>;
		gpio-no-mux = <0x0>;
		use-shared-clk;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_active_mclk4 &cam_sensor_active_rst4 &cam_sensor_active_vana1 &cam_flash_active>;
		pinctrl-1 = <&cam_sensor_suspend_mclk4 &cam_sensor_suspend_rst4 &cam_sensor_suspend_vana1 &cam_flash_suspend>;
		gpios = <&tlmm 0x43 0x0 &tlmm 0x4e 0x0 &tlmm 0xe 0x0>;
		gpio-reset = <0x1>;
		gpio-vana = <0x2>;
		gpio-req-tbl-num = <0x0 0x1 0x2>;
		gpio-req-tbl-flags = <0x1 0x0 0x0>;
		gpio-req-tbl-label = "CAMIF_MCLK3", "CAM_RESET3", "CAM_VANA1";
		sensor-mode = <0x0>;
		cci-device = <0x1>;
		cci-master = <0x0>;
		status = "ok";
		clocks = <&camcc 0x62>;
		clock-names = "cam_clk";
		clock-cntl-level = "turbo";
		clock-rates = <0x16e3600>;
		cam,isp = <0x0>;
		cam,cal_memory = <0x2>;
		cam,read_version = <0x0>;
		cam,core_voltage = <0x0>;
		cam,upgrade = <0x0>;
		cam,fw_write = <0x0>;
		cam,fw_dump = <0x0>;
		cam,companion_chip = <0x0>;
		cam,ois = <0x0>;
		cam,dual_open = <0x0>;
		cam,valid = <0x1>;
	};

	eeprom0: qcom,eeprom@50 {
		cell-index = <0x0>;
		reg = <0x50>;
		compatible = "qcom,eeprom";
		i2c-freq-mode = <0x1>;
		cam_vaf-supply = <&s2mpb03_0_l7>;
		cam_vio-supply = <&s2mpb03_0_l3>;
