		sensor-position-yaw = <0xb4>;
		actuator-src = <&actuator_rear0>;
		eeprom-src = <&eeprom0>;
		ois-src = <&ois_rear>;
		led-flash-src = <&led_flash_rear>;
		cam_vdig-supply = <&s2mpb03_0_l2>;
		cam_vio-supply = <&s2mpb03_0_l3>;
		cam_vana-supply = <&s2mpb03_0_l5>;
		cam_vaf-supply = <&s2mpb03_0_l7>;
		cam_clk-supply = <&cam_cc_titan_top_gdsc>;
		regulator-names = "cam_vdig", "cam_vio", "cam_vana", "cam_vaf", "cam_clk";
		rgltr-cntrl-support;
		rgltr-min-voltage = <0x10c8e0 0x1b7740 0x2ab980 0x2ab980 0x0>;
		rgltr-max-voltage = <0x10c8e0 0x1b7740 0x2ab980 0x2ab980 0x0>;
		rgltr-load-current = <0x30d40 0x30d40 0x1388 0x30d40 0x0>;
		gpio-no-mux = <0x0>;
		use-shared-clk;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&cam_sensor_active_mclk0 &cam_sensor_active_rst0 &cam_flash_active>;
		pinctrl-1 = <&cam_sensor_suspend_mclk0 &cam_sensor_suspend_rst0 &cam_flash_suspend>;
		gpios = <&tlmm 0x40 0x0 &tlmm 0x14 0x0 &tlmm 0xb 0x0>;
		gpio-reset = <0x1>;
		gpio-vana = <0x2>;
		gpio-req-tbl-num = <0x0 0x1 0x2>;
		gpio-req-tbl-flags = <0x1 0x0 0x0>;
		gpio-req-tbl-label = "CAMIF_MCLK0", "CAM_RESET0", "CAM_VANA0";
		sensor-mode = <0x0>;
		cci-master = <0x0>;
		status = "ok";
		clocks = <&camcc 0x5c>;
		clock-names = "cam_clk";
		clock-cntl-level = "turbo";
		clock-rates = <0x124f800>;
		cam,isp = <0x0>;
		cam,cal_memory = <0x2>;
		cam,read_version = <0x1>;
		cam,core_voltage = <0x1>;
		cam,upgrade = <0x2>;
		cam,fw_write = <0x3>;
		cam,fw_dump = <0x1>;
		cam,companion_chip = <0x0>;
		cam,ois = <0x1>;
		cam,dual_open = <0x0>;
		cam,valid = <0x1>;
	};
};

