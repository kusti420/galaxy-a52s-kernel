			};

			L2J: pm8008j_l2: regulator@4100 {
				reg = <0x4100>;
				regulator-name = "pm8008j_l2";
				regulator-min-microvolt = <0xe7ef0>;
				regulator-max-microvolt = <0x1312d0>;
				qcom,min-dropout-voltage = <0x5dc0>;
				qcom,hpm-min-load = <0x0>;
			};

			L3J: pm8008j_l3: regulator@4200 {
				reg = <0x4200>;
				regulator-name = "pm8008j_l3";
				regulator-min-microvolt = <0x164720>;
				regulator-max-microvolt = <0x1b7740>;
				qcom,min-dropout-voltage = <0x36b00>;
				qcom,hpm-min-load = <0x0>;
			};

			L4J: pm8008j_l4: regulator@4300 {
				reg = <0x4300>;
