&qupv3_se4_i2c {

	ois_rear: qcom,ois@62 {
		compatible = "qcom,ois";
		cell-index = <0x0>;
		reg = <0x51>;
		slave-addr = <0xc4>;
		slave-id = <0x456>;
		pole-values = <0x0 0x1 0x0 0x0 0x0 0x0>;
		gyro-orientation = <0x0>;
		cam_vio-supply = <&pm8350c_l2>;
		cam_vaf-supply = <&s2mpb03_0_l7>;
		regulator-names = "cam_vio", "cam_vaf";
		rgltr-cntrl-support;
		rgltr-min-voltage = <0x1b7740 0x2ab980>;
		rgltr-max-voltage = <0x1b7740 0x2ab980>;
		rgltr-load-current = <0x30d40 0x30d40>;
		qcom,cam-power-seq-type = "cam_vana", "cam_vaf", "cam_vio", "cam_reset";
		qcom,cam-power-seq-cfg-val = <0x1 0x1 0x1 0x1>;
		qcom,cam-power-seq-delay = <0x1 0x1 0x1 0xa>;
		pinctrl-names = "cam_default", "cam_suspend";
		pinctrl-0 = <&mcu_active>;
		pinctrl-1 = <&mcu_suspend>;
		gpio-no-mux = <0x0>;
		gpios = <&tlmm 0x2d 0x0 &tlmm 0xb 0x0 &tlmm 0x2e 0x0>;
		gpio-reset = <0x0>;
		gpio-vana = <0x1>;
		gpio-custom1 = <0x2>;
		gpio-req-tbl-num = <0x0 0x1 0x2>;
		gpio-req-tbl-flags = <0x0 0x0 0x0>;
		gpio-req-tbl-label = "MCU_RESET0", "MCU_VANA", "MCU_BOOT0";
		status = "ok";
	};
};

