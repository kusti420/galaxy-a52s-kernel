		clocks = <&clock_audio_tx_1 0x0 &clock_audio_tx_2 0x0 &clock_audio_rx_1 0x0 &clock_audio_rx_2 0x0 &clock_audio_wsa_1 0x0 &clock_audio_wsa_2 0x0 &clock_audio_va_1 0x0 &clock_audio_va_2 0x0>;
	};

	va_macro: va-macro@3370000 {
		compatible = "qcom,va-macro";
