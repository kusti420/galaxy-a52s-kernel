&yupik_snd {	/* TODO-binding: label not in the 6.12 base, placeholder */
	qcom,model = "lahaina-yupikidp-snd-card";
	qcom,msm-mi2s-master = <0x1 0x1 0x1 0x1 0x1 0x1>;
	qcom,tdm-max-slots = <0x8>;
	qcom,wcd-disabled = <0x0>;
	qcom,audio-routing = "AMIC1", "Analog Mic1", "Analog Mic1", "MIC BIAS1", "AMIC2", "Analog Mic2", "Analog Mic2", "MIC BIAS2", "AMIC3", "Analog Mic3", "Analog Mic3", "MIC BIAS1", "AMIC4", "Analog Mic4", "Analog Mic4", "MIC BIAS3", "IN1_HPHL", "HPHL_OUT", "IN2_HPHR", "HPHR_OUT", "RX_TX DEC0_INP", "TX DEC0 MUX", "RX_TX DEC1_INP", "TX DEC1 MUX", "RX_TX DEC2_INP", "TX DEC2 MUX", "RX_TX DEC3_INP", "TX DEC3 MUX", "TX SWR_INPUT", "WCD_TX_OUTPUT", "VA SWR_INPUT", "VA_SWR_CLK", "VA SWR_INPUT", "WCD_TX_OUTPUT", "VA_AIF1 CAP", "VA_SWR_CLK", "VA_AIF2 CAP", "VA_SWR_CLK", "VA_AIF3 CAP", "VA_SWR_CLK";
	qcom,msm-mbhc-hphl-swh = <0x1>;
	qcom,msm-mbhc-gnd-swh = <0x1>;
	qcom,swr-dmic-max-devs = <0x0>;
	qcom,cdc-dmic01-gpios;
	qcom,cdc-dmic23-gpios;
	qcom,cdc-dmic45-gpios;
	qcom,sec-mi2s-gpios;
	asoc-codec = <&stub_codec &bolero &wcd938x_codec>;
	asoc-codec-names = "msm-stub-codec.1", "bolero_codec", "wcd938x_codec";
	qcom,wsa-max-devs = <0x0>;
	qcom,cps_reg_phy_addr = <0x3250300 0x3250304 0x3250318>;
	qcom,cps_wsa_vbatt_temp_reg_addr = <0x3429 0x3422>;
	qcom,cps_threshold_levels = <0x94 0xa8>;
	qcom,cps_normal_values = <0x8e 0x8f 0x8f>;
	qcom,cps_lower1_values = <0x10 0xd0 0xd0>;
	qcom,cps_lower2_values = <0xf 0xf 0x18>;
	qcom,msm_audio_ssr_devs = <&audio_apr &q6core &lpi_tlmm &bolero>;
	qcom,ext-disp-audio-rx = <0x0>;
	asoc-platform = <&pcm0 &pcm1 &pcm2 &voip &voice &loopback &compress &hostless &afe &lsm &routing &compr &pcm_noirq &samsung_q6audio_adaptation>;
	asoc-platform-names = "msm-pcm-dsp.0", "msm-pcm-dsp.1", "msm-pcm-dsp.2", "msm-voip-dsp", "msm-pcm-voice", "msm-pcm-loopback", "msm-compress-dsp", "msm-pcm-hostless", "msm-pcm-afe", "msm-lsm-client", "msm-pcm-routing", "msm-compr-dsp", "msm-pcm-dsp-noirq", "q6audio-adaptation";
	qcom,msm-mbhc-hs-mic-max-threshold-mv = <0x270f>;
	qcom,msm-mbhc-hs-mic-min-threshold-mv = <0x280>;
	qcom,quin-mi2s-gpios = <&cdc_quin_mi2s_gpios>;
	fsa4480-i2c-handle;
	qcom,msm-mbhc-gnd-det = <0x1>;
};

&va_cdc_dma_0_tx {	/* TODO-binding: label not in the 6.12 base, placeholder */
	qcom,msm-dai-is-island-supported = <0x1>;
};

&soc {

	wsa_spkr_en1: wsa_spkr_en1_pinctrl {
		compatible = "qcom,msm-cdc-pinctrl";
		pinctrl-names = "aud_active", "aud_sleep";
		pinctrl-0 = <&spkr_1_sd_n_active>;
		pinctrl-1 = <&spkr_1_sd_n_sleep>;
		status = "disabled";
	};

	wsa_spkr_en2: wsa_spkr_en2_pinctrl {
		compatible = "qcom,msm-cdc-pinctrl";
		pinctrl-names = "aud_active", "aud_sleep";
		pinctrl-0 = <&spkr_2_sd_n_active>;
		pinctrl-1 = <&spkr_2_sd_n_sleep>;
		status = "disabled";
	};

	wcd93xx_rst_gpio: msm_cdc_pinctrl@83 {
		compatible = "qcom,msm-cdc-pinctrl";
		pinctrl-names = "aud_active", "aud_sleep";
		pinctrl-0 = <&wcd93xx_reset_active>;
		pinctrl-1 = <&wcd93xx_reset_sleep>;
	};

	clock_audio_wsa_1: wsa_core_clk {
		compatible = "qcom,audio-ref-clk";
		qcom,codec-ext-clk-src = <0x3>;
		qcom,codec-lpass-ext-clk-freq = <0x124f800>;
		qcom,codec-lpass-clk-id = <0x309>;
		#clock-cells = <0x1>;
	};

	clock_audio_wsa_2: wsa_npl_clk {
		compatible = "qcom,audio-ref-clk";
		qcom,codec-ext-clk-src = <0x4>;
		qcom,codec-lpass-ext-clk-freq = <0x124f800>;
		qcom,codec-lpass-clk-id = <0x30a>;
		#clock-cells = <0x1>;
	};

	clock_audio_rx_1: rx_core_clk {
		compatible = "qcom,audio-ref-clk";
		qcom,codec-ext-clk-src = <0x5>;
		qcom,codec-lpass-ext-clk-freq = <0x1588800>;
		qcom,codec-lpass-clk-id = <0x30e>;
		#clock-cells = <0x1>;
	};

	clock_audio_rx_2: rx_npl_clk {
		compatible = "qcom,audio-ref-clk";
		qcom,codec-ext-clk-src = <0x6>;
		qcom,codec-lpass-ext-clk-freq = <0x1588800>;
		qcom,codec-lpass-clk-id = <0x30f>;
		#clock-cells = <0x1>;
	};

	clock_audio_tx_1: tx_core_clk {
		compatible = "qcom,audio-ref-clk";
		qcom,codec-ext-clk-src = <0x7>;
		qcom,codec-lpass-ext-clk-freq = <0x124f800>;
		qcom,codec-lpass-clk-id = <0x30c>;
		#clock-cells = <0x1>;
	};

	clock_audio_tx_2: tx_npl_clk {
		compatible = "qcom,audio-ref-clk";
		qcom,codec-ext-clk-src = <0x8>;
		qcom,codec-lpass-ext-clk-freq = <0x124f800>;
		qcom,codec-lpass-clk-id = <0x30d>;
		#clock-cells = <0x1>;
	};

	clock_audio_va_1: va_core_clk {
		compatible = "qcom,audio-ref-clk";
		qcom,codec-ext-clk-src = <0x2>;
		qcom,codec-lpass-ext-clk-freq = <0x124f800>;
		qcom,codec-lpass-clk-id = <0x30b>;
		#clock-cells = <0x1>;
	};

	clock_audio_va_2: va_npl_clk {
		compatible = "qcom,audio-ref-clk";
		qcom,codec-ext-clk-src = <0xa>;
		qcom,codec-lpass-ext-clk-freq = <0x124f800>;
		qcom,codec-lpass-clk-id = <0x310>;
		#clock-cells = <0x1>;
	};

	sec-audio-sysfs {
		compatible = "samsung,audio-sysfs";
		status = "okay";
		audio,num-amp = <0x2>;
	};

	samsung_q6audio_adaptation: samsung,q6audio-adaptation {
		compatible = "samsung,q6audio-adaptation";
		adaptation,device-tx-port-id = <0xb037>;
		adaptation,spk-rx-port-id = <0x1016>;
		adaptation,usb-rx-port-id = <0x7000>;
		adaptation,bt-rx-port-id = <0x400e>;
		adaptation,headset-rx-port-id = <0xb030>;
	};
};

&q6core {	/* TODO-binding: label not in the 6.12 base, placeholder */

	cdc_sec_mi2s_gpios: msm_cdc_pinctrl_sec {
		compatible = "qcom,msm-cdc-pinctrl";
		pinctrl-names = "aud_active", "aud_sleep";
		pinctrl-0 = <&sec_mi2s_sck_active &sec_mi2s_ws_active &sec_mi2s_sd0_active>;
		pinctrl-1 = <&sec_mi2s_sck_sleep &sec_mi2s_ws_sleep &sec_mi2s_sd0_sleep>;
		#gpio-cells = <0x0>;
		status = "disabled";
	};

	cdc_quin_mi2s_gpios: msm_cdc_pinctrl_quin {
		compatible = "qcom,msm-cdc-pinctrl";
		pinctrl-names = "aud_active", "aud_sleep";
		pinctrl-0 = <&lpi_i2s1_sck_active &lpi_i2s1_ws_active &lpi_i2s1_sd0_active &lpi_i2s1_sd1_active>;
		pinctrl-1 = <&lpi_i2s1_sck_sleep &lpi_i2s1_ws_sleep &lpi_i2s1_sd0_sleep &lpi_i2s1_sd1_sleep>;
		qcom,lpi-gpios;
		#gpio-cells = <0x0>;
	};
};

&dai_mi2s1_rx {	/* TODO-binding: label not in the 6.12 base, placeholder */
	qcom,msm-mi2s-lines = <0x0>;
};

&dai_mi2s1_tx {	/* TODO-binding: label not in the 6.12 base, placeholder */
	qcom,msm-mi2s-lines = <0x1>;
};

&adsp_loader {	/* TODO-binding: label not in the 6.12 base, placeholder */
	nvmem-cells = <&adsp_variant>;
	nvmem-cell-names = "adsp_variant";
	adsp-fw-names = "adsp2";
	adsp-fw-bit-values = <0x4>;
};

&qupv3_se1_i2c {

	tas256x: tas256x@4c {
		status = "ok";
		#sound-dai-cells = <0x0>;
		compatible = "ti, tas256x";
		pinctrl-names = "default";
		pinctrl-0 = <&tas25xx_gpio_default>;
		reg = <0x4c>;
		ti,reset-gpio = <&tlmm 0x3f 0x0>;
		ti,irq-gpio = <&tlmm 0x37 0x0>;
		ti,left-channel = <0x4d>;
		ti,right-channel = <0x4c>;
		ti,channels = <0x2>;
		ti,iv-width = <0x8>;
		ti,vbat-mon = <0x1>;
		ti,port_id = <0x1016>;
		ti,module_id_rx = <0x1000fc00>;
		ti,module_id_tx = <0x1000fd00>;
	};
};

&dai_mi2s4_rx {	/* TODO-binding: label not in the 6.12 base, placeholder */
	qcom,msm-mi2s-lines = <0x2>;
};

&dai_mi2s4_tx {	/* TODO-binding: label not in the 6.12 base, placeholder */
	qcom,msm-mi2s-lines = <0x1>;
};

&fsa4480 {
	status = "disabled";
};

&wsa_swr_gpios {	/* TODO-binding: label not in the 6.12 base, placeholder */
	status = "disabled";
};

&lpi_tlmm {	/* TODO-binding: label not in the 6.12 base, placeholder */

	lpi_i2s1_sck {

		lpi_i2s1_sck_active: lpi_i2s1_sck_active {

			config {
				drive-strength = <0x4>;
			};
		};
	};

	lpi_i2s1_ws {

		lpi_i2s1_ws_active: lpi_i2s1_ws_active {

			config {
				drive-strength = <0x4>;
			};
		};
	};

	lpi_i2s1_sd0 {

		lpi_i2s1_sd0_active: lpi_i2s1_sd0_active {

			config {
				drive-strength = <0x4>;
			};
		};
	};

	lpi_i2s1_sd1 {

		lpi_i2s1_sd1_active: lpi_i2s1_sd1_active {

			config {
				drive-strength = <0x4>;
			};
		};
	};
};

