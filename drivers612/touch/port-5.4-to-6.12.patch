 int stm_ts_probe(struct stm_ts_data *ts)
 {
 	int ret = 0;
 #if IS_MODULE(CONFIG_TOUCHSCREEN_STM) || IS_MODULE(CONFIG_TOUCHSCREEN_STM_SPI)
 	static int deferred_flag = 0;
 
+	/*
+	 * a52sxq 6.12: the 5.4 driver always failed its first probe with -EPROBE_DEFER.
+	 * A deferred device is only retried when some other driver binds afterwards, so
+	 * on a quiet system (test ramdisk, late insmod) the touchscreen would never probe.
+	 * The deferral is now opt-in: stm_ts.defer_first_probe=1 restores the 5.4 behaviour.
+	 */
+	if (!defer_first_probe)
+		deferred_flag = 1;
+
 	if (!deferred_flag) {
 		deferred_flag = 1;
 		input_info(true, &ts->client->dev, "deferred_flag boot %s\n", __func__);
