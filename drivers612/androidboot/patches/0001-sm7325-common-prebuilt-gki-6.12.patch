@@ -55,14 +55,31 @@
 TARGET_2ND_CPU_VARIANT_RUNTIME := kryo385
 
 # Kernel config
+# Kernel: prebuilt Qualcomm 6.12 GKI Image + prebuilt vendor modules + prebuilt dtb/dtbo, staged
+# by a52sxq-mainline/drivers612/androidboot/export-prebuilt.sh into $(KERNEL_PREBUILT_DIR).
+# TARGET_KERNEL_SOURCE stays: it is no longer compiled (TARGET_FORCE_PREBUILT_KERNEL), but its
+# 5.4 UAPI headers are what generated_kernel_includes hands to the QCOM display/audio HAL
+# sources, and the forward-ported drivers keep exactly that UAPI for the closed blobs.
 TARGET_KERNEL_CLANG_VERSION := r563880c
 TARGET_KERNEL_SOURCE        := kernel/samsung/sm7325
 TARGET_KERNEL_ARCH          := arm64
 TARGET_KERNEL_HEADER_ARCH   := arm64
-TARGET_LINUX_KERNEL_VERSION := 5.4
+TARGET_LINUX_KERNEL_VERSION := 6.12
+KERNEL_PREBUILT_DIR         := device/samsung/a52sxq-kernel/6.12
+TARGET_FORCE_PREBUILT_KERNEL := true
+TARGET_PREBUILT_KERNEL      := $(KERNEL_PREBUILT_DIR)/Image
+BOARD_PREBUILT_DTBIMAGE_DIR := $(KERNEL_PREBUILT_DIR)/dtb
+BOARD_PREBUILT_DTBOIMAGE    := $(KERNEL_PREBUILT_DIR)/dtbo.img
 
 # Kernel flags
-BOARD_KERNEL_CMDLINE += console=null androidboot.hardware=qcom androidboot.memcg=1 lpm_levels.sleep_disabled=1 video=vfb:640x400,bpp=32,memsize=3072000 msm_rtb.filter=0x237 service_locator.enable=1 androidboot.usbcontroller=a600000.dwc3 swiotlb=0 loop.max_part=7 cgroup.memory=nokmem,nosocket firmware_class.path=/vendor/firmware_mnt/image pcie_ports=compat loop.max_part=7 iptable_raw.raw_before_defrag=1 ip6table_raw.raw_before_defrag=1
+# 6.12 GKI: dropped the 5.4-only options (lpm_levels.sleep_disabled, video=vfb, msm_rtb.filter,
+# service_locator.enable, pcie_ports=compat, iptable_raw.*) and swiotlb=0 (GKI's SWIOTLB is
+# needed by the restricted-dma/virtio paths; let the kernel size it). Boot header stays v3:
+# androidboot.* on the command line is still read by init (bootconfig is header v4 only, and
+# this bootloader predates v4). clk/pd/regulator_ignore_unused stay until every consumer of the
+# bootloader-enabled rails and clocks has a driver.
+BOARD_KERNEL_CMDLINE += console=null androidboot.hardware=qcom androidboot.memcg=1 androidboot.usbcontroller=a600000.dwc3 loop.max_part=7 cgroup.memory=nokmem,nosocket firmware_class.path=/vendor/firmware_mnt/image printk.devkmsg=on
+BOARD_KERNEL_CMDLINE += clk_ignore_unused pd_ignore_unused regulator_ignore_unused
 # IchthysOS: SELinux enforcing.  The remaining permissive-only denials (hal_power
 # writing sched_boost, hal_thermal reading amp temperature, keystore2 probing the
 # Samsung shared-secret HAL) are covered by device-specific sepolicy rules.
@@ -77,7 +94,8 @@
 BOARD_KERNEL_OFFSET          := 0x00008000
 BOARD_KERNEL_TAGS_OFFSET     := 0x01e00000
 BOARD_KERNEL_IMAGE_NAME      := Image
-BOARD_KERNEL_SEPARATED_DTBO  := true
+# dtbo.img is prebuilt (one a52sxq overlay on the 6.12 bindings); nothing to build from source
+BOARD_KERNEL_SEPARATED_DTBO  :=
 BOARD_INCLUDE_DTB_IN_BOOTIMG := true
 BOARD_RAMDISK_USE_LZ4        := true
 
@@ -91,8 +109,31 @@
 BOARD_MKBOOTIMG_ARGS += --board $(BOARD_NAME)
 BOARD_MKBOOTIMG_ARGS += --kernel_offset $(BOARD_KERNEL_OFFSET)
 
-# Kernel modules
-TARGET_MODULE_ALIASES += wlan.ko:qca_cld3_wlan.ko
+# Kernel modules (GKI): there is no vendor_dlkm partition on this phone (super holds system,
+# vendor, product, odm), so:
+#   first stage  = vendor_boot ramdisk /lib/modules, loaded by first-stage init in the order of
+#                  modules.load.first_stage (everything needed to reach super and userdata:
+#                  SMMU, clocks, RPMh, pinctrl, UFS + ICE, plus watchdog/restart-reason);
+#   second stage = /vendor/lib/modules, loaded by init.target.rc with modprobe --all=modules.load;
+#   recovery     = self-contained header-v2 image: first-stage set + touch/display in its ramdisk.
+# The lists are files in $(KERNEL_PREBUILT_DIR), written by export-prebuilt.sh.
+KERNEL_MODULE_DIR := $(KERNEL_PREBUILT_DIR)/modules
+BOARD_VENDOR_RAMDISK_KERNEL_MODULES_LOAD := $(strip $(shell cat $(KERNEL_PREBUILT_DIR)/modules.load.first_stage))
+BOARD_VENDOR_RAMDISK_KERNEL_MODULES      := $(addprefix $(KERNEL_MODULE_DIR)/,$(BOARD_VENDOR_RAMDISK_KERNEL_MODULES_LOAD))
+BOARD_VENDOR_RAMDISK_KERNEL_MODULES_BLOCKLIST_FILE := $(KERNEL_PREBUILT_DIR)/modules.blocklist
+BOARD_VENDOR_KERNEL_MODULES_LOAD         := $(strip $(shell cat $(KERNEL_PREBUILT_DIR)/modules.load.vendor))
+# /vendor/lib/modules carries EVERY module (first-stage ones too, as Qualcomm's vendor_dlkm
+# does), so its modules.dep is complete; only the second-stage ones are in its modules.load.
+BOARD_VENDOR_KERNEL_MODULES              := $(wildcard $(KERNEL_MODULE_DIR)/*.ko)
+BOARD_VENDOR_KERNEL_MODULES_BLOCKLIST_FILE := $(KERNEL_PREBUILT_DIR)/modules.blocklist
+BOARD_RECOVERY_KERNEL_MODULES_LOAD       := $(strip $(shell cat $(KERNEL_PREBUILT_DIR)/modules.load.recovery))
+BOARD_RECOVERY_KERNEL_MODULES            := $(addprefix $(KERNEL_MODULE_DIR)/,$(BOARD_RECOVERY_KERNEL_MODULES_LOAD))
+BOARD_RECOVERY_KERNEL_MODULES_BLOCKLIST_FILE := $(KERNEL_PREBUILT_DIR)/modules.blocklist
+# GKI modules are signed and must not be stripped (protected-symbol users lose their signature);
+# export-prebuilt.sh strips the vendor ones itself.
+BOARD_DO_NOT_STRIP_VENDOR_RAMDISK_MODULES := true
+BOARD_DO_NOT_STRIP_VENDOR_MODULES         := true
+BOARD_DO_NOT_STRIP_RECOVERY_MODULES       := true
 
 # Additional root folders
 TARGET_FS_CONFIG_GEN := $(COMMON_PATH)/config.fs
