+/*
+ * a52sxq: the 5.4 driver read ION_FLAG_SECURE from the ION buffer to route a
+ * secure buffer to the secure SMMU context bank. The 6.12 qcom heaps have no
+ * get_flags op (dma_buf_get_flags() then returns 0 flags), but every qcom
+ * heap buffer carries its VM permission list in mem-buf: a buffer that HLOS
+ * does not own exclusively (lent/assigned to a CP VMID by a qcom,secure-*
+ * heap, which is what ioncompat hands out for the 5.4 secure heap ids) is
+ * what 5.4 called ION_FLAG_SECURE.
+ */
+static inline int fastrpc_dma_buf_get_flags(struct dma_buf *buf,
+					    unsigned long *flags)
+{
+	int err = dma_buf_get_flags(buf, flags);
+
+	if (err)
+		return err;
+	if (is_mem_buf_dma_buf(buf) && !mem_buf_dma_buf_exclusive_owner(buf))
+		*flags |= ION_FLAG_SECURE;
+	return 0;
+}
