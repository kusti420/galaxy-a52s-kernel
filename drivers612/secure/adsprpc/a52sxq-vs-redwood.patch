+/*
+ * a52sxq: Samsung's 5.4 kernel honours qcom,secure-domains only when the
+ * bootloader passes signoff=0x2377 (early_param in adsprpc.c); on every
+ * other boot all domains stay reachable through /dev/adsprpc-smd. A module
+ * can't take an early_param, so the same value is a module parameter:
+ * frpc-adsprpc.signoff=0x2377 on the command line or at insmod.
+ */
+#define CDSP_SIGNOFF_BLOCK 0x2377
+static unsigned int signoff_val;
+module_param_named(signoff, signoff_val, uint, 0444);
+
+static unsigned int is_signoff_block(void)
+{
+	pr_info("adsprpc: signoff 0x%08x\n", signoff_val);
+	return signoff_val == CDSP_SIGNOFF_BLOCK;
+}
