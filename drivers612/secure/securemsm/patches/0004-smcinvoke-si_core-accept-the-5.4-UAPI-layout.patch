+/* Size in the caller's layout of an argument array that is 'sz' bytes in the kernel's. */
+static inline size_t smci_uargs_sz(size_t sz, bool legacy)
+{
+	return legacy ? sz / sizeof(union smcinvoke_arg) * sizeof(union smcinvoke_arg_legacy) : sz;
+}
+
+/*
+ * Argument arrays are ordered buffers first, then objects; 'nr_bufs' is where the objects start.
+ */
+static int smci_args_from_user(union smcinvoke_arg *a, const void __user *u, int nr,
+	int nr_bufs, bool legacy)
+{
+	union smcinvoke_arg_legacy l;
+	int i;
+
+	if (!legacy)
+		return copy_from_user(a, u, nr * sizeof(*a)) ? -EFAULT : 0;
+
+	for (i = 0; i < nr; i++) {
+		if (copy_from_user(&l, u + i * sizeof(l), sizeof(l)))
+			return -EFAULT;
+		memset(&a[i], 0, sizeof(a[i]));
+		if (i < nr_bufs) {
+			a[i].b = l.b;
+		} else {
+			a[i].o.fd = l.o.fd;
+			a[i].o.cb_server_fd = l.o.cb_server_fd;
+		}
+	}
+
+	return 0;
+}
+
+static int smci_args_to_user(void __user *u, const union smcinvoke_arg *a, int nr,
+	int nr_bufs, bool legacy)
+{
+	union smcinvoke_arg_legacy l;
+	int i;
+
+	if (!legacy)
+		return copy_to_user(u, a, nr * sizeof(*a)) ? -EFAULT : 0;
+
+	for (i = 0; i < nr; i++) {
+		memset(&l, 0, sizeof(l));
+		if (i < nr_bufs) {
+			l.b = a[i].b;
+		} else {
+			l.o.fd = a[i].o.fd;
+			l.o.cb_server_fd = (__s32)a[i].o.cb_server_fd;
+		}
+		if (copy_to_user(u + i * sizeof(l), &l, sizeof(l)))
+			return -EFAULT;
+	}
+
+	return 0;
+}
+
+/* Number of leading buffer arguments of a callback transaction. */
+static int smci_cb_nr_bufs(const struct si_arg u[])
+{
+	int i = 0;
+
+	while (u[i].type == SI_AT_IB || u[i].type == SI_AT_OB)
+		i++;
+
+	return i;
+}
