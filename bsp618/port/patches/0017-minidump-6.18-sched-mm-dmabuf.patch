+/*
+ * bsp618/port: ACK 6.18 dropped get_dmabuf_debugfs_data(); walk the buffers with the upstream
+ * dma_buf_iter_begin()/_next() (each step holds a reference to the current buffer).
+ */
+static int get_dmabuf_debugfs_data(int (*fn)(const struct dma_buf *, void *), void *private)
+{
+	struct dma_buf *dmabuf;
+	int ret = 0;
+
+	for (dmabuf = dma_buf_iter_begin(); dmabuf; dmabuf = dma_buf_iter_next(dmabuf)) {
+		ret = fn(dmabuf, private);
+		if (ret) {
+			dma_buf_put(dmabuf);
+			break;
+		}
+	}
+	return ret;
+}
