spi-msm-geni: SPI_CS_CNT_MAX is gone in 6.18

SPI_CS_CNT_MAX (16) was split: struct spi_device's chip_select[] and cs_index_mask are now
sized by SPI_DEVICE_CS_CNT_MAX (4). spi_geni_set_cs() walks cs_index_mask bits, so it uses
SPI_DEVICE_CS_CNT_MAX. spi_geni_get_chip_select_num() checked that the CS number is in range;
the controller registers SPI_NUM_CHIPSELECT (4) chip selects, so that is the bound now (any
value it rejected could not have been driven by the GENI SE anyway).

--- a/bsp612/soc-repo/drivers/spi/spi-msm-geni.c
+++ b/bsp612/soc-repo/drivers/spi/spi-msm-geni.c
@@ -766,7 +766,7 @@
 	int j;
 
 	for (j = 0; j < SPI_NUM_CHIPSELECT; j++) {
-		if (spi_slv->chip_select[j] != 0xFF && spi_slv->chip_select[j] < SPI_CS_CNT_MAX) {
+		if (spi_slv->chip_select[j] != 0xFF && spi_slv->chip_select[j] < SPI_NUM_CHIPSELECT) {
 		/* Geni SE doesn't support mutliple CS by same client, hence use only one CS */
 			*cs_num = spi_slv->chip_select[j];
 			return 0;
@@ -2824,7 +2824,7 @@
 	u8 idx;
 
 	if (spi_is_csgpiod(spi_slv)) {
-		for (idx = 0; idx < SPI_CS_CNT_MAX; idx++) {
+		for (idx = 0; idx < SPI_DEVICE_CS_CNT_MAX; idx++) {
 			if (spi_slv->cs_index_mask & BIT(idx)) {
 				struct gpio_desc *desc = spi_get_csgpiod(spi_slv, idx);
 
