+/*
+ * bsp618: FB_EVENT_BLANK left <linux/fb.h> with the fbdev notifier clients. The
+ * Samsung suspend/resume notifier (msm_drm_register_notifier_client) still sends it: keep
+ * the old value, which is what external clients of that exported chain compare against.
+ */
+#ifndef FB_EVENT_BLANK
+#define FB_EVENT_BLANK 0x09
 #endif
+#endif
+
+/*
+ * bsp618: drm_device.struct_mutex is gone. The driver used it as a device-wide
+ * lock around GEM frees and madvise; there is one msm_drm device, so one driver mutex.
+ */
+extern struct mutex msm_drm_struct_mutex;
+
+/*
+ * bsp618: DRM bridges are refcounted in 6.18 and drm_bridge_chain_get_first_bridge()
+ * returns a reference. msm_drm allocates and frees its bridges itself (kzalloc/kfree, the
+ * refcount is set up with kref_init() before drm_bridge_attach()), so the reference is
+ * dropped at once: same as 6.12, where the getter took none.
+ */
+static inline struct drm_bridge *msm_drm_first_bridge(struct drm_encoder *encoder)
+{
+	struct drm_bridge *bridge = drm_bridge_chain_get_first_bridge(encoder);
+
+	drm_bridge_put(bridge);
+	return bridge;
+}
+
+/*
+ * bsp618: iommu_present(&platform_bus_type) is gone. It was true as soon as any
+ * IOMMU driver had registered for the platform bus; on this platform the SMMU (arm_smmu
+ * fork) is a load dependency of msm_drm and its context banks are components of the
+ * display device, so it is always true when the driver binds.
+ */
+static inline bool msm_iommu_present(void)
+{
+	return IS_ENABLED(CONFIG_IOMMU_API);
+}
 
