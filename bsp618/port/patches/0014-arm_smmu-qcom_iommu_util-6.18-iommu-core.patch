--- a/bsp612/soc-repo/drivers/iommu/io-pgtable-fast.c
+++ b/bsp612/soc-repo/drivers/iommu/io-pgtable-fast.c
@@ -21,6 +21,24 @@
 #include <linux/qcom-io-pgtable.h>
 #include "drivers/iommu/iommu-pages.h"
 
+/*
+ * bsp618/port: the struct-page helpers of the 6.12 iommu-pages.h are gone in 6.18 (virtual
+ * address + folio API with the same NR_IOMMU_PAGES / NR_SECONDARY_PAGETABLE accounting).
+ * Every caller here allocates and frees single pages.
+ */
+static inline struct page *__iommu_alloc_pages(gfp_t gfp, int order)
+{
+	void *virt = iommu_alloc_pages_node_sz(NUMA_NO_NODE, gfp, PAGE_SIZE << order);
+
+	return virt ? virt_to_page(virt) : NULL;
+}
+
+static inline void __iommu_free_pages(struct page *page, int order)
+{
+	if (page)
+		iommu_free_pages(page_address(page));
+}
+
