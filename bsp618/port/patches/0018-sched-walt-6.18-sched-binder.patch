 		ARRAY_SIZE(((kstruct *)0)->android_vendor_data1)))
 
+/*
+ * bsp618/port: WALT keeps a struct walt_task_struct right after every task_struct
+ * (android_task_vendor_data() = p + 1). That area exists only when the kernel is booted with
+ * android_arch_task_struct_size=<n>, n >= sizeof(struct walt_task_struct) (Qualcomm's yupik
+ * DT bootargs: 512). Without it, walt_init() writes every task's WALT data into the next
+ * task_struct of the slab (6.12 runs ab-s60..s62, bsp612/CPUFREQ-ANALYSIS.md). The slab object
+ * size of a live task shows whether the area is there (ksize() >= the size the kernel asked
+ * for; a missing area leaves at most the 64-byte alignment slack). If it is not, WALT stays
+ * inert, as on 6.12 before cpufreq came up: its exported calls see walt_disabled and return.
+ */
+static bool walt_task_vendor_area_ok(void)
+{
+	size_t have = ksize(current);
+	size_t need = sizeof(struct task_struct) + sizeof(struct walt_task_struct);
+
+	if (have >= need)
+		return true;
+
+	pr_crit("sched-walt: task_struct objects are %zu bytes, WALT needs %zu (task_struct %zu + walt_task_struct %zu): boot with android_arch_task_struct_size=512; WALT stays disabled\n",
+		have, need, sizeof(struct task_struct), sizeof(struct walt_task_struct));
+	return false;
+}
+
 static int walt_module_init(void)
 {
 	/* compile time checks for vendor data size */
 	WALT_VENDOR_DATA_SIZE_TEST(struct walt_task_group, struct task_group);
+	BUILD_BUG_ON(sizeof(struct walt_task_struct) > CONFIG_GKI_TASK_STRUCT_VENDOR_SIZE_MAX);
+
+	if (!walt_task_vendor_area_ok())
+		return 0;
 
 	register_trace_android_vh_update_topology_flags_workfn(
 			android_vh_update_topology_flags_workfn, NULL);
