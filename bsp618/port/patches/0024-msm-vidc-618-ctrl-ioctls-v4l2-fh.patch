+	.vidioc_g_ext_ctrls = msm_v4l2_g_ext_ctrls,	/* bsp618/port: was vidioc_g_ctrl */
+	.vidioc_query_ext_ctrl = msm_v4l2_query_ext_ctrl,	/* bsp618/port: was vidioc_queryctrl */
