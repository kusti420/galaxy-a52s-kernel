+/*
+ * bsp618/port: v4l2_ioctl_ops lost vidioc_g_ctrl/s_ctrl/queryctrl in 6.18. The core now
+ * serves VIDIOC_G_CTRL/S_CTRL/QUERYCTRL through the ext-ctrl ops (one control per call,
+ * after check_ext_ctrls()), unless the fh has a ctrl_handler; vidc keeps its own handlers
+ * (msm_comm_s_ctrl(), try_get_ctrl_for_instance(), the HEVC tier / menu_skip_mask flags in
+ * msm_vidc_query_ctrl()), so these ext ops call exactly those, control by control.
+ * Side effect: VIDIOC_{G,S}_EXT_CTRLS and VIDIOC_QUERY_EXT_CTRL are now answered too (6.12:
+ * -ENOTTY). type and name come from the control (6.12 echoed the caller's input; the
+ * core's queryctrl conversion needs a valid type to copy min/max/step/default).
+ */
+static int msm_v4l2_query_ext_ctrl(struct file *file, void *fh,
+	struct v4l2_query_ext_ctrl *qec)
+{
+	struct msm_vidc_inst *vidc_inst = get_vidc_inst(file, fh);
+	struct v4l2_queryctrl q = { .id = qec->id };
+	struct v4l2_ctrl *ctrl;
+	int rc;
+
+	if (!vidc_inst)
+		return -EINVAL;
+	rc = msm_vidc_query_ctrl((void *)vidc_inst, &q);
+	if (rc)
+		return rc;
+	ctrl = v4l2_ctrl_find(&vidc_inst->ctrl_handler, q.id);
+	memset(qec, 0, sizeof(*qec));
+	qec->id = q.id;
+	if (ctrl) {
+		qec->type = ctrl->type;
+		strscpy(qec->name, ctrl->name, sizeof(qec->name));
+		qec->elems = 1;
+		qec->elem_size = ctrl->elem_size;
+	}
+	qec->minimum = q.minimum;
+	qec->maximum = q.maximum;
+	qec->step = q.step;
+	qec->default_value = q.default_value;
+	qec->flags = q.flags;
+	return 0;
+}
+
+static int msm_v4l2_ext_ctrls(struct file *file, void *fh,
+	struct v4l2_ext_controls *c, bool set)
+{
+	struct msm_vidc_inst *vidc_inst = get_vidc_inst(file, fh);
+	struct v4l2_control ctl;
+	u32 i;
+	int rc;
+
+	if (!vidc_inst)
+		return -EINVAL;
+	if (c->which == V4L2_CTRL_WHICH_DEF_VAL || c->which == V4L2_CTRL_WHICH_MIN_VAL ||
+	    c->which == V4L2_CTRL_WHICH_MAX_VAL || c->which == V4L2_CTRL_WHICH_REQUEST_VAL)
+		return -EINVAL;
+	for (i = 0; i < c->count; i++) {
+		ctl.id = c->controls[i].id;
+		ctl.value = c->controls[i].value;
+		rc = set ? msm_vidc_s_ctrl((void *)vidc_inst, &ctl)
+			 : msm_vidc_g_ctrl((void *)vidc_inst, &ctl);
+		if (rc) {
+			c->error_idx = i;
+			return rc;
+		}
+		c->controls[i].value = ctl.value;
+	}
+	return 0;
+}
+
+static int msm_v4l2_g_ext_ctrls(struct file *file, void *fh,
+	struct v4l2_ext_controls *c)
+{
+	return msm_v4l2_ext_ctrls(file, fh, c, false);
+}
+
+static int msm_v4l2_s_ext_ctrls(struct file *file, void *fh,
+	struct v4l2_ext_controls *c)
+{
+	return msm_v4l2_ext_ctrls(file, fh, c, true);
+}
