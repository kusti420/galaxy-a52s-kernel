usb_notify_layer (Samsung usb_notify): wakeup_source_add/remove are gone from 6.18

Not in <linux/pm_wakeup.h> any more; the embedded struct wakeup_source becomes the one
wakeup_source_register(NULL, "usb_notify") allocates (same name in /sys/class/wakeup).
__pm_stay_awake()/__pm_relax() accept NULL, as before when is_wakelock is off.

--- a/drivers612/power/src/usb/notify/usb_notify.c
+++ b/drivers612/power/src/usb/notify/usb_notify.c
@@ -96,7 +96,7 @@
 	struct host_notify_dev ndev;
 	struct usb_notify_dev udev;
 	struct workqueue_struct *notifier_wq;
-	struct wakeup_source ws;
+	struct wakeup_source *ws;	/* bsp618/port: wakeup_source_add/remove() are not in the 6.18 <linux/pm_wakeup.h> */
 	struct otg_booster *booster;
 	struct ovc ovc_info;
 	struct otg_booting_delay b_delay;
@@ -1876,7 +1876,7 @@
 			u_notify->typec_status.doing_drswap = 0;
 			mutex_unlock(&u_notify->state_lock);
 			if (n->is_wakelock)
-				__pm_stay_awake(&u_notify->ws);
+				__pm_stay_awake(u_notify->ws);
 			if (gpio_is_valid(n->redriver_en_gpio))
 				gpio_direction_output
 					(n->redriver_en_gpio, 1);
@@ -1897,7 +1897,7 @@
 				gpio_direction_output
 					(n->redriver_en_gpio, 0);
 			if (n->is_wakelock)
-				__pm_relax(&u_notify->ws);
+				__pm_relax(u_notify->ws);
 		}
 		break;
 	case NOTIFY_EVENT_LANHUB_TA:
@@ -3719,8 +3719,7 @@
 	}
 
 	if (n->is_wakelock) {
-		u_notify->ws.name = "usb_notify";
-		wakeup_source_add(&u_notify->ws);
+		u_notify->ws = wakeup_source_register(NULL, "usb_notify");
 	}
 
 #ifndef CONFIG_DISABLE_LOCKSCREEN_USB_RESTRICTION
@@ -3786,7 +3785,7 @@
 	if (n->booting_delay_sec)
 		cancel_delayed_work_sync(&u_notify->b_delay.booting_work);
 	if (n->is_wakelock)
-		wakeup_source_remove(&u_notify->ws);
+		wakeup_source_unregister(u_notify->ws);
 
 	if (gpio_is_valid(n->vbus_detect_gpio))
 		free_irq(gpio_to_irq(n->vbus_detect_gpio), NULL);
