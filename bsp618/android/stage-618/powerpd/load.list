if_cb_manager.ko
switch_class.ko
usb_notify_layer.ko
vbus_notifier.ko
sb-core.ko
sec_pd.ko
# hwmon.ko   # bsp618: built into the 6.18 GKI (CONFIG_HWMON=y; soc-repo copy DROPPED in port618.py)
# sec_thermistor.ko   wrong ADC values on 6.12 (ap 41 C, pa 71 C when idle): fix channels first
s2mpb03.ko
common_muic.ko
pdic_notifier_module.ko
usb_typec_manager.ko
mfd_sm5714.ko
muic_sm5714.ko
sec-battery.ko &
sm5714_fuelgauge.ko
